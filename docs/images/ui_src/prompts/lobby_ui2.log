using System;
using System.Drawing;
using System.Drawing.Imaging;
using System.Drawing.Drawing2D;
using System.Runtime.InteropServices;
public static class UiAssetExport {
    static readonly Color Key = Color.FromArgb(255, 0, 255);
    static Bitmap Normalize(Bitmap source) {
        Bitmap result = new Bitmap(source.Width, source.Height, PixelFormat.Format32bppArgb);
        using (Graphics graphics = Graphics.FromImage(result)) graphics.DrawImageUnscaled(source, 0, 0);
        Rectangle area = new Rectangle(0, 0, result.Width, result.Height);
        BitmapData data = result.LockBits(area, ImageLockMode.ReadWrite, PixelFormat.Format32bppArgb);
        byte[] pixels = new byte[data.Stride * data.Height];
        Marshal.Copy(data.Scan0, pixels, 0, pixels.Length);
        for (int y = 0; y < result.Height; y++) {
            for (int x = 0; x < result.Width; x++) {
                int index = y * data.Stride + x * 4;
                int blue = pixels[index], green = pixels[index + 1], red = pixels[index + 2];
                if (red > 120 && blue > 150 && green < 115 && red > green + 65 && blue > green + 65 && blue > red * 0.7) {
                    pixels[index] = 255; pixels[index + 1] = 0; pixels[index + 2] = 255;
                }
                pixels[index + 3] = 255;
            }
        }
        Marshal.Copy(pixels, 0, data.Scan0, pixels.Length);
        result.UnlockBits(data);
        return result;
    }
    static Rectangle Bounds(Bitmap image, Rectangle cell) {
        int left = cell.Right, top = cell.Bottom, right = cell.Left - 1, bottom = cell.Top - 1;
        for (int y = cell.Top; y < cell.Bottom; y++) {
            for (int x = cell.Left; x < cell.Right; x++) {
                if (image.GetPixel(x,y).ToArgb() == Key.ToArgb()) continue;
                left = Math.Min(left,x); top = Math.Min(top,y);
                right = Math.Max(right,x); bottom = Math.Max(bottom,y);
            }
        }
        if (right < left) throw new Exception(\"Empty asset cell\");
        return Rectangle.FromLTRB(left, top, right + 1, bottom + 1);
    }
    static void Place(Graphics graphics, Bitmap source, Rectangle bounds, Rectangle target, bool preserveRatio) {
        double scale = Math.Min((double)target.Width / bounds.Width, (double)target.Height / bounds.Height);
        int width = preserveRatio ? (int)Math.Round(bounds.Width * scale) : target.Width;
        int height = preserveRatio ? (int)Math.Round(bounds.Height * scale) : target.Height;
        Rectangle destination = new Rectangle(target.X + (target.Width-width)/2, target.Y + (target.Height-height)/2, width, height);
        graphics.InterpolationMode = InterpolationMode.HighQualityBicubic;
        graphics.PixelOffsetMode = PixelOffsetMode.HighQuality;
        graphics.DrawImage(source, destination, bounds, GraphicsUnit.Pixel);
    }
    static void Save(Bitmap image, string path) {
        if (System.IO.File.Exists(path)) throw new Exception(\"Destination exists: \" + path);
        using (Bitmap keyed = Normalize(image)) keyed.Save(path, ImageFormat.Png);
    }
    public static void Single(string input, string output, int width, int height, int marginX, int marginY) {
        using (Bitmap raw = new Bitmap(input))
        using (Bitmap source = Normalize(raw))
        using (Bitmap canvas = new Bitmap(width,height)) {
            Rectangle bounds = Bounds(source, new Rectangle(0,0,source.Width,source.Height));
            using (Graphics graphics = Graphics.FromImage(canvas)) {
                graphics.Clear(Key);
                Place(graphics,source,bounds,new Rectangle(marginX,marginY,width-2*marginX,height-2*marginY),true);
            }
            Save(canvas,output);
        }
    }
    public static void Buttons(string input, string output) {
        using (Bitmap raw = new Bitmap(input))
        using (Bitmap source = Normalize(raw))
        using (Bitmap canvas = new Bitmap(1536,1024)) {
            using (Graphics graphics = Graphics.FromImage(canvas)) {
                graphics.Clear(Key);
                Rectangle upper = Bounds(source,new Rectangle(0,0,1536,512));
                Rectangle lower = Bounds(source,new Rectangle(0,512,1536,512));
                Place(graphics,source,upper,new Rectangle(118,170,1300,260),false);
                Place(graphics,source,lower,new Rectangle(118,594,1300,260),false);
            }
            Save(canvas,output);
        }
    }
    public static void Parts(string input, string output) {
        using (Bitmap raw = new Bitmap(input))
        using (Bitmap source = Normalize(raw))
        using (Bitmap canvas = new Bitmap(1536,256)) {
            int[] widths = {208,110,124,124,170,120};
            int[] heights = {40,142,124,124,132,178};
            using (Graphics graphics = Graphics.FromImage(canvas)) {
                graphics.Clear(Key);
                for (int cell=0;cell<6;cell++) {
                    int left = cell * source.Width / 6;
                    int right = (cell+1) * source.Width / 6;
                    Rectangle bounds = Bounds(source,new Rectangle(left,0,right-left,source.Height));
                    Rectangle target = new Rectangle(cell*256+(256-widths[cell])/2,(256-heights[cell])/2,widths[cell],heights[cell]);
                    Place(graphics,source,bounds,target,true);
                }
            }
            Save(canvas,output);
        }
    }
    public static string Inspect(string path) {
        using (Bitmap image = new Bitmap(path)) {
            Rectangle bounds = Bounds(image,new Rectangle(0,0,image.Width,image.Height));
            long keyCount=0, edgeErrors=0;
            for (int y=0;y<image.Height;y++) {
                for (int x=0;x<image.Width;x++) {
                    bool isKey = image.GetPixel(x,y).ToArgb()==Key.ToArgb();
                    if (isKey) keyCount++;
                    if ((x<20 || y<20 || x>=image.Width-20 || y>=image.Height-20) && "'!isKey) edgeErrors++;
                }
            }
            return String.Format("{0}: {1}x{2}; solid #FF00FF pixels={3}; outer 20px non-magenta={4}; asset bounds={5}",System.IO.Path.GetFileName(path),image.Width,image.Height,keyCount,edgeErrors,bounds);
        }
    }
}
