using System;
using System.Drawing;
using System.Drawing.Imaging;
using System.Collections.Generic;

public static class FlatAssetExport
{
    static readonly Color Magenta = Color.FromArgb(255, 0, 255);
    static readonly Color Gold = Color.FromArgb(242, 178, 58);
    static readonly Color Violet = Color.FromArgb(30, 16, 24);
    static readonly Color Cream = Color.FromArgb(243, 226, 192);
    static readonly Color Crimson = Color.FromArgb(163, 23, 43);

    static Bitmap Flatten(Bitmap source, bool title)
    {
        var palette = title
            ? new[] { Magenta, Color.Black, Gold, Cream, Crimson }
            : new[] { Magenta, Color.Black, Gold, Violet, Cream };
        var result = new Bitmap(source.Width, source.Height, PixelFormat.Format24bppRgb);
        var cache = new Dictionary<int, Color>();
        for (int y = 0; y < source.Height; y++)
        for (int x = 0; x < source.Width; x++)
        {
            Color pixel = source.GetPixel(x, y);
            Color mapped;
            if ("'!cache.TryGetValue(pixel.ToArgb(), out mapped))
            {
                int bestDistance = int.MaxValue;
                mapped = Magenta;
                foreach (Color color in palette)
                {
                    int red = pixel.R - color.R;
                    int green = pixel.G - color.G;
                    int blue = pixel.B - color.B;
                    int distance = red * red + green * green + blue * blue;
                    if (distance < bestDistance)
                    {
                        bestDistance = distance;
                        mapped = color;
                    }
                }
                cache[pixel.ToArgb()] = mapped;
            }
            result.SetPixel(x, y, mapped);
        }
        return result;
    }

    static Rectangle Bounds(Bitmap image, int startX, int endX)
    {
        int left = endX, right = startX, top = image.Height, bottom = 0;
        for (int y = 0; y < image.Height; y++)
        for (int x = startX; x < endX; x++)
        {
            if (image.GetPixel(x, y).ToArgb() == Magenta.ToArgb()) continue;
            left = Math.Min(left, x);
            right = Math.Max(right, x);
            top = Math.Min(top, y);
            bottom = Math.Max(bottom, y);
        }
        return Rectangle.FromLTRB(left, top, right + 1, bottom + 1);
    }

    static Bitmap Canvas(int width, int height)
    {
        var bitmap = new Bitmap(width, height, PixelFormat.Format24bppRgb);
        using (var graphics = Graphics.FromImage(bitmap)) graphics.Clear(Magenta);
        return bitmap;
    }

    static void Blit(Bitmap source, Rectangle crop, Bitmap target, Rectangle destination)
    {
        for (int y = 0; y < destination.Height; y++)
        for (int x = 0; x < destination.Width; x++)
        {
            int sourceX = crop.X + Math.Min(crop.Width - 1, (int)((x + 0.5) * crop.Width / destination.Width));
            int sourceY = crop.Y + Math.Min(crop.Height - 1, (int)((y + 0.5) * crop.Height / destination.Height));
            target.SetPixel(destination.X + x, destination.Y + y, source.GetPixel(sourceX, sourceY));
        }
    }

    public static void Export(string sourcePath, string outputPath, string kind)
    {
        using (var source = new Bitmap(sourcePath))
        using (var flat = Flatten(source, kind == "title"))
        {
            if (kind == "title" || kind == "card")
            {
                flat.Save(outputPath, ImageFormat.Png);
                return;
            }
            int height = kind == "parts" ? 256 : kind == "button" ? 512 : 1024;
            using (var output = Canvas(1536, height))
            {
                if (kind == "parts")
                {
                    int[] widths = { 220, 194, 160, 160, 196, 170 };
                    int[] heights = { 32, 224, 160, 160, 154, 190 };
                    for (int cell = 0; cell < 6; cell++)
                    {
                        var crop = Bounds(flat, cell * flat.Width / 6, (cell + 1) * flat.Width / 6);
                        var destination = new Rectangle(cell * 256 + (256 - widths[cell]) / 2,
                            (256 - heights[cell]) / 2, widths[cell], heights[cell]);
                        Blit(flat, crop, output, destination);
                    }
                }
                else
                {
                    var crop = Bounds(flat, 0, flat.Width);
                    int width = kind == "button" ? 1400 : (int)Math.Round(crop.Width * 0.9);
                    int objectHeight = kind == "button" ? 220 : (int)Math.Round(crop.Height * 0.9);
                    Blit(flat, crop, output, new Rectangle((1536 - width) / 2, (height - objectHeight) / 2, width, objectHeight));
                }
                output.Save(outputPath, ImageFormat.Png);
            }
        }
    }

    public static string Validate(string path)
    {
        using (var bitmap = new Bitmap(path))
        {
            var colors = new HashSet<int>();
            for (int y = 0; y < bitmap.Height; y++)
            for (int x = 0; x < bitmap.Width; x++)
                colors.Add(bitmap.GetPixel(x, y).ToArgb());
            var values = new List<string>();
            foreach (int value in colors) values.Add("#" + (value & 0xffffff).ToString("X6"));
            values.Sort();
            return System.IO.Path.GetFileName(path) + " " + bitmap.Width + "x" + bitmap.Height
                + " palette=" + string.Join(",", values);
        }
    }
}
