using System;
using System.IO;
using System.Text;
using System.Drawing;
public static class PngFinalCheck {
    static void WriteUInt32(Stream stream, uint value) {
        stream.WriteByte((byte)(value >> 24));
        stream.WriteByte((byte)(value >> 16));
        stream.WriteByte((byte)(value >> 8));
        stream.WriteByte((byte)value);
    }
    public static void EmbedPrompt(string path, string prompt) {
        byte[] png = File.ReadAllBytes(path);
        byte[] data = Encoding.ASCII.GetBytes(\"GenerationPrompt\\0\" + prompt);
        byte[] kind = Encoding.ASCII.GetBytes(\"tEXt\");
        using (MemoryStream chunk = new MemoryStream()) {
            chunk.Write(kind, 0, kind.Length);
            chunk.Write(data, 0, data.Length);
            byte[] checksumData = chunk.ToArray();
            uint crc = 0xffffffff;
            foreach (byte value in checksumData) {
                crc "'^= value;
                for (int bit = 0; bit < 8; bit++)
                    crc = (crc & 1) != 0 ? (crc >> 1) ''^ 0xedb88320 : crc >> 1;
            }
            using (MemoryStream output = new MemoryStream()) {
                output.Write(png, 0, png.Length - 12);
                WriteUInt32(output, (uint)data.Length);
                output.Write(checksumData, 0, checksumData.Length);
                WriteUInt32(output, crc ''^ 0xffffffff);
                output.Write(png, png.Length - 12, 12);
                File.WriteAllBytes(path, output.ToArray());
            }
        }
    }
    public static void Verify(string path, int width, int height, bool atlas) {
        using (Bitmap bitmap = new Bitmap(path)) {
            if (bitmap.Width != width || bitmap.Height != height)
                throw new Exception("Incorrect dimensions");
            int magentaCount = 0;
            for (int y = 0; y < height; y++) {
                for (int x = 0; x < width; x++) {
                    Color color = bitmap.GetPixel(x, y);
                    if (color.A != 255) throw new Exception("Unexpected transparency");
                    bool keyed = color.R == 255 && color.G == 0 && color.B == 255;
                    if (keyed) magentaCount++;
                    if ((x == 0 || x == width - 1 || y == 0 || y == height - 1) && !keyed)
                        throw new Exception("Outer margin is not exact magenta");
                    if (atlas && (x % 256 < 20 || x % 256 >= 236 || y < 20 || y >= 236) && !keyed)
                        throw new Exception("Insufficient cell margin");
                    if (color.R > 80 && color.B > 80 && color.G < 150 && color.R - color.G > 55 && color.B - color.G > 55 && !keyed)
                        throw new Exception("Non-uniform magenta");
                }
            }
            Console.WriteLine(Path.GetFileName(path) + " verified " + width + "x" + height + ", opaque, exact #FF00FF margins, magenta pixels=" + magentaCount);
        }
    }
}
