using System;
using System.Drawing;
using System.Drawing.Drawing2D;
using System.Drawing.Imaging;
public static class MapAssetExport {
    static bool IsMagenta(Color c) {
        return c.R > 80 && c.B > 80 && c.G < 150 && c.R - c.G > 55 && c.B - c.G > 55;
    }
    static Bitmap Clean(string path, bool transparent) {
        Bitmap bitmap = new Bitmap(path);
        for (int y = 0; y < bitmap.Height; y++) {
            for (int x = 0; x < bitmap.Width; x++) {
                if (IsMagenta(bitmap.GetPixel(x, y)))
                    bitmap.SetPixel(x, y, transparent ? Color.Transparent : Color.Magenta);
            }
        }
        return bitmap;
    }
    public static void Export(string panelPath, string iconsPath, string directory) {
        using (Bitmap panel = Clean(panelPath, false)) {
            if (panel.Width "'!= 1536 || panel.Height != 1024)
                throw new Exception("Unexpected panel dimensions");
            panel.Save(System.IO.Path.Combine(directory, "map_panel.png"), ImageFormat.Png);
        }
        using (Bitmap source = Clean(iconsPath, true))
        using (Bitmap atlas = new Bitmap(1280, 256, PixelFormat.Format32bppArgb)) {
            using (Graphics graphics = Graphics.FromImage(atlas)) {
                graphics.Clear(Color.Magenta);
                graphics.InterpolationMode = InterpolationMode.HighQualityBicubic;
                graphics.PixelOffsetMode = PixelOffsetMode.HighQuality;
                graphics.CompositingQuality = CompositingQuality.HighQuality;
                for (int cell = 0; cell < 5; cell++) {
                    int start = (int)Math.Round(cell * source.Width / 5.0);
                    int end = (int)Math.Round((cell + 1) * source.Width / 5.0);
                    int left = end, right = start, top = source.Height, bottom = 0;
                    for (int y = 0; y < source.Height; y++) {
                        for (int x = start; x < end; x++) {
                            if (source.GetPixel(x, y).A != 0) {
                                left = Math.Min(left, x);
                                right = Math.Max(right, x);
                                top = Math.Min(top, y);
                                bottom = Math.Max(bottom, y);
                            }
                        }
                    }
                    Rectangle bounds = Rectangle.FromLTRB(left, top, right + 1, bottom + 1);
                    double scale = 208.0 / Math.Max(bounds.Width, bounds.Height);
                    int width = (int)Math.Round(bounds.Width * scale);
                    int height = (int)Math.Round(bounds.Height * scale);
                    Rectangle target = new Rectangle(cell * 256 + (256 - width) / 2, (256 - height) / 2, width, height);
                    graphics.DrawImage(source, target, bounds, GraphicsUnit.Pixel);
                    Console.WriteLine("Cell " + (cell + 1) + " source=" + bounds + " target=" + target);
                }
            }
            for (int y = 0; y < atlas.Height; y++) {
                for (int x = 0; x < atlas.Width; x++) {
                    if (IsMagenta(atlas.GetPixel(x, y)))
                        atlas.SetPixel(x, y, Color.Magenta);
                }
            }
            atlas.Save(System.IO.Path.Combine(directory, "map_icons.png"), ImageFormat.Png);
        }
    }
}
