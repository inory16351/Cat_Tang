                            var destination = new Rectangle(i * 256 + (256 - spriteWidth) / 2, (256 - spriteHeight) / 2, spriteWidth, spriteHeight);
                            graphics.DrawImage(keyed, destination, crop, GraphicsUnit.Pixel);
                            Console.WriteLine("Frame {0}: {1}x{2}, position {3},{4}", i + 1, spriteWidth, spriteHeight, destination.X, destination.Y);
