$sourceCode = @'"'
using System;
using System.Drawing;
using System.Drawing.Drawing2D;
using System.Drawing.Imaging;
public static class ProjectileSheet {
    public static void Save(string sourcePath, string outputPath) {
        using (var source = new Bitmap(sourcePath)) {
            int width = source.Width, height = source.Height;
            using (var keyed = new Bitmap(width, height, PixelFormat.Format32bppArgb)) {
                for (int y = 0; y < height; y++) {
                    for (int x = 0; x < width; x++) {
                        Color pixel = source.GetPixel(x, y);
                        bool background = pixel.R >= 225 && pixel.B >= 225 && pixel.G <= 38 && Math.Abs(pixel.R - pixel.B) <= 28;
                        if ("'!background) keyed.SetPixel(x, y, pixel);
                    }
                }
                Rectangle[] searchAreas = {
                    new Rectangle(20, 240, 325, 235),
                    new Rectangle(385, 305, 310, 105),
                    new Rectangle(825, 325, 135, 65),
                    new Rectangle(1035, 320, 410, 75),
                    new Rectangle(1450, 295, 355, 125),
                    new Rectangle(1825, 275, 285, 170)
                };
                int[] targetWidths = {180, 125, 45, 230, 170, 115};
                using (var output = new Bitmap(1536, 256, PixelFormat.Format24bppRgb)) {
                    using (var graphics = Graphics.FromImage(output)) {
                        graphics.Clear(Color.FromArgb(255, 0, 255));
                        graphics.InterpolationMode = InterpolationMode.HighQualityBicubic;
                        graphics.PixelOffsetMode = PixelOffsetMode.HighQuality;
                        graphics.CompositingMode = CompositingMode.SourceOver;
                        for (int i = 0; i < searchAreas.Length; i++) {
                            Rectangle area = searchAreas[i];
                            int minX = area.Right, minY = area.Bottom, maxX = area.Left, maxY = area.Top;
                            for (int y = area.Top; y < area.Bottom; y++) {
                                for (int x = area.Left; x < area.Right; x++) {
                                    if (keyed.GetPixel(x, y).A == 0) continue;
                                    minX = Math.Min(minX, x); minY = Math.Min(minY, y);
                                    maxX = Math.Max(maxX, x); maxY = Math.Max(maxY, y);
                                }
                            }
                            var crop = Rectangle.FromLTRB(minX - 2, minY - 2, maxX + 3, maxY + 3);
                            int spriteWidth = targetWidths[i];
                            int spriteHeight = (int)Math.Round((double)crop.Height * spriteWidth / crop.Width);
                            var destination = new Rectangle(i * 256 + (256 - spriteWidth) / 2, (256 - spriteHeight) / 2, spriteWidth, spriteHeight);
                            graphics.DrawImage(keyed, destination, crop, GraphicsUnit.Pixel);
                            Console.WriteLine("Frame {0}: {1}x{2}, position {3},{4}", i + 1, spriteWidth, spriteHeight, destination.X, destination.Y);
                        }
                    }
                    output.Save(outputPath, ImageFormat.Png);
                }
            }
        }
    }
}
