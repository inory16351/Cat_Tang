using System;
using System.Drawing;
using System.Drawing.Drawing2D;
using System.Drawing.Imaging;
using System.IO;
public static class FxStripPack {
    static bool IsGreen(Color c) { return c.G > 25 && c.G > c.R * 1.15 + 6 && c.G > c.B * 1.15 + 6; }
    public static string Pack(string input, string output) {
        using (Bitmap src = new Bitmap(input)) {
            int w=src.Width, h=src.Height;
            int[] column=new int[w];
            for(int y=0;y<h;y++) for(int x=0;x<w;x++) {
                Color c=src.GetPixel(x,y);
                if(IsGreen(c)) src.SetPixel(x,y,Color.Lime);
                else column[x]++;
            }
            int[] cuts=new int[9]; cuts[8]=w;
            for(int i=1;i<8;i++) {
                int nominal=(int)Math.Round(w*i/8.0);
                int best=nominal;
                for(int x=Math.Max(1,nominal-18);x<=Math.Min(w-2,nominal+18);x++)
                    if(column[x]<column[best] || (column[x]==column[best] && Math.Abs(x-nominal)<Math.Abs(best-nominal))) best=x;
                if(column[best]"'!=0) throw new Exception("No clear frame boundary at "+i+" in "+input);
                cuts[i]=best;
            }
            Rectangle[] boxes=new Rectangle[8];
            int maxDim=1;
            for(int i=0;i<8;i++) {
                int minX=w,minY=h,maxX=-1,maxY=-1;
                for(int x=cuts[i];x<cuts[i+1];x++) for(int y=0;y<h;y++) {
                    if(src.GetPixel(x,y).ToArgb()==Color.Lime.ToArgb()) continue;
                    minX=Math.Min(minX,x);maxX=Math.Max(maxX,x);minY=Math.Min(minY,y);maxY=Math.Max(maxY,y);
                }
                if(maxX<0) throw new Exception("Empty frame "+i);
                boxes[i]=Rectangle.FromLTRB(minX,minY,maxX+1,maxY+1);
                maxDim=Math.Max(maxDim,Math.Max(boxes[i].Width,boxes[i].Height));
            }
            double scale=212.0/maxDim;
            using(Bitmap dst=new Bitmap(2048,256,PixelFormat.Format24bppRgb)) {
                using(Graphics g=Graphics.FromImage(dst)) {
                    g.Clear(Color.Lime);
                    g.InterpolationMode=InterpolationMode.HighQualityBicubic;
                    g.PixelOffsetMode=PixelOffsetMode.HighQuality;
                    for(int i=0;i<8;i++) {
                        int dw=Math.Max(1,(int)Math.Round(boxes[i].Width*scale));
                        int dh=Math.Max(1,(int)Math.Round(boxes[i].Height*scale));
                        Rectangle target=new Rectangle(i*256+(256-dw)/2,(256-dh)/2,dw,dh);
                        g.DrawImage(src,target,boxes[i],GraphicsUnit.Pixel);
                    }
                }
                int margin=256;
                int[] counts=new int[8];
                for(int y=0;y<256;y++) for(int x=0;x<2048;x++) {
                    Color c=dst.GetPixel(x,y);
                    if(IsGreen(c)) { dst.SetPixel(x,y,Color.Lime); continue; }
                    int local=x%256;
                    margin=Math.Min(margin,Math.Min(Math.Min(local,255-local),Math.Min(y,255-y)));
                    counts[x/256]++;
                }
                if(margin<20) throw new Exception("Insufficient margin: "+margin);
                Directory.CreateDirectory(Path.GetDirectoryName(output));
                dst.Save(output,ImageFormat.Png);
                return Path.GetFileName(output)+" | 2048 x 256 | 8 populated frames | min green margin "+margin+" px | counts "+String.Join(",",counts);
            }
        }
    }
}
