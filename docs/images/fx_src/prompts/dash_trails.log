using System;
using System.Drawing;
using System.Drawing.Imaging;
public static class DashSheetPack {
  static bool Key(Color c) { return c.G > 85 && c.G > c.R * 1.35 && c.G > c.B * 1.35; }
  public static string Pack(string source, string target) {
    using (var src = new Bitmap(source)) {
      int[] left=new int[8], right=new int[8], top=new int[8], bottom=new int[8];
      int maxW=1,maxH=1;
      for(int f=0; f<8; f++) {
        int x0=(int)Math.Round(f*src.Width/8.0), x1=(int)Math.Round((f+1)*src.Width/8.0);
        left[f]=x1; right[f]=x0-1; top[f]=src.Height; bottom[f]=-1;
        for(int y=0;y<src.Height;y++) for(int x=x0;x<x1;x++) {
          if(Key(src.GetPixel(x,y))) continue;
          left[f]=Math.Min(left[f],x); right[f]=Math.Max(right[f],x);
          top[f]=Math.Min(top[f],y); bottom[f]=Math.Max(bottom[f],y);
        }
        if(bottom[f]>=0) { maxW=Math.Max(maxW,right[f]-left[f]+1); maxH=Math.Max(maxH,bottom[f]-top[f]+1); }
      }
      double scale=Math.Min(224.0/maxW,150.0/maxH);
      using(var dst=new Bitmap(2048,256,PixelFormat.Format24bppRgb)) {
        using(var g=Graphics.FromImage(dst)) g.Clear(Color.FromArgb(0,255,0));
        for(int f=0;f<8;f++) {
          if(bottom[f]<0) continue;
          int w=Math.Max(1,(int)Math.Round((right[f]-left[f]+1)*scale));
          int h=Math.Max(1,(int)Math.Round((bottom[f]-top[f]+1)*scale));
          int dx=f*256+240-w,dy=184-h;
          for(int y=0;y<h;y++) for(int x=0;x<w;x++) {
            int sx=left[f]+Math.Min(right[f]-left[f],(int)(x/scale));
            int sy=top[f]+Math.Min(bottom[f]-top[f],(int)(y/scale));
            Color c=src.GetPixel(sx,sy);
            if("'!Key(c)) dst.SetPixel(dx+x,dy+y,c);
          }
        }
        dst.Save(target,ImageFormat.Png);
      }
    }
    using(var check=new Bitmap(target)) {
      if(check.Width!=2048 || check.Height!=256) throw new Exception("Invalid sheet size");
      for(int y=0;y<256;y++) for(int x=0;x<2048;x++) {
        Color c=check.GetPixel(x,y);
        bool green=c.R==0 && c.G==255 && c.B==0;
        int localX=x%256;
        if((localX<16 || localX>=240 || y<16 || y>=240) && !green) throw new Exception("Effect crossed frame margin");
        if(Key(c) && !green) throw new Exception("Background is not pure green");
      }
      return target+" — "+check.Width+" x "+check.Height+" px; 8 frames; margins and pure-green key verified";
    }
  }
}
