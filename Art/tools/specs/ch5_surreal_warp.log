+import array
+import hashlib
+import importlib.util
+from pathlib import Path
+
+root = Path(__file__).resolve().parents[3]
+spec = importlib.util.spec_from_file_location('warp', root / 'Art/tools/blender_ch5_surreal_warp.py')
+warp = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(warp)
+
+def geometry(path):
+    warp.reset()
+    warp.bpy.ops.import_scene.fbx(filepath=str(path))
+    digest = hashlib.sha256()
+    for obj in warp.meshes():
+        digest.update(obj.name.encode())
+        coords = [tuple(v.co) for v in obj.data.vertices]
+        digest.update(str(sorted(coords)).encode())
+        faces = sorted((p.material_index, tuple(sorted(coords[i] for i in p.vertices)))
+                       for p in obj.data.polygons)
+        digest.update(str(faces).encode())
+        digest.update(str([list(row) for row in obj.matrix_world]).encode())
+        digest.update(str([m.name for m in obj.data.materials]).encode())
+    return digest.hexdigest()
+
+for name in ('Kit_Wall_Mirror', 'Kit_FD_StationClock', 'Kit_Gate_S1'):
+    path = warp.OUTPUT / (name + '.fbx')
+    before = geometry(path)
+    warp.process(path, set())
+    assert geometry(path) == before, (name, 'non-deterministic geometry')
+    print('REPEAT VERIFIED', name, before, flush=True)
+print('DETERMINISTIC / NO DOUBLE WARP', flush=True)

