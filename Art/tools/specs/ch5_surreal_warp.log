+def topology(bm):
+    return {key: sum(1 for e in bm.edges if test(e)) for key, test in (
+        ('boundary', lambda e: e.is_boundary),
+        ('nonmanifold', lambda e: len(e.link_faces) > 2),
+        ('wire', lambda e: e.is_wire))}
