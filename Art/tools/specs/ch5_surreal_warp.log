+import bpy
+from pathlib import Path
+from mathutils import Vector
+root = Path(__file__).resolve().parents[3]
+for name in ('Kit_Wall', 'Kit_Gate_S1', 'Kit_Corridor_S3', 'Kit_LM_ClockHeart'):
+    bpy.ops.wm.read_factory_settings(use_empty=True)
+    bpy.ops.import_scene.fbx(filepath=str(root / 'Game/Assets/Art/Characters/Ch5' / (name + '.fbx')))
+    for obj in bpy.context.scene.objects:
+        if obj.type != 'MESH': continue
+        points = [obj.matrix_world @ v.co for v in obj.data.vertices]
+        lo = [min(p[i] for p in points) for i in range(3)]
+        hi = [max(p[i] for p in points) for i in range(3)]
+        print('INSPECT', name, obj.name, 'matrix', [list(r) for r in obj.matrix_world], 'bbox', lo, hi, 'verts',len(points),'polys',len(obj.data.polygons),'uv',len(obj.data.uv_layers), flush=True)

