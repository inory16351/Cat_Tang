+        rng = random.Random(self.seed)
+        self.sign = 1 if self.seed % 2 else -1
+        self.lean = self.sign * rng.uniform(.085, .14) * self.height
+        self.twist = self.sign * math.radians(rng.uniform(10, 16))
+        self.sag = rng.uniform(.065, .10) * self.height
+        self.phase = rng.uniform(0, math.tau)
+        self.frequency = rng.uniform(4.0, 6.5) / max(self.size.x, .25)
