+        for k in range(len(profile)):
+            for j in range(n): f.append((k*n+j,k*n+(j+1)%n,((k+1)%len(profile))*n+(j+1)%n,((k+1)%len(profile))*n+j))
+        mesh('Concave hanging balance pan',v,f,'gold',True)
+
