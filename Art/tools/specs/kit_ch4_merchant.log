+def make_crown_and_key():
+    # Horizontal music-box cylinder, with mechanical pins around its full barrel.
+    z=2.397
+    disk('Porcelain music pin cylinder',(0,-.012,z),.139,.51,'dial_face',32,axis=(1,0,0),bevel=.02)
