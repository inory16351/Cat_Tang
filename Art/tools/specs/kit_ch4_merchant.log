+        tube('Shin inset seam',[(x+s*.025,.077,.46),(x+s*.04,.079,.35),(x+s*.05,.062,.23)],.009,'dial_face',6)
+        # Boots are flat-bottomed, with a rounded toe pointing along +Y.
