+    lo,hi=0.,1.
+    for _ in range(32):
+        mid=(lo+hi)/2
+        total=sum(t*min(1.,mid*w) for _,t,w in priorities)
+        if total>19750: hi=mid
+        else: lo=mid
+    for p,t,w in priorities:
