+    gear('Upper left nine tooth gear',.104,.247,1.457,.100,9,'gold',.03)
+    gear('Small linking pinion',-.132,.250,1.288,.062,7,'brass')
+    # Crystal dome: transparent centre and a thick optically readable perimeter.
+    # Two shells share a shader: an open central optical window does not obscure
+    # its gears under Workbench's deliberately opaque MATERIAL colour mode.
+    verts=[]; faces=[]; n=48
+    for k in range(5):
+        a=.08+k*.16
+        for j in range(n):
