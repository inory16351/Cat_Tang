    # The origin is the island's upper floor. Suspended geology is intentional.
    extrude('Floating island broken lip',[(-3,-.18),(3,-.18),(3,.05),(2.1,.12),(1.1,.02),
            (.2,.15),(-.5,.02),(-1.7,.12),(-3,.05)],-.95,.65,'void_stone',True)
