+    slab('Tall triangular brass sundial gnomon',[(x-.46,1.26),(x+.47,1.26),(x+.34,2.40)],-.065,.065,'brass',True)
+    beam('Gnomon dark measuring edge',(x-.44,.073,1.28),(x+.34,.073,2.37),.045,.045,'gold_dark')
