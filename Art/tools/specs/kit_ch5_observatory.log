+            tip+=Vector((.15,.10,.26))
+            beam('Floating broken planet arm',tuple(direction*.94+Vector((.15,.10,z+.26))),tip,.085,.085,'brass')
+            sphere('Time light at snapped planet arm',tuple(direction*.68+Vector((0,0,z))),.065,'crack_gold',8,4)
