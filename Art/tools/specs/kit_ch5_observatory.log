+def landmark_armillary():
+    platform(4.6,3.2,.43)
+    box('Armillary pale pedestal',(0,0,.77),(2.48,1.93,.67),'marble',True)
+    for y in (-.982,.982):
+        box('Armillary navy pedestal panel',(0,y,.77),(1.94,.055,.40),'void_stone',True)
+    for x in (-1.256,1.256):
