+        x0=min(p.x for p in pp); x1=max(p.x for p in pp)
+        y0=min(p.y for p in pp); y1=max(p.y for p in pp)
+        camera.location+=rotation @ Vector(((x0+x1)/2,(y0+y1)/2,0))
