+    seam([(-1.37,.38),(-1.53,.82),(-1.24,1.10),(-1.46,1.51),(-1.11,1.97)],1.04)
+    # Broken crown strip and hovering fragments keep the room-edge silhouette.
+    for a,b in ((-4,-2.2),(-2.17,-.51),(.51,2.6),(2.63,4)):
+        box('Broken dome crown lip',((a+b)/2,-.57,4.65),(b-a,.16,.10),'gold_dark')
+    rock('Hovering dome crown stone',(-2.80,-.46,4.85),(.40,.30,.20),'marble',99)
