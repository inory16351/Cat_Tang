+        assert PREVIEW.is_file() and PREVIEW.stat().st_size>1024
+        print(f'PREVIEW {PREVIEW}',flush=True)
+    finally:
+        scene.camera=None
+        for helper in helpers: bpy.data.objects.remove(helper,do_unlink=True)
+        for obj in objects: obj.location=(0,0,0)
