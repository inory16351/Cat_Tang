+    slab('Arched starry tall window',arch_profile(x,.62,1.6,3.0),.97,1.015,'night_sky')
+    arch_frame(x,.62,1.6,3.0)
+    for dx in (-.40,0,.40):
+        top=2.82+math.sqrt(max(0,.8**2-dx**2))
