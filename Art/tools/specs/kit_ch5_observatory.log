+                idx=objects.index(obj)
+                baseline=cy-max(2.38,(cap-bot)/2+.27)
+                label(obj.name,cx,baseline,.255)
+                label(SPECS[idx][4],cx,baseline-.36,.17,'gold')
+                dims=obj.dimensions
