+            gap=(total_width-sum(widths))/len(row)
+            cursor=-total_width/2
+            for obj,w in zip(row,widths):
+                pp=cloud(obj)
+                lo=min(p.x for p in pp); hi=max(p.x for p in pp)
+                bot=min(p.y for p in pp); cap=max(p.y for p in pp)
+                cx=cursor+(w+gap)/2
