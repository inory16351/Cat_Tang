+def landmark_ball():
+    platform(3,2.4,.48)
+    box('Time ball stepped pedestal',(0,0,.83),(2.32,1.72,.70),'marble',True)
+    box('Time ball pedestal cap',(0,0,1.23),(2.48,1.88,.16),'marble',True)
+    for y in (-.874,.874):
