+            (r*.20,r*.24,.13),role,rot=(0,0,-a))
+    for j in range(5):
+        a=TAU*j/5
+        beam('Gear spoke',(.1*math.sin(a),.1*math.cos(a),0),
+             (r*.65*math.sin(a),r*.65*math.cos(a),0),.065,.08,role)
+    group(start,loc,rot)
