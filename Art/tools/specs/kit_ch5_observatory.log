+    beam('Pediment left gilt molding',(-1.59,1.20,4.04),(0,1.20,4.40),.07,.07,'gold')
+    beam('Pediment right gilt molding',(0,1.20,4.40),(1.59,1.20,4.04),.07,.07,'gold')
+    dial(0,1.10,2.70,1.20,broken=True)
