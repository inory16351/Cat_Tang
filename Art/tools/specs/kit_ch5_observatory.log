+    for j in range(29):
+        box('Raised standard ruler division',(-2.24+j*.16,1.16,1.10),
+            (.045,.045,.23 if j%4==0 else .12),'gold_dark')
+    box('Upper gold cornice',(0,.20,4.15),(6,1.66,.15),'gold',True)
+    coping(6,4.23)
+    seam([(-2.47,.36),(-2.35,.65),(-2.46,1.02),(-2.18,1.43),(-2.30,1.90)],1.04)
