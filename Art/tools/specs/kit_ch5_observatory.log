+    roles=['crystal','porcelain','red_lacquer','mirror','crystal']
+    for j,(r,z,a) in enumerate(((.62,2.88,.20),(1.05,2.49,1.83),(1.44,2.04,3.25),
+                               (1.70,1.59,4.58),(1.66,1.09,5.78))):
