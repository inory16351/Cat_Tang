                 (.78*math.cos(a),0,.78*math.sin(a)),.13,.18,'gold')
        halfhub=[(.25*math.cos(a0+(a1-a0)*j/12),.25*math.sin(a0+(a1-a0)*j/12)) for j in range(13)]
