def float_rock():
    mound('Grounded island shadow mound', 4.0, 3.4, .60)
    for loc, size in (((-.90,.31,.25),(1.0,.92,.51)),
                      ((.68,-.59,.22),(1.1,.89,.44))):
        lump('Ground rock',loc,size,'rock')
