import math
import runpy
from pathlib import Path
import bmesh
import bpy
from mathutils import Vector
kit = runpy.run_path('Art/tools/blender_kit_ch3_landmarks.py', run_name='landmark_validation')
for name, dims, _ in kit['SPECS']:
    bpy.ops.wm.read_factory_settings(use_empty=True)
    path = kit['OUTPUT'] / ('Kit_'+name+'.fbx')
    bpy.ops.import_scene.fbx(filepath=str(path), use_anim=False)
    objects = list(bpy.context.scene.objects)
    assert len(objects) == 1 and objects[0].type == 'MESH', (name, objects)
    obj = objects[0]
    assert obj.name == name, (name, obj.name)
    assert obj.location.length < 1e-5, (name, obj.location)
    points = [obj.matrix_world @ v.co for v in obj.data.vertices]
    lo = Vector(tuple(min(v[i] for v in points) for i in range(3)))
    hi = Vector(tuple(max(v[i] for v in points) for i in range(3)))
    assert all(abs((hi-lo)[i]-dims[i]) < 1e-4 for i in range(3)), (name, lo, hi)
    assert abs(lo.z) < 1e-5 and abs(lo.x+hi.x) < 1e-5 and abs(lo.y+hi.y) < 1e-5, (name, lo, hi)
    obj.data.calc_loop_triangles()
    assert len(obj.data.loop_triangles) <= 8000, name
    bm = bmesh.new()
    bm.from_mesh(obj.data)
    assert all(e.is_manifold for e in bm.edges), name
    bm.free()
    roles = {obj.data.materials[p.material_index].name for p in obj.data.polygons}
    assert len(roles) >= 6 and roles.issubset(set(kit['ROLES'])), (name, roles)
    for mat in obj.data.materials:
        assert all(abs(c-.5) < 1e-5 for c in mat.diffuse_color[:3]), (name, mat.name)
        shader = mat.node_tree.nodes.get('Principled BSDF')
        assert shader is not None, (name, mat.name)
        assert all(abs(c-.5) < 1e-5 for c in shader.inputs['Base Color'].default_value[:3]), (name, mat.name)
        assert not any(n.type.startswith('TEX_') for n in mat.node_tree.nodes), (name, mat.name)
    print('VERIFIED', name, len(obj.data.loop_triangles), len(roles), tuple(round(c,4) for c in hi-lo), flush=True)
image = bpy.data.images.load(str(kit['PREVIEW']), check_existing=False)
assert tuple(image.size) == (1600,900), tuple(image.size)
print('VERIFIED preview 1600x900', flush=True)
print('VALIDATION DONE', flush=True)
