+    'void_stone': (.29, .20, .43), 'void_stone_dark': (.075, .045, .15),
+    'marble': (.76, .69, .88), 'marble_dark': (.35, .28, .48),
+    'violet': (.47, .20, .76), 'violet_dark': (.14, .065, .25),
+    'indigo': (.075, .09, .24), 'night_sky': (.012, .018, .055),
