+def gear(loc, radius=.4, rot=(0,0,0)):
+    n=12; contour=[]
+    for j in range(n):
+        for t,r in ((-.46,.78),(-.27,1),(.27,1),(.46,.78)):
+            a=TAU*(j+t)/n
+            contour.append((radius*r*math.cos(a),radius*r*math.sin(a)))
