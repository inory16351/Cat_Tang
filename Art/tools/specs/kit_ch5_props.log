+        assert max(v.co.z for p in obj.data.polygons if obj.data.materials[p.material_index].name=='crack_gold' for v in (obj.data.vertices[i] for i in p.vertices))<=.02001
+    dest=OUTPUT/f'Kit_{name}.fbx'
