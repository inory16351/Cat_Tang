+    smile = slab('Painted gold crescent smile', outline, .014, 'gold')
+    smile.data.transform(Euler((math.pi / 2, 0, 0)).to_matrix().to_4x4())
+    smile.data.transform(Matrix.Translation(Vector((0, .236, 0))))
+    cylinder('Top hat broad brim', (0, 0, 3.53), .49, .085, 'boss_slate', 24, bevel=.025)
+    hoop('Hat brim gold piping', (0, 0, 3.57), .49, .035, .035, 'gold', 24)
+    cylinder('Tall top hat crown', (0, -.025, 3.765), .31, .47, 'boss_slate', 20,
+             top=.365, bevel=.025)
+    cylinder('Crimson hat ribbon', (0, -.025, 3.64), .326, .14, 'boss_crimson', 20, top=.342)
+    hoop('Top hat upper gold line', (0, -.025, 3.982), .365, .028, .035, 'gold', 20)
+    box('Hat ribbon gold buckle', (0, .321, 3.64), (.19, .055, .13), 'gold', .02)
+    box('Hat ribbon buckle inset', (0, .353, 3.64), (.11, .016, .065), 'boss_crimson', .01)
+    for i, numeral in enumerate(('I', 'V', 'X')):
+        card((-.18 + i * .15, .12 - i * .018, 3.60),
+             math.radians((i - 1) * 18), numeral, .58)
+
