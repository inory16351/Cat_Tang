+        direction = (Vector(b) - Vector(a)).normalized()
+        rod('Gold wand tip', Vector(b) - direction * .14, b, .056, 'gold', 10)
+        rod('Ivory wand heel', a, Vector(a) + direction * .10, .049, 'ivory', 10)
+    else:
