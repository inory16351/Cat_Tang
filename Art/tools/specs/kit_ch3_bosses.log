+             (0, math.pi / 2, 0), teeth=10)
+        rod('Ear axle', (side * .28, .075, 3.23), (side * .35, .075, 3.23), .05, 'bronze', 8)
+    # A filled crescent inlay following the porcelain surface, with no nose.
+    outline = []
+    for i in range(13):
