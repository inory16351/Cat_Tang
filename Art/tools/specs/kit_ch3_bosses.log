+def magician_arm(side):
+    shoulder = (side * .55, 0, 2.85)
+    if side < 0:
+        elbow, wrist = (-.78, .02, 2.27), (-.92, .10, 1.84)
+    else:
+        elbow, wrist = (.86, .08, 2.34), (1.04, .75, 2.61)
