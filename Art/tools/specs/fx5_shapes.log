import bpy, importlib.util
from pathlib import Path
spec = importlib.util.spec_from_file_location('fx5', Path('Art/tools/blender_fx5_shapes.py').resolve())
fx5 = importlib.util.module_from_spec(spec)
spec.loader.exec_module(fx5)
bpy.ops.wm.read_factory_settings(use_empty=True)
originals = [fx5.dome(), fx5.circular_band('ring'), fx5.circular_band('ring_tall', True), fx5.swirl(), fx5.slash_arc(), fx5.spiral_ball(), fx5.spike_burst()]
for original in originals:
    bpy.ops.import_scene.fbx(filepath=str(fx5.OUTPUT / (original.name + '.fbx')))
    imported = bpy.context.selected_objects
    assert len(imported) == 1 and imported[0].type == 'MESH'
    obj = imported[0]
    mesh = obj.data
    mesh.calc_loop_triangles()
    name = original.name.removeprefix('fx5_')
    assert len(mesh.loop_triangles) == fx5.EXPECTED[name]
    assert len(mesh.uv_layers) == 1
    a = sorted(tuple(round(c, 5) for c in item.uv) for item in original.data.uv_layers.active.data)
    b = sorted(tuple(round(c, 5) for c in item.uv) for item in mesh.uv_layers.active.data)
    assert a == b, (name, 'UV changed')
    world = [obj.matrix_world @ v.co for v in mesh.vertices]
    for axis in range(3):
        assert abs(min(v[axis] for v in world) - min(v.co[axis] for v in original.data.vertices)) < 1e-5, (name, 'minimum bound')
        assert abs(max(v[axis] for v in world) - max(v.co[axis] for v in original.data.vertices)) < 1e-5, (name, 'maximum bound')
    assert obj.matrix_world.translation.length < 1e-6
    assert all(p.use_smooth and p.area > 1e-10 for p in mesh.polygons)
    print('AUDIT_OK', name, len(mesh.loop_triangles), 'UV0, bounds, origin, smoothing')
    bpy.data.objects.remove(obj, do_unlink=True)
print('FBX_ROUNDTRIP_OK 7')
