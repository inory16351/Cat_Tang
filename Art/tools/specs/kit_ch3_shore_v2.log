                (b[0]-.012, b[1]+.06), (a[0]+.012, a[1]+.06)], -.75, 1.04, 'sandstone_light')


def ellipse(rx, rz, z, n=32):
    return [(rx*math.cos(i*math.tau/n), z+rz*math.sin(i*math.tau/n)) for i in range(n)]


