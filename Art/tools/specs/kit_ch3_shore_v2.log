-    slab('Small toe slab', 1.58, 2.8, .66, 1.20, 0, .61)
-    slab('High offset facet', -1.48, .15, -.62, .55, 3.6, 4.17)
-    # A shallow triangular prism ramp, facing the room.
-    mesh('Sand foot slope', [(-3, .76, 0), (3, .76, 0), (3, 1.4, 0), (-3, 1.4, 0),
-                            (-3, .76, .43), (3, .76, .43)],
