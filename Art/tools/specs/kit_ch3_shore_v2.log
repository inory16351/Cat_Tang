        p = [(.18*math.cos(a-.18), 3.21+.18*math.sin(a-.18)), tip,
             (.18*math.cos(a+.18), 3.21+.18*math.sin(a+.18))]
        extrude('Sun crest ray', p, 1.07, 1.13, 'gold')
    box('White marble projecting shelf', (0, .91, .43), (2.86, .66, .18), 'marble')
    for x in (-.94, .94):
