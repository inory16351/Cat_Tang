            points = [(sign*(1.13+.24*math.sin(t)), 1.13, z+.28*math.cos(t))
                      for t in (0, .65, 1.3, 1.95, 2.6, 3.25, 3.9, 4.55)]
            tube('Gilt scroll flourish', points, .045, 'gold')
