def load(source):
    ns = {'__name__': 'walls_verification', '__file__': str(path)}
    exec(compile(source, str(path), 'exec'), ns)
    bpy.ops.wm.read_factory_settings(use_empty=True)
    ns['setup_materials']()
    ns['OUTPUT'] = Path(tempfile.gettempdir()) / 'cat_tang_ch3_verify'
    ns['OUTPUT'].mkdir(exist_ok=True)
    return ns

def fingerprint(obj):
    data = {
        'vertices': [tuple(v.co) for v in obj.data.vertices],
        'faces': [(tuple(p.vertices), p.material_index, p.use_smooth) for p in obj.data.polygons],
        'materials': [mat.name for mat in obj.data.materials],
        'transform': [tuple(row) for row in obj.matrix_world],
    }
    return hashlib.sha256(json.dumps(data).encode()).hexdigest()

hashes = []
for source in (before, after):
    ns = load(source)
    current = {}
    for i, (name, width, builder) in enumerate(ns['SPECS']):
        if name == 'Cliff_Shore':
            continue
        ns['PARTS'] = []
        random.seed(34117+i*7919)
        builder()
        current[name] = fingerprint(ns['finish'](name, width))
    hashes.append(current)
