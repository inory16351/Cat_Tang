+    # Readable ratchet teeth around a solid brass wheel.
+    pts = []
+    for j in range(16):
+        for t, r in ((0, .36), (.18, .44), (.67, .44), (.86, .36)):
+            a = TAU*(j+t)/16
+            pts.append((r*math.cos(a), r*math.sin(a)))
+    poly('Sixteen-tooth winding ratchet', pts, .10, 'brass', (0, 0, .325))
