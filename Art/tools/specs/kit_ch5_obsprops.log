+    preview(objects, measured)
+    assert all(hashlib.sha256((OUT/('Kit_'+n+'.fbx')).read_bytes()).digest() == h
+               for n, h in protected.items())
+    print('DONE', flush=True)
+
+
+if __name__ == '__main__':
+    main()

