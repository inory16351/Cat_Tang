+        a = TAU*4*t
+        r = .14+.19*t
+        points.append((r*math.cos(a), r*math.sin(a), .46+.79*t))
+    points += [(.41, .05, 1.28), (.42, .26, 1.33), (.23, .37, 1.38)]
+    verts = []
+    for i, p in enumerate(points):
