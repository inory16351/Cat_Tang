+        ((0, -0.275), (-0.023, -0.275), (-0.075, -0.215), (-0.14, -0.16)),
+        ((-0.14, -0.16), (-0.205, -0.105), (-0.3, -0.005), (-0.3, 0.1)),
+        ((-0.3, 0.1), (-0.3, 0.21), (-0.245, 0.275), (-0.15, 0.275)),
