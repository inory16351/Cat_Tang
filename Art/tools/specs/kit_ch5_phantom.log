+        verts.extend((c.x+scale[0]*math.cos(a)*math.cos(TAU*j/n),
+                      c.y+scale[1]*math.cos(a)*math.sin(TAU*j/n),
+                      c.z+scale[2]*math.sin(a)) for j in range(n))
+    verts.append(tuple(c+Vector((0, 0, scale[2]))))
