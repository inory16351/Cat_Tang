+    'mirror': (.66, .83, .94), 'mirror_back': (.15, .25, .39),
+    'violet_dark': (.105, .032, .22), 'violet': (.32, .16, .49),
+    'indigo': (.015, .021, .075), 'gold': (.83, .49, .12),
+    'crack_gold': (1., .77, .20), 'magenta': (1., .025, .49),
