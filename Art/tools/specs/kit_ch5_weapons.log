+    assert triangles(obj)<=budget,(name,triangles(obj))
+    areas = {}
+    for p in obj.data.polygons:
+        role = obj.data.materials[p.material_index].name
+        areas[role] = areas.get(role,0)+p.area
+    assert len(areas)>=4,(name,areas)
