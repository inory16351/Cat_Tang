+            obj.rotation_euler = cam.rotation_euler
+
+        # Preview red gets its own non-exported material, not a game role.
+        red = bpy.data.materials.new('PREVIEW ONLY origin red')
+        red.diffuse_color = (1,.035,.045,1)
