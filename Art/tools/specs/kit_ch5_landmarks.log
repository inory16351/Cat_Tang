+    lower=[(.70,.64),(.88,.89),(.84,1.19),(.62,1.58),(.26,1.94),(.11,2.17)]
+    upper=[(.11,2.23),(.26,2.46),(.61,2.85),(.84,3.23),(.88,3.56),(.70,3.87)]
