+    'cloth': (.59, .43, .66), 'void_stone': (.28, .23, .43),
+    'lamp_warm': (1.0, .66, .27), 'iron_dark': (.065, .075, .15),
+    'red_lacquer': (.54, .10, .25), 'steel': (.39, .48, .63),
