+def tilt_parts(start, pivot, degrees):
+    mat = Matrix.Translation(Vector(pivot)) @ Euler((0,math.radians(degrees),0)).to_matrix().to_4x4() @ Matrix.Translation(-Vector(pivot))
+    for obj in PARTS[start:]:
+        obj.data.transform(mat)
