+    'mirror': (.48, .75, .91), 'mirror_back': (.10, .20, .29),
+    'crystal': (.59, .39, .94), 'wood': (.38, .25, .32),
+    'wood_dark': (.14, .095, .16), 'iron': (.22, .23, .33),
+    'iron_dark': (.075, .09, .15), 'steel': (.53, .64, .74),
