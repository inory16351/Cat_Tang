+        extrude('Weathered saloon plank',[(x-.155,.45),(x+.155,.45),(x+.155,top),
+                (x+.04,top-.09),(x-.07,top+.06),(x-.155,top-.02)],.53,.92,'wood',True)
+        for z in (.90,2.85):
