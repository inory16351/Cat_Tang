                float cool = Mathf.Clamp01((t - 0.3f) / 0.5f);
                c = Color.Lerp(Color.white, new Color(0.55f, 0.38f, 0.33f), cool);
// 개발용: 이펙트 생성 방식 비교 (2026-11-20 사용자: 최적화 — 오브젝트 풀링을 지금 방식과 비교해 보고)
