        IEnumerator MageOrbsRun(PlayerController p)
        {
            busy = true;
            Anim("Attack");
            Sfx.Play("e_conjure", 0.5f, 0.05f, 2);
            heldOrbs.Clear();
            var back = -Effects.Flat(transform.forward).normalized;
            var side = Vector3.Cross(Vector3.up, back);
            // 등 뒤 부채꼴로 하나씩 생김 (1.5초)
            for (int i = 0; i < MageOrbs; i++)
            {
                if (!health.Alive) yield break;
                float u = (i - (MageOrbs - 1) / 2f) / ((MageOrbs - 1) / 2f);
                var at = transform.position + back * 0.9f + side * u * 1.4f + Vector3.up * (1.8f + 0.35f * (1 - Mathf.Abs(u)));
                var o = EnemyProjectile.Spawn(at, ToP(p), MageOrbSpeed, projectileDamage, MageOrbSpeed * MageOrbLife, EnemyProjectile.Style.Orb);
                o.frozenUntil = float.MaxValue;
                heldOrbs.Add(o);
                Fx3("Stardust", at, 0.45f);
                yield return Hold(MageConjure / MageOrbs, _ => { });
                Face(ToP(p));
            }
            // 하나씩 느리게 유도해 날림
            for (int i = 0; i < heldOrbs.Count; i++)
            {
                if (!health.Alive) yield break;
                var o = heldOrbs[i];
                if (o && o.enabled)
                {
                    Anim(i % 2 == 0 ? "FlingR" : "FlingL");                        // 구슬마다 한 손씩 번갈아 내던짐
                    o.frozenUntil = 0;
                    o.Retarget(p.transform.position - o.transform.position);
                    o.homing = MageHoming;
                }
                heldOrbs[i] = null;
                yield return Hold(MageGap, _ => { });
            }
            heldOrbs.Clear();
            nextAttack = Time.time + MageInterval * Random.Range(0.85f, 1.15f) / AtkMul;
            float end = Time.time + RedTime;
            int fired = 0;
            float a0 = Random.Range(0f, 360f);
            while (Time.time < end && p && p.health.Alive && hp.Alive)
            {
                // 표 탄: 0.2초 간격으로 6발, 고양이 둘레 8m(벽 안쪽)에서 → 4m/초면 2초 남짓에 도착
                if (fired < 6 && Time.time >= end - RedTime + fired * 0.2f)
                {
                    var from = anchor + Quaternion.Euler(0, a0 + fired * 60f, 0) * Vector3.forward * 8f;
                    var rm = RunManager.Instance;
                    if (rm) from = rm.ClampToRoom(from, 1f);
                    var b = EnemyProjectile.Spawn(from + Vector3.up * 1.1f, anchor - from, 4f, 15f, 0, EnemyProjectile.Style.Ticket);
                    b.shootable = true;
                    fired++;
                }
                bool moved = Effects.Flat(p.transform.position - anchor).magnitude > 0.25f || p.health.dashing;
                if (moved && !punished)
                {
                    punished = true;
                    p.health.TakeDamage(p.health.maxHp * RedDmg);
                    FxBurst.Spawn(p.transform.position + Vector3.up, 2f, FxBurst.Kind.Explosion, Ch2Fx.Red);
                    BossFx.Toast("빨간불에 움직였다!");
                }
                if (moved) anchor = p.transform.position;          // 한 번만 벌함 (계속 움직여도 더는 안 깎음)
                yield return null;
            }
            // 초록불
            if (lamp) { lamp.color = Ch2Fx.Green; }
            BossFx.Toast("초록불");
            yield return Wait(0.6f);
            if (lamp) lamp.text = "";
            nextRed = Time.time + T(RedEvery - YellowTime - RedTime);
        }

        // 신호봉 휘두르기: 예고 0.6초, 전방 반원 반경 3.5m, 피해 18
        IEnumerator Baton()
        {
            var d = ToPlayer();
            bool ok = false;
            yield return Hold(DancerRise, r => ok = r);
            if (ok)
            {
                Anim("Spin");
                AnimBusy(true);
                Sfx.Play("e4_spin", 0.45f, 0.03f, 2);
                float dur = DancerSpin;
                StartCoroutine(SpinBody(dur, dur * 1.5f));
                var trail = GetComponent<EyeTrail>(); if (trail) trail.Hot(dur);
                float arm = Random.Range(0f, 360f), nextShot = 0f, sign = Random.value < 0.5f ? 1 : -1;
                for (float t = 0; t < dur; t += Time.deltaTime)
                {
                    if (!health.Alive || health.Stunned) break;
                    arm += DancerArmTurn * sign * Time.deltaTime;
                    if (t >= nextShot)
                    {
                        nextShot += DancerShotGap / AtkMul;
                        for (int k = 0; k < 2; k++)
                        {
                            var d = Quaternion.Euler(0, arm + k * 180f, 0) * Vector3.forward;
                            EnemyProjectile.Spawn(transform.position + Vector3.up * 1.1f + d * 0.7f, d, DancerBullet, projectileDamage, 14f, EnemyProjectile.Style.Orb);
                        }
                    }
                    // 도는 동안 아주 느리게 거리를 맞춤
                    if (p) { var to = Effects.Flat(p.transform.position - transform.position); float m = to.magnitude; if (m > 0.1f) transform.position += to / m * (m > DancerKeep ? 1 : -1) * DancerSpinSpeed * health.SlowMul * Time.deltaTime; }
                    yield return null;
                }
                AnimBusy(false);
                if (elite && health.Alive && !health.Stunned)
                {
                    Anim("Finale");
                    Sfx.Play("e4_finale", 0.6f);
                    for (int k = 0; k < 12; k++)
                    {
                        var d = Quaternion.Euler(0, k * 30f + arm, 0) * Vector3.forward;
                        EnemyProjectile.Spawn(transform.position + Vector3.up * 1.1f + d * 0.7f, d, DancerBullet, projectileDamage, 14f, EnemyProjectile.Style.Orb);
                    }
                    Spark(transform.position + Vector3.up * 1.6f, 1.4f);
                    yield return new WaitForSeconds(0.6f);
                }
                else yield return new WaitForSeconds(0.3f);
            }
            nextAttack = Time.time + DancerInterval * Random.Range(0.85f, 1.15f) / AtkMul;
            busy = false;
        }

        // ================= 초침 자객 =================
        void AssassinUpdate(PlayerController p, Vector3 dir, float dist, float spd)
        {
            if (busy) return;
            Face(dir);
            // 모든 자객이 같은 박자: 매 정수 초가 '째깍'. 0.18초 전에 웅크림
            if (nextTick < Time.time) { nextTick = Mathf.Ceil(Time.time + 0.05f); tickReady = false; }
            if (!tickReady && Time.time >= nextTick - TickCrouch / AtkMul) { tickReady = true; Anim("Blink"); }

