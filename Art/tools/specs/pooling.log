// 사격 궤적 (빛 탄도): 빛을 더하는 셰이더(CatTang/AdditiveGlow)로 세 겹. 색은 빨강 쪽 (탄 색 30%)
// - 번짐(halo): 가는 빨간 빛 띠. 가장 오래 남아 굵기가 줄며 사라짐
// - 심지(core): 가늘고 하얗게 달군 빨간 선. 짧게 번쩍
// - 탄두(head): 밝은 짧은 줄이 총구 → 목표로 0.05초 만에 날아감 (속도감)
// 탄마다 색 · 굵기가 다르고, 전설 · 공명 탄(doubleLine)은 번짐이 더 넓고 오래 감.
using UnityEngine;

namespace CatTang
{
    public class Tracer : MonoBehaviour
    {
        LineRenderer halo, core, head;
        float born, life, width;
        Vector3 a, b;
        Color col;
        float keep = TintKeep;
        static Material glowMat, softMat;
        const float HeadTime = 0.05f, HeadLen = 2.2f;

        public static void Spawn(Vector3 a, Vector3 b, bool awakened) => Spawn(a, b, awakened ? new Color(1f, 0.85f, 0.35f) : new Color(1f, 0.97f, 0.85f), awakened ? 0.16f : 0.09f, false);

        static void EnsureMats()
        {
            if (glowMat) return;
            var sh = Shader.Find("CatTang/AdditiveGlow");
            if (!sh) sh = Shader.Find("Sprites/Default");
            // 가로(길이) 방향은 그대로, 세로(굵기) 방향으로 가운데가 밝은 부드러운 띠
            Texture2D Band(float sharp)
            {
                var t = new Texture2D(4, 64, TextureFormat.RGBA32, false) { wrapMode = TextureWrapMode.Clamp, filterMode = FilterMode.Bilinear };
                for (int y = 0; y < 64; y++)
                {
                    float v = (y + 0.5f) / 64f * 2 - 1;
                    float al = Mathf.Exp(-v * v * sharp);
                    for (int x = 0; x < 4; x++) t.SetPixel(x, y, new Color(1, 1, 1, al));
                }
                t.Apply();
                return t;
            }
            softMat = new Material(sh) { mainTexture = Band(3.5f) };
            glowMat = new Material(sh) { mainTexture = Band(9f) };
            if (softMat.HasProperty("_Intensity")) { softMat.SetFloat("_Intensity", 1.6f); glowMat.SetFloat("_Intensity", 2.6f); }
        }

        /// <summary>trait = 특성 탄: 빨강으로 끌지 않고 특성 색 그대로 (2026-11-17 사용자: 얼음 탄이면 궤적도 파랗게)</summary>
        /// <param name="halo2">보조 특성 색: 바깥 번짐만 이 색 (심지 = 주 특성 색). 없으면 같은 색</param>
        public static void Spawn(Vector3 a, Vector3 b, Color c, float width, bool doubleLine, bool trait, Color? halo2 = null)
        {
            Spawn(a, b, c, width, doubleLine);
            if (trait && last) { last.keep = 0.92f; last.haloCol = halo2; }
        }
        Color? haloCol;
        static Tracer last;
        Vector3[] path;                 // 곡선 궤적 (자동 추적 탄, 2026-11-18 사용자): 꺾은선, 탄두가 이 선을 따라 날아감
        float[] pathLen;

        /// <summary>곡선 궤적: pts를 잇는 꺾은선 (자동 추적 탄이 조준 방향에서 표적 쪽으로 휘어 들어감)</summary>
        public static void SpawnPath(Vector3[] pts, Color c, float width, bool doubleLine, bool trait, Color? halo2 = null)
        {
            if (pts == null || pts.Length < 2) return;
            Spawn(pts[0], pts[pts.Length - 1], c, width, doubleLine, trait, halo2);
            var t = last;
            if (!t) return;
            t.path = pts;
            t.pathLen = new float[pts.Length];
            for (int i = 1; i < pts.Length; i++) t.pathLen[i] = t.pathLen[i - 1] + Vector3.Distance(pts[i - 1], pts[i]);
            foreach (var lr in new[] { t.halo, t.core })
            {
                lr.positionCount = pts.Length;
                lr.SetPositions(pts);
            }
            t.head.positionCount = 2;
            t.Update();
        }

        Vector3 PathAt(float d)
        {
            if (d <= 0) return path[0];
            for (int i = 1; i < path.Length; i++)
                if (d <= pathLen[i]) return Vector3.Lerp(path[i - 1], path[i], (d - pathLen[i - 1]) / Mathf.Max(1e-4f, pathLen[i] - pathLen[i - 1]));
            return path[path.Length - 1];
        }

        public static void Spawn(Vector3 a, Vector3 b, Color c, float width, bool doubleLine)
        {
            EnsureMats();
            var go = new GameObject("Tracer"); VividLayer.Set(go);
            var t = go.AddComponent<Tracer>();
            t.a = a; t.b = b; t.col = c;
            t.width = width;
            t.halo = Line(go, "Halo", softMat, a, b);
            t.core = Line(go, "Core", glowMat, a, b);
            t.head = Line(go, "Head", glowMat, a, a);
            t.born = Time.time;
            last = t;
            t.life = doubleLine ? 0.24f : 0.17f;
            if (doubleLine) t.width *= 1.3f;
            t.Update();
        }

        static LineRenderer Line(GameObject parent, string name, Material m, Vector3 a, Vector3 b)
        {
            var go = new GameObject(name); VividLayer.Set(go);
            go.transform.SetParent(parent.transform, false);
            var lr = go.AddComponent<LineRenderer>();
            lr.sharedMaterial = m;
            lr.positionCount = 2;
            lr.SetPosition(0, a);
            lr.SetPosition(1, b);
            lr.numCapVertices = 3;
            lr.textureMode = LineTextureMode.Stretch;
            lr.alignment = LineAlignment.View;
            lr.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.Off;
            lr.receiveShadows = false;
            return lr;
        }

        // 탄도 색은 빨강 쪽으로 (2026-11-16 사용자: 일반 사격을 얇고 빨갛게). 탄 색은 30%만 남겨 탄 종류는 살짝 구분
        static readonly Color Red = new Color(0.95f, 0.12f, 0.08f);
        const float TintKeep = 0.3f;

        void Update()
        {
            float age = Time.time - born;
            float k = age / life;
            if (k >= 1) { Destroy(gameObject); return; }
            var tint = Color.Lerp(Red, col, keep);
            var hot = Color.Lerp(tint, Color.white, 0.55f);       // 심지 · 탄두: 하얗게 달군 빨강

            // 번짐: 가늘게 → 더 가늘어지며 옅어짐. 총구 쪽이 조금 더 굵음
            float hk = 1 - k;
            halo.startWidth = width * 3.0f * (0.6f + 0.4f * hk);
            halo.endWidth = width * 2.0f * (0.6f + 0.4f * hk);
            var hc = haloCol.HasValue ? Color.Lerp(Red, haloCol.Value, keep) : tint; hc.a = 0.9f * hk * hk;
            halo.startColor = hc; halo.endColor = new Color(hc.r, hc.g, hc.b, hc.a * 0.7f);

            // 심지: 앞 40% 동안만
            float ck = Mathf.Clamp01(age / (life * 0.45f));
            core.enabled = ck < 1;
            if (core.enabled)
            {
                float w = width * 0.75f * (1 - ck);
                core.startWidth = w * 0.8f; core.endWidth = w;
                var cc = hot; cc.a = 1 - ck * ck;
                core.startColor = cc; core.endColor = cc;
            }

            // 탄두: 총구 → 목표로 날아가는 밝은 짧은 줄, 도착하면 꺼짐
            float tk = age / HeadTime;
            head.enabled = tk < 1.15f;
            if (head.enabled && path != null)
            {
                float plen = pathLen[pathLen.Length - 1];
                float ptip = Mathf.Min(plen, plen * Mathf.Clamp01(tk));
                head.SetPosition(0, PathAt(Mathf.Max(0, ptip - HeadLen)));
                head.SetPosition(1, PathAt(ptip));
                head.startWidth = width * 0.4f;
                head.endWidth = width * 1.6f;
                head.startColor = new Color(hot.r, hot.g, hot.b, 0);
                head.endColor = Color.Lerp(hot, Color.white, 0.5f);
            }
            else if (head.enabled)
            {
                float len = (b - a).magnitude;
                var dir = len > 1e-4f ? (b - a) / len : Vector3.forward;
                float tip = Mathf.Min(len, len * Mathf.Clamp01(tk));
                float tail = Mathf.Max(0, tip - HeadLen);
                head.SetPosition(0, a + dir * tail);
                head.SetPosition(1, a + dir * tip);
                head.startWidth = width * 0.4f;
                head.endWidth = width * 1.6f;
                head.startColor = new Color(hot.r, hot.g, hot.b, 0);
                head.endColor = Color.Lerp(hot, Color.white, 0.5f);
            }
        }
    }
}
// 피해 숫자: 숫자마다 따로 그린 이미지(Resources/UI/digits/d0~d9)를 이어 붙여 띄움. 튀어 오르며 커졌다 작아지고 사라짐.
// 치명타는 전용 글꼴(Resources/UI/digits_crit/d0~d9, Codex — 위 뜨거운 흰 노랑 · 아래 진홍, 금테, 기울임)으로 크게 · 더 세게 튀고 · 떨리며 조금 더 오래 (2026-11-17 사용자)
//  전용 그림이 없으면 일반 숫자를 붉게 물들여 씀
// 정지된 적 추가 피해(영원 6개 등)는 초록 글꼴(Resources/UI/digits_eternity, Codex — 위 민트 흰색 · 아래 에메랄드, 짙은 초록 테)로
//  본 숫자 위에 "+몫"처럼 하나 더 띄움 (2026-11-17 사용자). 그림이 없으면 일반 숫자를 초록으로
using System.Collections.Generic;
using UnityEngine;

namespace CatTang
{
    public class DamageNumber : MonoBehaviour
    {
        static readonly Material[] mats = new Material[10], critMats = new Material[10], bonusMats = new Material[10];
        static readonly float[] aspect = new float[10], critAspect = new float[10], bonusAspect = new float[10];
        static bool critLoaded, hasCritArt, hasBonusArt;
        static Mesh quad;
        readonly List<MeshRenderer> parts = new();
        float born, scale, life = 0.75f;
        bool crit;
        Color tint = Color.white;
        Vector3 vel;
        MaterialPropertyBlock mpb;

        static bool Load()
        {
            // 재질이 사라졌으면(플레이 모드 도메인 재로드 꺼짐 등으로 정적 캐시만 남은 경우) 다시 만듦
            if (mats[0] && (!hasCritArt || critMats[0]) && (!hasBonusArt || bonusMats[0])) return true;
            var sh = Shader.Find("Sprites/Default");
            if (!LoadSet("UI/digits/d", sh, mats, aspect, 3100)) return false;
            critLoaded = false;
            if (!critLoaded)
            {
                critLoaded = true;
                hasCritArt = LoadSet("UI/digits_crit/d", sh, critMats, critAspect, 3101);
                hasBonusArt = LoadSet("UI/digits_eternity/d", sh, bonusMats, bonusAspect, 3101);
            }
            if (!quad)
            {
                var tmp = GameObject.CreatePrimitive(PrimitiveType.Quad);
                quad = tmp.GetComponent<MeshFilter>().sharedMesh;
                Destroy(tmp);
            }
            return true;
        }

        static bool LoadSet(string path, Shader sh, Material[] m, float[] asp, int queue)
        {
            for (int i = 0; i < 10; i++)
            {
                var tex = Resources.Load<Texture2D>(path + i);
                if (!tex) return false;
                m[i] = new Material(sh) { mainTexture = tex, renderQueue = queue };
                asp[i] = (float)tex.width / tex.height;
            }
            return true;
        }

        /// <summary>정지된 적 추가 피해 몫: 초록 숫자 (본 숫자보다 조금 작게, 늦게 · 덜 튀며)</summary>
        public static void SpawnBonus(Vector3 pos, float dmg)
        {
            if (!Load()) return;
            if (dmg < 0.5f) return;
            Spawn(pos, dmg, false, true);
        }

        /// <summary>조건부 추가 피해 몫 (보스 · 표식 · 상태 이상 · 거리 · 판정 시각 등): 금빛 숫자 (2026-11-18 사용자). 초록 숫자와 같은 크기 · 움직임</summary>
        public static void SpawnCond(Vector3 pos, float dmg)
        {
            if (!Load()) return;
            if (dmg < 0.5f) return;
            Spawn(pos, dmg, false, true, true);
        }

        public static void Spawn(Vector3 pos, float dmg, bool crit = false) => Spawn(pos, dmg, crit, false);

        static readonly Color CondGold = new(1f, 0.8f, 0.25f);

        static void Spawn(Vector3 pos, float dmg, bool crit, bool bonus, bool cond = false)
        {
            if (!Load()) return;
            var go = new GameObject(crit ? "DmgCrit" : "Dmg");
            go.transform.position = pos + new Vector3(Random.Range(-0.35f, 0.35f), crit ? 0.25f : 0, 0);
            var d = go.AddComponent<DamageNumber>();
            // 2026-11-17 사용자: 피해 숫자가 잘 안 보임 → 전체 1.5배 (0.4 · 0.5 · 0.62 → 0.6 · 0.75 · 0.93), 치명타는 그 1.35배
            d.scale = (dmg >= 30 ? 0.93f : dmg >= 15 ? 0.75f : 0.6f) * (crit ? 1.35f : 1f);
            d.vel = new Vector3(Random.Range(-0.6f, 0.6f), crit ? 3.8f : 3.2f, 0);
            d.crit = crit;
            d.life = crit ? 0.95f : 0.75f;
            bool art = crit && hasCritArt || bonus && !cond && hasBonusArt;   // 금빛은 일반 숫자를 물들임
            var useMats = !art ? mats : bonus ? bonusMats : critMats;
            var useAspect = !art ? aspect : bonus ? bonusAspect : critAspect;
            if (crit && !art) d.tint = new Color(1f, 0.45f, 0.4f);
            if (bonus && !art) d.tint = cond ? CondGold : new Color(0.35f, 1f, 0.45f);
            if (bonus) { d.scale *= 0.85f; d.vel.y = 2.6f; d.life = 0.85f; }
            d.born = Time.time;
            d.mpb = new MaterialPropertyBlock();
            string s = Mathf.Max(1, Mathf.RoundToInt(dmg)).ToString();
            float total = 0;
            foreach (var c in s) total += useAspect[c - '0'] * 0.82f;
            float x = -total / 2;
            foreach (var c in s)
            {
                int n = c - '0';
                var p = new GameObject("d" + n);
                p.transform.SetParent(go.transform, false);
                float w = useAspect[n] * 0.82f;
                p.transform.localPosition = new Vector3(x + w / 2, 0, 0);
                p.transform.localScale = new Vector3(useAspect[n], 1, 1);
                p.AddComponent<MeshFilter>().sharedMesh = quad;
                var mr = p.AddComponent<MeshRenderer>();
                mr.sharedMaterial = useMats[n];
                mr.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.Off;
                d.parts.Add(mr);
                x += w;
            }
            go.transform.localScale = Vector3.one * d.scale;
        }

        void Update()
        {
            float t = (Time.time - born) / life;
            if (t >= 1) { Destroy(gameObject); return; }
            vel.y -= 9f * Time.deltaTime;
            transform.position += vel * Time.deltaTime;
            var cam = Camera.main;
            if (cam) transform.rotation = cam.transform.rotation;
            float peak = crit ? 1.5f : 1.25f;
            float pop = t < 0.15f ? Mathf.Lerp(0.4f, peak, t / 0.15f) : Mathf.Lerp(peak, 0.9f, Mathf.Clamp01((t - 0.15f) / 0.3f));
            transform.localScale = Vector3.one * scale * pop;
            if (crit && t < 0.35f) transform.position += cam ? cam.transform.right * Mathf.Sin(Time.time * 90f) * 0.03f * (1 - t / 0.35f) : Vector3.zero;   // 치명타: 처음에 떨림
            float a = t < 0.6f ? 1 : 1 - (t - 0.6f) / 0.4f;
            mpb.SetColor("_Color", new Color(tint.r, tint.g, tint.b, a));
            foreach (var r in parts) r.SetPropertyBlock(mpb);
        }
    }
}
// 적 공격 예고: 바닥에 그림. 시간이 지나며 안쪽이 차오르고, 끝나면 사라짐.
// Ring = 원형 범위 (폭발 · 휘두르기), Lane = 직선 (돌진 경로), Aim = 가는 조준선 (사격)
// 가시성 (2026-11-17 사용자: 주황 흙바닥에 묻힘):
// - 색: 위험 = 진홍 분홍, 조준 = 보라 (주황 바닥의 보색 쪽)
// - 범위 전체에 어두운 반투명 그림자 판 → 바닥과 분리, 진행도만큼 색 판이 차오름
// - 밝은 빛 테두리 밑에 굵은 어두운 선을 덧댐 → 어떤 바닥에서도 테두리가 보임
using UnityEngine;

namespace CatTang
{
    public class Telegraph : MonoBehaviour
    {
        enum Shape { Ring, Lane, Sector }
        Shape shape;
        LineRenderer outer, fill, back;
        MeshFilter areaBack, areaFill;
        Mesh backMesh, fillMesh;
        static Material darkMat;
        float born, life, radius, len, width, half;
        const int ArcN = 24;
        Color col;
        Transform follow;
        static Material mat;

        static readonly Color DangerPink = new(1f, 0.14f, 0.36f);        // 진홍 분홍
        static readonly Color DangerRed = new(1f, 0.06f, 0.08f);         // 4장 느와르: 흑백 위 새빨강 (2026-11-19 사용자)
        static readonly Color DangerMagenta = new(1f, 0.16f, 0.72f);    // 5장: 보라 · 금 우주 위 자홍 (2026-11-19 md 챕터 5 '적 공격 궤적은 자홍 · 마젠타')
        public static Color Danger => EnemyProjectile.Ch4 ? DangerRed : EnemyProjectile.Ch5 ? DangerMagenta : DangerPink;
        public static readonly Color Aim = new(0.82f, 0.38f, 1f);      // 보라
        static readonly Color Shadow = new(0.06f, 0.02f, 0.08f, 0.34f);
        static readonly Color Ink = new(0.05f, 0.01f, 0.07f, 0.9f);

        static Material DarkMat()
        {
            if (!darkMat) darkMat = new Material(Shader.Find("CatTang/Sprite") ?? Shader.Find("Sprites/Default")) { renderQueue = 2999 };
            return darkMat;
        }

        LineRenderer NewDarkLine(string name)
        {
            var lr = NewLine(transform, name);
            lr.sharedMaterial = DarkMat();
            return lr;
        }

        MeshFilter NewArea(string name, out Mesh mesh, float y)
        {
            var go = new GameObject(name);
            go.transform.SetParent(transform, false);
            go.transform.localPosition = new Vector3(0, y, 0);
            var mf = go.AddComponent<MeshFilter>();
            mesh = new Mesh { name = name };
            mesh.MarkDynamic();
            mf.sharedMesh = mesh;
            var mr = go.AddComponent<MeshRenderer>();
            mr.sharedMaterial = DarkMat();
            mr.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.Off;
            mr.receiveShadows = false;
            return mf;
        }

        /// <summary>로컬 평면 모양 메시: 원(반지름 r) · 부채꼴(반지름 r, ±half°, +Z가 가운데) · 직선(폭 w, 길이 l, +Z 방향)</summary>
        void ShapeMesh(Mesh m, float r, float l, Color c)
        {
            var v = new System.Collections.Generic.List<Vector3>();
            var t = new System.Collections.Generic.List<int>();
            if (shape == Shape.Lane)
            {
                float hw = width / 2;
                v.Add(new Vector3(-hw, 0, 0)); v.Add(new Vector3(hw, 0, 0)); v.Add(new Vector3(-hw, 0, l)); v.Add(new Vector3(hw, 0, l));
                t.AddRange(new[] { 0, 2, 1, 2, 3, 1 });
            }
            else
            {
                v.Add(Vector3.zero);
                int n = shape == Shape.Ring ? 40 : ArcN;
                for (int i = 0; i <= n; i++)
                {
                    float a = shape == Shape.Ring ? i * 360f / n : Mathf.Lerp(-half, half, i / (float)n);
                    v.Add(Quaternion.AngleAxis(a, Vector3.up) * Vector3.forward * r);
                }
                for (int i = 1; i <= n; i++) { t.Add(0); t.Add(i); t.Add(i + 1); }
            }
            var cs = new Color[v.Count];
            for (int i = 0; i < cs.Length; i++) cs[i] = c;
            m.Clear();
            m.SetVertices(v);
            m.SetTriangles(t, 0);
            m.colors = cs;
            m.RecalculateBounds();
        }

        static LineRenderer NewLine(Transform parent, string name)
        {
            if (!mat)
            {
                var sh = Shader.Find("CatTang/AdditiveGlow") ?? Shader.Find("Sprites/Default");
                mat = new Material(sh);
                if (mat.HasProperty("_Intensity")) mat.SetFloat("_Intensity", 1.8f);
            }
            var go = new GameObject(name);
            go.transform.SetParent(parent, false);
            var lr = go.AddComponent<LineRenderer>();
            lr.sharedMaterial = mat;
            lr.useWorldSpace = true;
            lr.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.Off;
            lr.receiveShadows = false;
            lr.numCapVertices = 2;
            lr.alignment = LineAlignment.TransformZ;    // 바닥에 눕힘 (아래 회전으로 Z가 위를 봄)
            go.transform.rotation = Quaternion.Euler(90, 0, 0);
            return lr;
        }

        /// <summary>원형 범위 예고 (follow가 있으면 그 위치를 따라감)</summary>
        public static Telegraph Ring(Vector3 at, float radius, float dur, Color c, Transform follow = null)
        {
            var t = new GameObject("Telegraph_Ring").AddComponent<Telegraph>();
            t.transform.position = at;
            t.shape = Shape.Ring; t.radius = radius; t.life = dur; t.col = c; t.follow = follow;
            t.Init();
            return t;
        }

        /// <summary>직선 예고: from에서 dir로 len만큼, 폭 width</summary>
        public static Telegraph Lane(Vector3 from, Vector3 dir, float len, float width, float dur, Color c, Transform follow = null)
        {
            var t = new GameObject("Telegraph_Lane").AddComponent<Telegraph>();
            t.transform.position = from;
            dir.y = 0;
            t.transform.rotation = Quaternion.LookRotation(dir.sqrMagnitude > 0.0001f ? dir.normalized : Vector3.forward);
            t.shape = Shape.Lane; t.len = len; t.width = width; t.life = dur; t.col = c; t.follow = follow;
            t.Init();
            return t;
        }

        /// <summary>부채꼴 예고: dir 방향을 가운데로 양쪽 halfAngle도, 반지름 radius</summary>
        public static Telegraph Sector(Vector3 at, Vector3 dir, float radius, float halfAngle, float dur, Color c, Transform follow = null)
        {
            var t = new GameObject("Telegraph_Sector").AddComponent<Telegraph>();
            t.transform.position = at;
            dir.y = 0;
            t.transform.rotation = Quaternion.LookRotation(dir.sqrMagnitude > 0.0001f ? dir.normalized : Vector3.forward);
            t.shape = Shape.Sector; t.radius = radius; t.half = halfAngle; t.life = dur; t.col = c; t.follow = follow;
            t.Init();
            return t;
        }

        /// <summary>방향 바꾸기 (조준선이 대상을 쫓을 때)</summary>
        public void SetDir(Vector3 dir) { dir.y = 0; if (dir.sqrMagnitude > 0.0001f) transform.rotation = Quaternion.LookRotation(dir.normalized); }
        public void SetColor(Color c) => col = c;

        bool grow, glint = true, glinted, laser = true;
        /// <summary>4장: 끝날 때 레이저 베기 호 · 레이저 줄을 띄우지 않음 (무기 칼빛 BladeStreak가 칼날에 붙어 대신 그림)</summary>
        public Telegraph NoLaser() { laser = false; return this; }

        /// <summary>
        /// 직선 예고(Lane)와 똑같은 판정 (2026-11-19 사용자: 실제 타격 범위와 예고를 같게): from에서 dir로 [0, len] · 폭 width 안에 점(몸 중심)이 있으면 참.
        /// 돌진은 lo~hi = 지금 몸이 덮고 있는 구간(나아간 거리 ± 몸 반지름)만 — 몸이 지나간 뒤 남은 길에 들어가도 맞지 않음
        /// </summary>
        public static bool InLane(Vector3 pt, Vector3 from, Vector3 dir, float len, float width, float lo = 0f, float hi = float.MaxValue)
        {
            dir.y = 0; if (dir.sqrMagnitude < 1e-6f) return false; dir.Normalize();
            var rel = Effects.Flat(pt - from);
            float along = Vector3.Dot(rel, dir);
            return along >= Mathf.Max(0f, lo) && along <= Mathf.Min(len, hi) && (rel - dir * along).magnitude <= width * 0.5f;
        }
        /// <summary>끝나기 직전 예고 섬광을 띄우지 않음 (공격이 아닌 표시: 폭탄병 착지 조준 등)</summary>
        public Telegraph NoGlint() { glint = false; return this; }
        /// <summary>원 자체가 작게 시작해 끝날 때 반경까지 커짐 (폭탄병 점멸: 다 커지는 순간 폭발). 깜빡임도 점점 빨라짐</summary>
        public Telegraph Grow() { grow = true; Redraw(0); return this; }

        void Init()
        {
            born = Time.time;
            areaBack = NewArea("AreaShadow", out backMesh, 0.025f);
            areaFill = NewArea("AreaFill", out fillMesh, 0.03f);
            back = NewDarkLine("OuterInk");
            outer = NewLine(transform, "Outer");
            fill = NewLine(transform, "Fill");
            if (shape == Shape.Ring)
            {
                outer.loop = fill.loop = true;
                outer.positionCount = fill.positionCount = 40;
                outer.widthMultiplier = 0.09f;
                fill.widthMultiplier = 0.22f;
            }
            else if (shape == Shape.Sector)
            {
                outer.loop = fill.loop = true;
                outer.positionCount = fill.positionCount = ArcN + 2;
                outer.widthMultiplier = 0.09f;
                fill.widthMultiplier = 0.18f;
            }
            else
            {
                outer.positionCount = 5;
                outer.loop = true;
                outer.widthMultiplier = 0.07f;
                fill.positionCount = 2;
                fill.widthMultiplier = width;
            }
            Redraw(0);
        }

        /// <summary>바로 지우기 (공격이 취소됐을 때)</summary>
        public void Kill() { if (this) Destroy(gameObject); }

        void Update()
        {
            float k = Mathf.Clamp01((Time.time - born) / Mathf.Max(0.01f, life));
            if (follow) transform.position = follow.position;
            Redraw(k);
            // 공격 직전 예고 섬광 (젠레스 존 제로식 주황 십자 반짝임): 끝나기 0.15초 전 = 이때 회피하면 극한 회피
            if (glint && !glinted && life > 0.25f && life - (Time.time - born) <= 0.15f)
            {
                glinted = true;
                GunkataFx.WarnGlint(transform.position + Vector3.up * 1.6f);
            }
            if (Time.time - born >= life)
            {
                // 4장 (느와르): 적 예고가 끝나는 순간 = 공격이 나가는 순간 → 레이저 베기 호 · 레이저 줄 (LaserFx)
                if (laser && LaserFx.On && col.r > 0.8f && col.g < 0.3f)
                {
                    if (shape == Shape.Sector) LaserFx.Slash(transform.position, transform.forward, radius);
                    else if (shape == Shape.Lane) LaserFx.Streak(transform.position, transform.forward, len, width);
                }
                Destroy(gameObject);
            }
        }

        void Redraw(float k)
        {
            float age = Time.time - born;
            float pulse = 0.65f + 0.35f * Mathf.Sin(grow ? age * Mathf.Lerp(18f, 60f, k) : age * 28f);
            var edge = col * (1.0f + 0.5f * k * pulse); edge.a = 1;          // 처음부터 밝게 (가시성)
            var inner = col * (0.6f + 0.5f * k); inner.a = 1;
            outer.startColor = outer.endColor = edge;
            fill.startColor = fill.endColor = inner;
            Vector3 o = transform.position + Vector3.up * 0.05f;
            if (shape == Shape.Ring)
            {
                // 커지기: 바깥 원이 반경의 15%에서 끝에 100%로 (처음엔 빠르게, 끝에서 살짝 느려지며 꽉 참), 안쪽 선이 바로 뒤를 따라옴
                float ro = grow ? radius * Mathf.Lerp(0.15f, 1f, 1 - (1 - k) * (1 - k)) : radius;
                float rf = grow ? Mathf.Max(0.05f, ro * Mathf.Lerp(0.5f, 0.92f, k)) : Mathf.Max(0.05f, radius * k);
                for (int i = 0; i < 40; i++)
                {
                    float a = i / 40f * Mathf.PI * 2;
                    var d = new Vector3(Mathf.Cos(a), 0, Mathf.Sin(a));
                    outer.SetPosition(i, o + d * ro);
                    fill.SetPosition(i, o + d * rf);
                }
            }
            else if (shape == Shape.Sector)
            {
                float rf = Mathf.Max(0.05f, radius * k);
                outer.SetPosition(0, o);
                fill.SetPosition(0, o);
                for (int i = 0; i <= ArcN; i++)
                {
                    float a = Mathf.Lerp(-half, half, i / (float)ArcN);
                    var d = Quaternion.AngleAxis(a, Vector3.up) * transform.forward;
                    outer.SetPosition(i + 1, o + d * radius);
                    fill.SetPosition(i + 1, o + d * rf);
                }
            }
            else
            {
                var f = transform.forward; var s = transform.right * width / 2;
                outer.SetPosition(0, o - s);
                outer.SetPosition(1, o - s + f * len);
                outer.SetPosition(2, o + s + f * len);
                outer.SetPosition(3, o + s);
                outer.SetPosition(4, o - s);
                fill.SetPosition(0, o);
                fill.SetPosition(1, o + f * Mathf.Max(0.05f, len * k));
            }
