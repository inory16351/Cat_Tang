        public void Begin(Color? tint)
        {
            mr = GetComponent<MeshRenderer>();
            mpb = new MaterialPropertyBlock();
            if (!string.IsNullOrEmpty(flipSet))
            {
                frames = FxFlipbook.Frames(flipSet);
