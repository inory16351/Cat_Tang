using UnityEngine;

namespace CatTang
{
    // 풀링 (2026-11-20): 계층과 컴포넌트는 처음 한 번만 찾아 반환과 복원을 처리한다.
    public sealed class PoolMember : MonoBehaviour
    {
        internal GameObjectPool.Bucket Owner;
        internal bool Idle;
        internal float ReturnAt = -1f;
        Transform[] nodes, parents;
        Vector3[] positions, scales;
        Quaternion[] rotations;
        bool[] active;
        int[] layers;
        MonoBehaviour[] scripts;
        Behaviour[] behaviours;
        Renderer[] renderers;
        Collider[] colliders;
        bool[] behaviourEnabled, rendererEnabled, colliderEnabled;
        IPooled[] callbacks;

        internal void Init(GameObjectPool.Bucket owner)
        {
            Owner = owner;
            nodes = GetComponentsInChildren<Transform>(true);
            parents = new Transform[nodes.Length];
            positions = new Vector3[nodes.Length]; scales = new Vector3[nodes.Length];
            rotations = new Quaternion[nodes.Length]; active = new bool[nodes.Length]; layers = new int[nodes.Length];
            for (int i = 0; i < nodes.Length; i++)
            {
                var t = nodes[i];
                parents[i] = t.parent;
                positions[i] = t.localPosition; scales[i] = t.localScale; rotations[i] = t.localRotation;
                active[i] = t.gameObject.activeSelf; layers[i] = t.gameObject.layer;
            }
            scripts = GetComponentsInChildren<MonoBehaviour>(true);
            behaviours = GetComponentsInChildren<Behaviour>(true);
            renderers = GetComponentsInChildren<Renderer>(true);
            colliders = GetComponentsInChildren<Collider>(true);
            behaviourEnabled = new bool[behaviours.Length]; rendererEnabled = new bool[renderers.Length]; colliderEnabled = new bool[colliders.Length];
            int count = 0;
            for (int i = 0; i < scripts.Length; i++) if (scripts[i] is IPooled) count++;
            callbacks = new IPooled[count];
            for (int i = 0, j = 0; i < scripts.Length; i++) if (scripts[i] is IPooled pooled) callbacks[j++] = pooled;
            for (int i = 0; i < behaviours.Length; i++) behaviourEnabled[i] = behaviours[i].enabled;
            for (int i = 0; i < renderers.Length; i++) rendererEnabled[i] = renderers[i].enabled;
            for (int i = 0; i < colliders.Length; i++) colliderEnabled[i] = colliders[i].enabled;
        }

        internal void Spawn()
        {
            Idle = false; ReturnAt = -1f;
            transform.SetParent(null, false);
            transform.SetPositionAndRotation(Vector3.zero, Quaternion.identity);
            transform.localScale = Vector3.one;
            for (int i = 0; i < nodes.Length; i++)
            {
                var t = nodes[i];
                if (!t) continue;
                if (i > 0)
                {
                    t.SetParent(parents[i] ? parents[i] : transform, false);
                    t.localPosition = positions[i]; t.localRotation = rotations[i]; t.localScale = scales[i];
                    t.gameObject.SetActive(active[i]);
                }
                t.gameObject.layer = layers[i];
            }
            for (int i = 0; i < behaviours.Length; i++) if (behaviours[i]) behaviours[i].enabled = behaviourEnabled[i];
            for (int i = 0; i < renderers.Length; i++) if (renderers[i]) { renderers[i].enabled = rendererEnabled[i]; renderers[i].SetPropertyBlock(null); }
            for (int i = 0; i < colliders.Length; i++) if (colliders[i]) colliders[i].enabled = colliderEnabled[i];
            for (int i = 0; i < callbacks.Length; i++) callbacks[i].OnSpawned();
            gameObject.SetActive(true);
        }

        internal void Despawn()
        {
            Idle = true; ReturnAt = -1f;
            for (int i = 0; i < scripts.Length; i++)
                if (scripts[i]) { scripts[i].StopAllCoroutines(); scripts[i].CancelInvoke(); }
            for (int i = 0; i < callbacks.Length; i++) callbacks[i].OnDespawned();
        }

        void Update()
        {
            if (ReturnAt >= 0f && Time.time >= ReturnAt) GameObjectPool.Release(gameObject);
        }
    }
}
using System;
using System.Collections.Generic;
using UnityEngine;

namespace CatTang
{
    // 풀링 (2026-11-20): 씬 안에서만 보관하며 생성과 파괴가 몰리는 비용을 줄인다.
    public static class GameObjectPool
    {
        internal sealed class Bucket
        {
            internal readonly Stack<GameObject> Idle = new();
            internal readonly Stack<GameObject> Scratch = new();
            internal int MaxKeep = 512, Created, Reused;
        }

        static readonly Dictionary<object, Bucket> pools = new();
        static Transform root;

        static void EnsureRoot()
        {
            if (root) return;
            pools.Clear();
            root = new GameObject("[Pools]").transform;
        }

        static Bucket For(object key)
        {
            EnsureRoot();
            if (!pools.TryGetValue(key, out var bucket)) pools[key] = bucket = new Bucket();
            return bucket;
        }

        static GameObject Take(Bucket bucket)
        {
            while (bucket.Idle.Count > 0)
            {
                var go = bucket.Idle.Pop();
                if (!go) continue;
                bucket.Reused++;
                go.GetComponent<PoolMember>().Spawn();
                return go;
            }
            return null;
        }

        static GameObject Register(GameObject go, Bucket bucket, bool spawn)
        {
            if (!go) return null;
            go.SetActive(false);
            var member = go.AddComponent<PoolMember>();
            member.Init(bucket);
            bucket.Created++;
            if (spawn) member.Spawn();
            else Release(go);
            return go;
        }

        public static GameObject Get(string key, Func<GameObject> factory)
        {
            var bucket = For(key);
            var go = Take(bucket);
            return go ? go : Register(factory(), bucket, true);
        }

        // 키를 받는 정적 팩토리는 호출마다 캡처 람다를 만들지 않는다.
        public static GameObject Get(string key, Func<string, GameObject> factory)
        {
            var bucket = For(key);
            var go = Take(bucket);
            return go ? go : Register(factory(key), bucket, true);
        }

        public static GameObject Get(GameObject prefab)
        {
            if (!prefab) return null;
            var bucket = For(prefab);
            var go = Take(bucket);
            return go ? go : Register(UnityEngine.Object.Instantiate(prefab), bucket, true);
        }

        public static GameObject Get(GameObject prefab, Func<GameObject> factory)
        {
            var bucket = For(prefab);
            var go = Take(bucket);
            return go ? go : Register(factory(), bucket, true);
        }

        public static void Release(GameObject go)
        {
            if (!go) return;
            var member = go.GetComponent<PoolMember>();
            if (!member) { UnityEngine.Object.Destroy(go); return; }
            if (member.Idle) return;
            member.Despawn();
            go.SetActive(false);
            if (!root || member.Owner.Idle.Count >= member.Owner.MaxKeep)
            {
                UnityEngine.Object.Destroy(go);
                return;
            }
            go.transform.SetParent(root, false);
            member.Owner.Idle.Push(go);
        }

        // 탄의 꼬리는 기존 시간만큼 남긴 뒤 통째로 반환한다.
        public static void ReleaseAfter(GameObject go, float delay)
        {
            var member = go ? go.GetComponent<PoolMember>() : null;
            if (member) member.ReturnAt = Time.time + delay;
            else if (go) UnityEngine.Object.Destroy(go, delay);
        }

        public static void Prewarm(string key, Func<GameObject> factory, int count, int maxCreate = int.MaxValue)
        {
            var bucket = For(key);
            Prune(bucket);
            int target = Mathf.Min(count, bucket.MaxKeep);
            int remaining = Mathf.Max(0, maxCreate);
            while (bucket.Idle.Count < target && remaining-- > 0)
                if (!Register(factory(), bucket, false)) break;
        }

        public static void Prewarm(string key, Func<string, GameObject> factory, int count, int maxCreate = int.MaxValue)
        {
            var bucket = For(key);
            Prune(bucket);
            int target = Mathf.Min(count, bucket.MaxKeep);
            int remaining = Mathf.Max(0, maxCreate);
            while (bucket.Idle.Count < target && remaining-- > 0)
                if (!Register(factory(key), bucket, false)) break;
        }

        public static void Prewarm(GameObject prefab, int count, int maxCreate = int.MaxValue)
        {
            if (!prefab) return;
            var bucket = For(prefab);
            Prune(bucket);
            int target = Mathf.Min(count, bucket.MaxKeep);
            int remaining = Mathf.Max(0, maxCreate);
            while (bucket.Idle.Count < target && remaining-- > 0)
                Register(UnityEngine.Object.Instantiate(prefab), bucket, false);
        }

        public static void Prewarm(GameObject prefab, Func<GameObject> factory, int count, int maxCreate = int.MaxValue)
        {
            var bucket = For(prefab);
            Prune(bucket);
            int target = Mathf.Min(count, bucket.MaxKeep);
            int remaining = Mathf.Max(0, maxCreate);
            while (bucket.Idle.Count < target && remaining-- > 0)
                if (!Register(factory(), bucket, false)) break;
        }

        static void Prune(Bucket bucket)
        {
            while (bucket.Idle.Count > 0)
            {
                var go = bucket.Idle.Pop();
                if (go) bucket.Scratch.Push(go);
            }
            while (bucket.Scratch.Count > 0) bucket.Idle.Push(bucket.Scratch.Pop());
        }

        public static void SetMaxKeep(object key, int maxKeep)
        {
            var bucket = For(key);
            bucket.MaxKeep = Mathf.Max(0, maxKeep);
            while (bucket.Idle.Count > bucket.MaxKeep)
            {
                var go = bucket.Idle.Pop();
                if (go) UnityEngine.Object.Destroy(go);
            }
        }

        public static PoolStats Stats(object key)
        {
            if (!root || !pools.TryGetValue(key, out var bucket)) return default;
            int idle = 0;
            foreach (var go in bucket.Idle) if (go) idle++;
            return new PoolStats(bucket.Created, bucket.Reused, idle);
        }
    }
}

