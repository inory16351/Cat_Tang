        void OnEnable() { All.Add(this); nextAttack = Time.time + Random.Range(0.6f, 1.4f); }
        void OnDisable() { All.Remove(this); if (tele) tele.Kill(); }

        float AtkMul => Mathf.Max(0.2f, health.AttackSpeedMul) * (Wound ? WindBoost : 1f);   // 4장 시계 수리공이 태엽을 감아 주면 1.3배

        void Update()
        {
            var p = PlayerController.Instance;
            if (!health.Alive || p == null || !p.health.Alive) return;
            if (health.Stunned) { CancelAct(); return; }
            Vector3 to = p.transform.position - transform.position;
            to.y = 0;
            float dist = to.magnitude;
            Vector3 dir = dist > 0.01f ? to / dist : transform.forward;
            float spd = speed * health.SlowMul * (Wound ? WindBoost : 1f);
            Vector3 before = transform.position;

            switch (kind)
            {
                case Kind.Outlaw: OutlawUpdate(p, dir, dist, spd); break;
                case Kind.Brute: BruteUpdate(p, dir, dist, spd); break;
                case Kind.Bomber: BomberUpdate(p, dir, dist, spd); break;
                case Kind.Conductor: ConductorUpdate(p, dir, dist, spd); break;
                case Kind.Porter: PorterUpdate(p, dir, dist, spd); break;
                case Kind.Signal: SignalUpdate(p, dir, dist, spd); break;
                case Kind.MirrorShooter: ShooterUpdate(p, dir, dist, spd); break;
                case Kind.LightMage: MageUpdate(p, dir, dist, spd); break;
                case Kind.MirrorBlade: BladeUpdate(p, dir, dist, spd); break;
                case Kind.GlassKnight: KnightUpdate(p, dir, dist, spd); break;
                case Kind.Trickster: TricksterUpdate(p, dir, dist, spd); break;
                case Kind.ClockSoldier: SoldierUpdate(p, dir, dist, spd); break;
                case Kind.BellRinger: RingerUpdate(p, dir, dist, spd); break;
                case Kind.MusicDancer: DancerUpdate(p, dir, dist, spd); break;
                case Kind.TickAssassin: AssassinUpdate(p, dir, dist, spd); break;
                case Kind.PendulumKnight: PKnightUpdate(p, dir, dist, spd); break;
                case Kind.Repairman: RepairUpdate(p, dir, dist, spd); break;
                case Kind.ShardGunner: GunnerUpdate(p, dir, dist, spd); break;
                case Kind.StarWitch: WitchUpdate(p, dir, dist, spd); break;
                case Kind.RuinGiant: GiantUpdate(p, dir, dist, spd); break;
                case Kind.RiftAssassin: RiftAssassinUpdate(p, dir, dist, spd); break;
                case Kind.RiftCaster: CasterUpdate(p, dir, dist, spd); break;
                case Kind.MirrorPhantom: PhantomUpdate(p, dir, dist, spd); break;   // 5장 전용 (분신 = 고양이를 축으로 비친 자리, 깨졌다 다시 맞춰지는 자리 바꾸기)
                case Kind.Boss:
                    if (!brain) brain = GetComponent<BossBrain>();
                    if (brain) brain.Tick(p, dir, dist, spd); else BossUpdate(p, dir, dist, spd);
                    break;
            }
            Animate((transform.position - before).magnitude / Mathf.Max(0.0001f, Time.deltaTime));
        }

        void Face(Vector3 dir) { if (dir.sqrMagnitude > 0.0001f) transform.rotation = Quaternion.Slerp(transform.rotation, Quaternion.LookRotation(dir), 12f * Time.deltaTime); }

        void CancelAct()
        {
            if (tele) tele.Kill();
            if (act == Act.Fuse || act == Act.Leap) return;   // 폭탄병 점멸 · 공중 도약은 기절해도 이어짐 (불붙은 심지)
            act = Act.Move;
        }

        // ---------- 태엽 무법자 ----------
        void OutlawUpdate(PlayerController p, Vector3 dir, float dist, float spd)
        {
            // 강화형: 고양이가 조준하면 옆으로 대시(실루엣 잔상) 후 한 발 (예전 구르기 대체, EnemyMoves.OutlawDash)
            if (elite && !busy && act == Act.Move && Time.time >= nextRoll && dist < 16f && Vector3.Angle(Effects.Flat(p.AimDir), -dir) < 10f)
            {
                nextRoll = Time.time + RollCooldown;
                        model.localPosition = Vector3.up * h;
                        float stretch = Mathf.Sin(t * Mathf.PI) * 0.15f;
                        model.localScale = Vector3.Scale(modelScale, new Vector3(1 - stretch * 0.5f, 1 + stretch, 1 - stretch * 0.5f));
                        // 리깅 없는 모델은 공중에서 앞으로 한 바퀴 구름
                        if (!anim) model.localRotation = Quaternion.Euler(360f * t, 0, 0) * modelBaseRot;
                    }
                    if (t < 1f) return;
                    // 착지: 먼지 · 화면 흔들림, 그 자리에서 점멸 시작
                    transform.position = leapTo;
                    if (model) { model.localPosition = Vector3.zero; model.localRotation = modelBaseRot; model.localScale = Vector3.Scale(modelScale, new Vector3(1.2f, 0.75f, 1.2f)); }
                    FxBurst.Spawn(transform.position + Vector3.up * 0.15f, 1.3f, FxBurst.Kind.Dust, FxBurst.MistDust);
                    CameraFollow.Shake(0.08f);
                    act = Act.Fuse;
                    actUntil = Time.time + BomberFuse;
                    AnimBusy(true);
                    Anim("Attack");
                    // 착지 자리에서 예고 원이 작게 시작해 점멸 동안 폭발 반경까지 커짐 → 다 커지는 순간 폭발
                    if (tele) tele.Kill();
                    tele = Telegraph.Ring(transform.position, BomberRadius, BomberFuse, Telegraph.Danger).Grow();
                    return;
                }
            }
            if (busy) return;                          // 모래 폭탄 투척 중
            if (dist > 0.9f) transform.position += dir * Mathf.Min(spd * Time.deltaTime, dist - 0.9f);
            Face(dir);
            BomberPick(p, dir, dist);                  // 도약 자폭 · 모래 폭탄 투척 가중 랜덤 (EnemyMoves)
        }

        void Explode(PlayerController p)
        {

        bool watching;
        /// <summary>시간에 가둠이 풀릴 때 플레이어 효과(해제 폭발)를 부르도록 등록</summary>
        public void WatchTimeLock(PlayerController p)
        {
            if (watching) return;
            watching = true;
            health.OnTimeLockEnd += () => { if (p) p.TimeLockEnded(transform.position); };
        }

        void Die(Health h)
        {
            if (dead) return;
            dead = true;
            if (tele) tele.Kill();
            bool blew = kind == Kind.Bomber && selfDestruct;
            if (blew) GunkataFx.Explosion(transform.position, BomberRadius, true);   // 3D 자폭 폭발 (모래 먼지 · 파편)
            if (Mathf.Approximately(health.lastDamageWasDelayed, Time.time)) PlayerController.Instance?.DelayedKill(transform.position);
            // 사망: 이미지 폭발 대신 몸이 검게 굳어 검은 안개로 흩어지며 사라짐 (DeathMist)
            Sfx.Play("enemy_die", kind == Kind.Boss ? 1f : 0.65f, kind == Kind.Boss ? 0f : 0.1f, 3);
            if (!blew)
            {
                // 거울 고양이: 검은 안개 대신 조각상처럼 유리로 산산조각 (2026-11-20 사용자)
                if (model && GetComponent<Ch5MidBoss>()) { GlassShatter.Play(model, 28, 1f); model = null; }
                else if (model) { DeathMist.Play(model, kind == Kind.Boss ? 1.6f : 1f); model = null; }
            }
        }

        void Update()
        {
            if (!owner) { Destroy(gameObject); return; }
            var c = owner.position;
            ang += 38f * Time.deltaTime;
            for (int i = 0; i < orbit.Count; i++)
            {
                float a = (ang + i * 360f / Mathf.Max(1, orbit.Count)) * Mathf.Deg2Rad;
                orbit[i].position = c + new Vector3(Mathf.Sin(a) * 4.2f, 3.2f + Mathf.Sin(Time.time * 1.6f + i) * 0.6f, Mathf.Cos(a) * 4.2f);
                orbit[i].Rotate(25f * Time.deltaTime, 60f * Time.deltaTime, 0, Space.Self);
            }
            // 발밑 고리 2겹 (계속 유지: 끝나면 다시)
            if (!ring1) ring1 = StylizedFx.Spawn("ring", c + Vector3.up * 0.05f, Quaternion.identity, Vector3.one * 3.6f, Vector3.one * 3.6f, 0.5f, StylizedFx.Void.With(scroll: new Vector2(-0.4f, 0)), 18f, 9999f, 0.32f);
            if (!ring2) ring2 = StylizedFx.Spawn("ring", c + Vector3.up * 0.07f, Quaternion.identity, Vector3.one * 2.4f, Vector3.one * 2.4f, 0.5f, StylizedFx.Magenta.With(scroll: new Vector2(0.6f, 0), pattern: 1, scale: new Vector2(10, 1.5f)), -30f, 9999f, 0.38f);
            if (ring1) ring1.transform.position = c + Vector3.up * 0.05f;
            if (ring2) ring2.transform.position = c + Vector3.up * 0.07f;
            if (Time.time >= nextSwirl)
            {
                nextSwirl = Time.time + 3f;
                StylizedFx.Spawn("swirl", c, Quaternion.Euler(0, Random.Range(0f, 360f), 0), new Vector3(2.2f, 3f, 2.2f), new Vector3(3f, 6.5f, 3f), 1.6f, StylizedFx.Void.With(scroll: new Vector2(-1.2f, 0)), 160f, 0f, 0.45f);
            }
        }

        void OnDestroy() { if (ring1) Destroy(ring1.gameObject); if (ring2) Destroy(ring2.gameObject); }
    }

    /// <summary>남은 시간 되찾기 모래시계 (1 · 2페이즈, 20초마다 2개): 고양이가 1.4m 안에 오면 +20초</summary>
            var s = StylizedFx.Spawn("ring", at + Vector3.up * 0.03f, Quaternion.identity, Vector3.one, Vector3.one, 999f, StylizedFx.Void.With(scale: new Vector2(6f, 1.5f), scroll: new Vector2(1f, 0)), 0f, 999f, 0.35f);
            if (w) { v.wall = w.transform; w.enabled = false; v.wallR = w.GetComponent<Renderer>(); }
            if (s) { v.smoke = s.transform; s.enabled = false; v.smokeR = s.GetComponent<Renderer>(); }
            v.mpb = new MaterialPropertyBlock();
        }

        void Update()
        {
            r += speed * Time.deltaTime;
            float k = Mathf.Clamp01(r / maxR);
            if (wall) { wall.localScale = new Vector3(r, 1.1f * (1 - k * 0.5f), r); wall.Rotate(0, 40f * Time.deltaTime, 0); }
            if (smoke) smoke.localScale = Vector3.one * r;
            // 끝으로 갈수록 구멍이 뚫리며 흩어짐
            foreach (var rr in new[] { wallR, smokeR })
            {
                if (!rr) continue;
                rr.GetPropertyBlock(mpb);
                mpb.SetFloat("_Age", Mathf.Lerp(0.12f, 0.95f, k * k));
                rr.SetPropertyBlock(mpb);
            }
            var p = PlayerController.Instance;
            if (!hit && dmg > 0 && p && p.health.Alive)
            {
                float d = Effects.Flat(p.transform.position - transform.position).magnitude;
                if (Mathf.Abs(d - r) <= width * 0.5f) { hit = true; p.health.TakeDamage(dmg); }
            }
            if (r >= maxR) { if (wall) Destroy(wall.gameObject); if (smoke) Destroy(smoke.gameObject); Destroy(gameObject); }
        }
    }
