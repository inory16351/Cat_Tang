+def protect(obj):
+    """Keep small grain fragments and sculpted flow details through decimation."""
+    group = obj.vertex_groups.get('Protected_mineral_strata')
+    if group is None:
+        group = obj.vertex_groups.new(name='Protected_mineral_strata')
