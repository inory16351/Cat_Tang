+    for x in (-2.65, -1.10, 1.10, 2.65):
+        cylinder((x, 0, 3.76), .26, .14, 'iron', n=12,
+                 rot=(0, math.pi / 2, 0), bevel=False)
+    rod((.40, 0, 3.76), (.40, .22, 3.95), .09, 'brass')
+    for loc, size in [((.50, .24, 4.00), (.45, .42, .29)),
