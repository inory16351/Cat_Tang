+        box((side * 2.60, 0, 2.36), (.60, 10.4, .16), 'roof_tin')
+        box((side * 2.33, 0, 2.24), (.055, 10.4, .18), 'paint_cream', False)
+        for y in (-3.75, -1.25, 1.25, 3.75):
+            box((side * 2.60, y, .64), (.055, 2.4, .09), 'iron')
+    lamp(-2.60, .70, 2.28)
+    for loc, size in [((2.58, -1.25, 1.33), (.38, .80, .40)),
+                      ((2.58, -.83, 1.48), (.45, .72, .46)),
