+        obj = extrude([(-.025, 1.3 - length / 2), (.027, 1.3 - length * .16),
+                       (.014, 1.3 + length / 2), (-.022, 1.3 + length * .22)],
+                      -.022 + i * .008, -.014 + i * .008, mat, bevel=False)
+        obj.name = f'Splinter_{i}'
