+                        beam((x - .07, .168, mid), (x, .168, mid + .075), .035, .012, 'wood_dark', False)
+                        beam((x + .07, .168, mid), (x, .168, mid + .075), .035, .012, 'wood_dark', False)
+                piece(start, index)
+                index += 1
+
+
+def gate_barrier():
+    for i in range(12):
+        start = len(PARTS)
+        w = 4.6 / 12
+        x = -2.3 + (i + .5) * w
+        box((x, 0, 1.22), (.09, .17, 2.44), 'iron')
