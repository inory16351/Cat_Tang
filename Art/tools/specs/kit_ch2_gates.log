+             rot=(0, math.pi / 2, 0), bevel=False)
+    for a in (0, math.pi / 2):
+        rod((x - side * .07, y - .14 * math.cos(a), z - .14 * math.sin(a)),
+            (x - side * .07, y + .14 * math.cos(a), z + .14 * math.sin(a)), .025, 'brass')
