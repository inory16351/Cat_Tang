+    'brass': (.86, .59, .20), 'rail_steel': (.50, .63, .68),
+    'brick': (.51, .235, .16), 'brick_dark': (.30, .13, .10),
+    'stone': (.48, .49, .46), 'stone_dark': (.27, .30, .29),
