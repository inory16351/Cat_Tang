+    for side in (-1, 1):
+        box((side * 2.15, 0, .033), (.16, 10.4, .025), 'paint_cream', False)
+        box((side * 2.60, 0, .13), (.60, 10.4, .26), 'stone_dark')
+        # Low parapet remains open; the canopy is confined to X=2.3..2.9.
+        for y in (-5.0, -2.5, 0, 2.5, 5.0):
