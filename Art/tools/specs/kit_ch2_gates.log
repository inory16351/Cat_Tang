+        PARTS = []
+        gates[stage]()
+        debris(['wood', 'iron', 'paint_green', 'iron'][stage])
+        finish(f'Gate_S{stage + 1}', PARTS[:], 6000)
+        for kind, build, budget in [('Corridor', corridors[stage], 7000),
