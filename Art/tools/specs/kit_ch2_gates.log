+def corridor_coach():
+    floor('wood_dark')
+    for i in range(26):
+        box((0, -5 + i * .4, .04), (4.59, .38, .04),
+            'wood' if i % 3 else 'wood_light', False)
+    box((0, 0, .066), (1.42, 10.4, .024), 'cloth_red', False)
+    for x in (-.66, .66):
+        box((x, 0, .079), (.035, 10.4, .002), 'brass', False)
