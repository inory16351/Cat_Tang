+    cylinder((0, .43, 3.65), .27, .20, 'brass', n=16, rot=(math.pi / 2, 0, 0))
+    rod((0, .50, 3.47), (0, .50, 3.23), .045, 'iron_dark')
+    tube([(0, .50, 3.25), (-.13, .50, 3.14), (-.10, .50, 3.02),
+          (.06, .50, 2.98), (.18, .50, 3.10)], .06, 'iron')
