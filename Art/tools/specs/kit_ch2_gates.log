+        box((x, 0, .12), (.90, 1.10, .24), 'iron_dark')
+        for xx in (side * 2.38, side * 3.12):
+            for y in (-.36, .36):
+                box((xx, y, 1.77), (.13, .13, 3.30), 'iron')
+        for y in (-.36, .36):
+            for i in range(3):
+                a, b = (side * 2.42, side * 3.08)
+                if i % 2:
+                    a, b = b, a
+                beam((a, y, .25 + i * 1.03), (b, y, 1.28 + i * 1.03),
+                     .10, .10, 'iron')
+        box((x, 0, 3.38), (.98, 1.0, .20), 'iron_dark')
+    box((0, 0, 3.57), (6.48, .80, .30), 'iron')
+    for z in (3.41, 3.73):
+        box((0, 0, z), (6.55, .92, .085), 'iron_dark')
+    cylinder((0, .28, 3.65), .27, .20, 'brass', n=16, rot=(math.pi / 2, 0, 0))
+    rod((0, .32, 3.47), (0, .32, 3.23), .045, 'iron_dark')
+    tube([(0, .32, 3.25), (-.13, .32, 3.14), (-.10, .32, 3.02),
+          (.06, .32, 2.98), (.18, .32, 3.10)], .06, 'iron')
