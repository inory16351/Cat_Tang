+            src = line * 450 * 4
+            sheet[dst:dst + 1800] = pixels[src:src + 1800]
+        bpy.data.objects.remove(text_obj, do_unlink=True)
+        bpy.data.curves.remove(curve)
+        for obj in objects:
+            obj.hide_render = True
