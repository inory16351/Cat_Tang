import bpy, runpy
from pathlib import Path
spec = runpy.run_path('Art/tools/blender_kit_ch2_gates.py', run_name='audit_only')
root = Path('Game/Assets/Art/Characters/Ch2')
names = [f'{kind}_S{s}' for s in range(1, 5) for kind in ('Gate', 'Corridor', 'Portal')] + ['RewardDoor']
for name in names:
    bpy.ops.wm.read_factory_settings(use_empty=True)
    bpy.ops.import_scene.fbx(filepath=str((root / ('Kit_' + name + '.fbx')).resolve()))
    objects = list(bpy.context.scene.objects)
    assert all(o.type == 'MESH' and o.parent is None for o in objects), name
    if name.startswith('Gate'):
        pieces = sorted(o.name for o in objects if o.name.startswith('Piece_'))
        assert 10 <= len(pieces) <= 24 and pieces == [f'Piece_{i:02d}' for i in range(len(pieces))], (name, pieces)
        assert sorted(o.name for o in objects if o.name.startswith('Splinter_')) == ['Splinter_0', 'Splinter_1', 'Splinter_2']
        assert len(objects) == len(pieces) + 3
    elif name == 'RewardDoor':
        assert sorted(o.name for o in objects) == ['Frame', 'Leaf_L', 'Leaf_R']
        assert abs(bpy.data.objects['Leaf_L'].location.x + 1.125) < .0001
        assert abs(bpy.data.objects['Leaf_R'].location.x - 1.125) < .0001
    else:
        assert len(objects) == 1 and objects[0].name == name
    for mat in bpy.data.materials:
        assert mat.name in spec['COLORS'], (name, mat.name)
        assert all(abs(c - .5) < .0001 for c in mat.diffuse_color[:3]), (name, mat.name, tuple(mat.diffuse_color))
        shader = mat.node_tree.nodes.get('Principled BSDF')
        assert all(abs(c - .5) < .0001 for c in shader.inputs['Base Color'].default_value[:3]), (name, mat.name)
        assert not any(n.type == 'TEX_IMAGE' for n in mat.node_tree.nodes)
    triangle_count = sum(spec['tris'](o) for o in objects)
    budget = 6000 if name.startswith('Gate') else 7000 if name.startswith('Corridor') else 5000 if name == 'RewardDoor' else 4000
    assert triangle_count <= budget, (name, triangle_count)
    print('AUDITED', name, len(objects), triangle_count)
