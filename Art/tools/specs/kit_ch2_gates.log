+def join_since(start, name=None):
+    objects = PARTS[start:]
+    for obj in objects:
+        activate(obj)
+        for mod in list(obj.modifiers):
+            bpy.ops.object.modifier_apply(modifier=mod.name)
+    activate(objects[0])
+    for obj in objects:
+        obj.select_set(True)
+    if len(objects) > 1:
+        bpy.ops.object.join()
+    obj = bpy.context.object
+    if name:
+        obj.name = name
+    PARTS[start:] = [obj]
+    return obj
+
+
+def piece(start, index):
+    return join_since(start, f'Piece_{index:02d}')
