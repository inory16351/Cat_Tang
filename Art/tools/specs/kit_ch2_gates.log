+        box((x, 0, 1.47), (1.0, .95, 2.94), 'brick_dark', False)
+        for i in range(7):
+            box((x, .015 if i % 2 else -.015, .22 + i * .40),
+                (.98, .95, .36), 'brick' if i % 3 else 'brick_dark', False)
+        for z in (.14, 2.88):
