+                extrude(lower + list(reversed(upper)), -.15, .105,
+                        'wood' if (col + row) % 2 else 'wood_light', seams)
+                mid = z0 + (j + .5) * 1.3 / 3
+                for x in (x0 + .065, x1 - .065):
