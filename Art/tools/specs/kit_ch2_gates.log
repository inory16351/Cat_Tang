+
+def jagged(x0, x1, z, seed):
+    rng = random.Random(seed)
+    return [(x0, z), (x0 + (x1 - x0) * .26, z + rng.uniform(.035, .065)),
+            (x0 + (x1 - x0) * .43, z - .055),
+            (x0 + (x1 - x0) * .65, z + .045), (x1, z)]
