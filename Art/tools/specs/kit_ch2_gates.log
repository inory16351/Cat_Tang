+             for z in (-depth / 2, depth / 2) for i in range(n)]
+    faces = [tuple(reversed(range(n))), tuple(range(n, 2 * n))]
+    faces += [(i, (i + 1) % n, (i + 1) % n + n, i + n) for i in range(n)]
+    return transform(mesh(mat, verts, faces, mat, bevel), loc, rot)
