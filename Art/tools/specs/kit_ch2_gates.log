+def box(loc, size, mat, bevel=True, rot=(0, 0, 0)):
+    x, y, z = (s / 2 for s in size)
+    return transform(mesh(mat, [(-x, -y, -z), (x, -y, -z), (x, y, -z), (-x, y, -z),
