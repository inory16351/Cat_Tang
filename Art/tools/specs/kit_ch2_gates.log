+def corridor_shed():
+    floor('stone_dark')
+    for row in range(20):
+        for col in range(7):
+            x = -1.93 + col * .64
+            box((x, -4.94 + row * .52, .043), (.60, .48, .042),
+                'stone' if (row + col) % 4 else 'stone_dark', False)
+    box((1.83, 0, .068), (.30, 10.4, .022), 'soot', False)
+    for side in (-1, 1):
+        box((side * 2.60, 0, 1.0), (.60, 10.4, 2.0), 'brick_dark', False)
+        for row in range(5):
+            for col in range(10):
+                y = -4.68 + col * 1.04 + (.20 if row % 2 else 0)
+                if y + .49 <= 5.2:
+                    box((side * 2.60, y, .21 + row * .39), (.60, .98, .35),
+                        'brick' if (row + col) % 4 else 'brick_dark', False)
+        for y in (-4.8, -2.4, 0, 2.4, 4.8):
+            box((side * 2.60, y, 1.12), (.60, .22, 2.24), 'brick_dark')
+        for z in (.71, 1.65):
+            rod((side * 2.41, -5.2, z), (side * 2.41, 5.2, z), .085, 'iron_dark', n=10)
+            for y in (-3.8, 0, 3.8):
+                cylinder((side * 2.41, y, z), .12, .10, 'iron', n=10,
+                         rot=(math.pi / 2, 0, 0), bevel=False)
+        valve(side, .8, 1.65)
+        for y in (-2.8, 2.9):
+            for j in range(3):
+                box((side * 2.295, y + j * .17, 1.48 + j * .14),
+                    (.012, .14, .80 - j * .12), 'soot', False)
+    rod((-2.41, -1.5, 1.65), (-2.37, -1.5, 2.10), .07, 'iron_dark')
+    for j in range(3):
+        puff((-2.55, -1.5 + j * .16, 2.14 + j * .045), (.41, .34 + j * .12, .27))
