+def lamp(x, y, top):
+    rod((x, y, top), (x, y, top - .25), .025, 'iron_dark')
+    box((x, y, top - .44), (.24, .24, .34), 'glass_lamp')
+    for dx in (-.13, .13):
+        for dy in (-.13, .13):
+            rod((x + dx, y + dy, top - .61), (x + dx, y + dy, top - .27), .02, 'iron_dark')
+    for z in (top - .63, top - .25):
+        box((x, y, z), (.34, .34, .065), 'iron_dark')
