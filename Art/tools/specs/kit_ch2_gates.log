+def reward():
+    start = len(PARTS)
+    for side in (-1, 1):
+        x = side * 1.31
+        box((x, 0, .10), (.38, .50, .20), 'iron_dark')
+        box((x, 0, 1.39), (.24, .32, 2.58), 'iron')
+        for z in (.29, 2.52):
