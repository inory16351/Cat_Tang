    suitcase((-.20, -.04, .72), (1.26, .70, .40), 'leather_dark', rot=(0, 0, .07))
    suitcase((.47, .29, 1.115), (.86, .65, .36), 'leather',
             rot=(0, math.radians(-16), math.radians(-12)))
