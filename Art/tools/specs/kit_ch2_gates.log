+        box((x, 0, 2.13), (.60, 10.4, .38), 'wood_dark')
+        for y in (-4.5, -3, -1.5, 0, 1.5, 3, 4.5):
+            box((x, y, 1.50), (.60, .20, .98), 'wood_dark')
+        for i, y in enumerate((-3.75, -2.25, -.75, .75, 2.25, 3.75)):
