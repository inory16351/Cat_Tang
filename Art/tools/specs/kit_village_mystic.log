+              'cactus_dark',n=6).transform((x,y,z))
+        lump('Round luminous dream bulb',(x,y,z+.17),(.44,.43,.49),
+             'petal_glow' if j % 2 else 'crystal_core',2)
+        leaf('Sapling folded leaf',(x*.7,y*.7,z-.23),(x*1.3+.13,y*1.2,z-.10),
+             .21,'cactus_dark')
