        extrude('Chunky sun ray',[(p.x,2.85+p.y) for p in pts],.22,
                'gold' if i % 2 == 0 else 'rose_gold')
        cylinder('Rim jewel gold setting',(1.95*u.x,.32,2.85+1.95*u.y),
                 .13,.07,'gold',n=8,rot=(math.pi/2,0,0))
