+    if paper:
+        tube('Short ceremonial tassel',[(0,0,-r*1.20),(0,0,-r*1.62)],.035,'iron',n=5)
+        lump('Luminous tassel weight',(0,0,-r*1.67),(.10,.10,.15),'lantern_glow')
