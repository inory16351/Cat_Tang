import bpy, runpy
from mathutils import Vector
kit = runpy.run_path('Art/tools/blender_kit_village_mystic.py')
for name, dims, centered, budget, build in kit['SPECS']:
    bpy.ops.wm.read_factory_settings(use_empty=True)
    path = kit['OUTPUT'] / ('Kit_V_' + name + '.fbx')
    bpy.ops.import_scene.fbx(filepath=str(path), use_anim=False)
    objects = list(bpy.context.scene.objects)
    assert len(objects) == 1 and objects[0].type == 'MESH', (name, objects)
    obj = objects[0]
    assert obj.name == name, (name, obj.name)
    coords = [obj.matrix_world @ v.co for v in obj.data.vertices]
    lo = Vector(tuple(min(v[i] for v in coords) for i in range(3)))
    hi = Vector(tuple(max(v[i] for v in coords) for i in range(3)))
    assert all(abs((hi-lo)[i]-dims[i]) < 1e-4 for i in range(3)), (name, hi-lo)
    assert abs(lo.x+hi.x) < 1e-4 and abs(lo.y+hi.y) < 1e-4, name
    assert abs(lo.z+hi.z if centered else lo.z) < 1e-4, (name, lo, hi)
    assert obj.matrix_world.translation.length < 1e-5, name
    obj.data.calc_loop_triangles()
    assert len(obj.data.loop_triangles) <= budget, name
    roles = {mat.name for mat in obj.data.materials}
    assert len(roles) >= 5 and roles <= set(kit['ROLES']), (name, roles)
    for mat in obj.data.materials:
        shader = next(n for n in mat.node_tree.nodes if n.type == 'BSDF_PRINCIPLED')
        assert all(abs(c-.5) < 1e-5 for c in shader.inputs['Base Color'].default_value[:3]), (name, mat.name)
        assert shader.inputs['Emission Strength'].default_value == 0, mat.name
        assert not any(n.type == 'TEX_IMAGE' for n in mat.node_tree.nodes), mat.name
    print('VERIFIED', name, len(obj.data.loop_triangles), tuple(round(v,3) for v in hi-lo), len(roles), flush=True)
print('ALL EIGHT FBXS VERIFIED', flush=True)
