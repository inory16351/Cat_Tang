+        tube('Mineral island dangling root',[(.95*math.cos(a),.95*math.sin(a),.08),
+             (.98*math.cos(a),.98*math.sin(a),-.49),
+             (.70*math.cos(a),.70*math.sin(a),-.93)], [.065,.045,.025],
