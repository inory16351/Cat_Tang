+              (.23,r*.58),(.27,r*.13)],'crystal_blue',n=10).transform((x,y,z))
+        lathe('Luminous mushroom underside',[(0,r*.90),(.045,r*.94)],
+              'crystal_core',n=10).transform((x,y,z-.028))
+        for k in range(5):
+            a = k*TAU/5
