    for z,r,role,angle in ((-.43,1.10,'brass',.04),(0,.84,'gold',.19),(.43,.64,'rust',-.14)):
        gear((0,0,z),r,.16,role,teeth=16,broken=(3,10),rot=(math.pi/2,0,angle))
