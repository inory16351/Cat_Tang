+def float_rock_crystal():
+    n = 10
+    verts = []
+    # Flat organic top over a faceted, tapered underside. No filler pedestal.
+    rings = [(-1.62,.12),(-1.12,.53),(-.50,1.02),(.04,1.35),(.21,1.25)]
+    radial = [1+random.uniform(-.09,.09) for _ in range(n)]
+    for z,r in rings:
+        for j in range(n):
+            a = j*TAU/n
+            verts.append((r*radial[j]*math.cos(a),r*radial[j]*math.sin(a),
+                          z+(.035*math.sin(j*2) if z < .2 else 0)))
+    faces = [tuple(reversed(range(n)))]
+    roles = ['rock_dark']
+    for k in range(len(rings)-1):
+        for j in range(n):
+            faces.append((k*n+j,k*n+(j+1) % n,(k+1)*n+(j+1) % n,(k+1)*n+j))
+            roles.append('earth' if k == 3 else ('rock_dark' if (j+k) % 3 == 0 else 'rock'))
+    faces.append(tuple(range(4*n,5*n)))
+    roles.append('earth')
+    Part('Inverted floating island cone',verts,faces,'rock',bevel=True,face_roles=roles)
+    for j in range(5):
+        a = j*TAU/5
+        lump('Flat island moss patch',(.63*math.cos(a),.63*math.sin(a),.24),
+             (.97,.86,.14),'cactus' if j % 2 else 'cactus_dark')
+    sapling((-.11,-.06,.28),.57)
+    for j in range(7):
+        a = j*TAU/7+.17
+        r = .65+.17*(j % 2)
+        p = Vector((r*math.cos(a),r*math.sin(a),-.43))
+        crystal('Underside hanging crystal stalactite',p,
+                p+Vector((.14*math.cos(a),.14*math.sin(a),-.59-.17*(j % 3))),
