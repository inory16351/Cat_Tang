+    beam('Frozen minute',(x,y+.14,z),(x-radius*.35,y+.14,z+radius*.48),.045,.045,'iron')
+    beam('Frozen hour',(x,y+.15,z),(x+radius*.44,y+.15,z+.035),.05,.045,'iron')
