     for(int i=0;i<16;i++)using(var a=new Bitmap(Path.Combine(dir,"bk_"+set+"_"+i+".png")))using(var b=new Bitmap(Path.Combine(dir,"bk_"+set+"_"+((i+1)%16)+".png"))){
      double d=Delta(a,b);max=Math.Max(d,max);if(i==15)seam=d;
     }
     Console.WriteLine("  Loop seam mean pixel delta="+seam.ToString("F3")+"; maximum adjacent delta="+max.ToString("F3"));
    }
   }
