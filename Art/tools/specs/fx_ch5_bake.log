  using(var bg1=new SolidBrush(Color.FromArgb(62,59,72)))
  using(var bg2=new SolidBrush(Color.FromArgb(75,72,85))) {
   g.Clear(Color.FromArgb(23,21,30));int total=0;
   for(int row=0;row<sets.Length;row++) {
    string set=sets[row];int count=set==\"c5strip\"?1:16,margin=256,empty=0;long pink=0,gold=0;
    g.DrawString(set,font,white,4,row*180+75);
    for(int f=0;f<count;f++) {
     string p=Path.Combine(root,\"Game/Assets/Resources/FX/anim/bk_\"+set+\"_\"+f+\".png\");
