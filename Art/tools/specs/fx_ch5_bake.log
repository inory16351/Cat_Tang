     using(var im=new Bitmap(p)) {
      if(im.Width!=256||im.Height!=256||!Image.IsAlphaPixelFormat(im.PixelFormat))throw new Exception("Wrong size/alpha: "+p);
      int minx=256,miny=256,maxx=-1,maxy=-1,transparent=0;
      for(int y=0;y<256;y++)for(int x=0;x<256;x++) {
       Color c=im.GetPixel(x,y);if(c.A==0)transparent++;
       if(c.A>0){minx=Math.Min(x,minx);miny=Math.Min(y,miny);maxx=Math.Max(x,maxx);maxy=Math.Max(y,maxy);}
       if(c.A>128&&c.R>200&&c.B>125&&c.R-c.G>65)pink++;
       if(c.A>128&&c.R>200&&c.G>130&&c.B<175&&c.R-c.B>60)gold++;
      }
      if(transparent==0)throw new Exception("No transparent background: "+p);
      if(maxx<0){empty++;if(!((set=="c5spark"||set=="c5rift")&&f==15))throw new Exception("Unexpected invisible frame: "+p);}
      else{int m=Math.Min(Math.Min(minx,miny),Math.Min(255-maxx,255-maxy));margin=Math.Min(margin,m);if(m<3)throw new Exception("Clipped: "+p);}
      int ox=100+f*144,oy=row*180+24;
      for(int cy=0;cy<144;cy+=12)for(int cx=0;cx<144;cx+=12)g.FillRectangle(((cx/12+cy/12)%2==0)?bg1:bg2,ox+cx,oy+cy,12,12);
      g.DrawImage(im,new Rectangle(ox,oy,144,144));g.DrawString(f.ToString("00"),font,white,ox,row*180+3);total++;
     }
    }
    if(pink==0)throw new Exception("Missing magenta: "+set);
    Console.WriteLine(set+": "+count+" RGBA 256x256 PNGs; edge margin >= "+margin+" px; empty="+empty+"; magenta pixels="+pink+"; gold pixels="+gold);
    if(row<2){
     string dir=Path.Combine(root,"Game/Assets/Resources/FX/anim");
