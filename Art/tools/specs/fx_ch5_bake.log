  using(var bg1=new SolidBrush(Color.FromArgb(62,59,72)))
  using(var bg2=new SolidBrush(Color.FromArgb(75,72,85))) {
   g.Clear(Color.FromArgb(23,21,30));
   int total=0;
   for(int row=0;row<sets.Length;row++) {
    string set=sets[row]; int count=set==\"c5strip\"?1:16; int margin=256; int empty=0;
    g.DrawString(set,font,white,4,row*180+75);
    for(int f=0;f<count;f++) {
     string p=Path.Combine(root,\"Game/Assets/Resources/FX/anim/bk_\"+set+\"_\"+f+\".png\");
     if("'!File.Exists(p)) throw new Exception("Missing: "+p);
     using(var im=new Bitmap(p)) {
      if(im.Width!=256||im.Height!=256||!Image.IsAlphaPixelFormat(im.PixelFormat)) throw new Exception("Wrong size/alpha: "+p);
      int minx=256,miny=256,maxx=-1,maxy=-1,transparent=0;
      for(int y=0;y<256;y++) for(int x=0;x<256;x++) {
       var c=im.GetPixel(x,y); if(c.A==0)transparent++;
       if(c.A>0){minx=Math.Min(x,minx);miny=Math.Min(y,miny);maxx=Math.Max(x,maxx);maxy=Math.Max(y,maxy);}
      }
      if(transparent==0)throw new Exception("No transparent background: "+p);
      if(maxx<0) {empty++; if(!((set=="c5spark"||set=="c5rift")&&f==15))throw new Exception("Unexpected invisible frame: "+p);}
      else {int m=Math.Min(Math.Min(minx,miny),Math.Min(255-maxx,255-maxy));margin=Math.Min(margin,m);if(m<3)throw new Exception("Clipped/edge risk: "+p+" margin="+m);}
      int ox=100+f*144,oy=row*180+24;
      for(int cy=0;cy<144;cy+=12)for(int cx=0;cx<144;cx+=12)g.FillRectangle(((cx/12+cy/12)%2==0)?bg1:bg2,ox+cx,oy+cy,12,12);
      g.DrawImage(im,new Rectangle(ox,oy,144,144));
      g.DrawString(f.ToString("00"),font,white,ox,row*180+3);
      total++;
     }
    }
    Console.WriteLine(set+": "+count+" RGBA 256x256 PNGs; min edge margin="+margin+" px; empty="+empty);
   }
   string output=Path.Combine(root,"Art/tools/specs/fx_ch5_bake_preview.png");
   sheet.Save(output,ImageFormat.Png);
   Console.WriteLine("Checked "+total+" PNGs. Contact sheet: "+output);
  }
 }
}
