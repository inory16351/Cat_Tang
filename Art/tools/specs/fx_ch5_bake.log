public static class FxCh5FinalCheck {
 static double Delta(Bitmap a, Bitmap b) {
  double sum=0;
  for(int y=0;y<256;y++)for(int x=0;x<256;x++){
   Color ca=a.GetPixel(x,y),cb=b.GetPixel(x,y);
   sum+=Math.Abs(ca.A-cb.A)+Math.Abs(ca.R*ca.A/255.0-cb.R*cb.A/255.0)+Math.Abs(ca.G*ca.A/255.0-cb.G*cb.A/255.0)+Math.Abs(ca.B*ca.A/255.0-cb.B*cb.A/255.0);
  }
  return sum/(256*256*4);
 }
 public static void Run(string root) {
  string[] sets={\"c5orb\",\"c5shard\",\"c5spark\",\"c5rift\",\"c5strip\"};
  using(var sheet=new Bitmap(2404,900,PixelFormat.Format32bppArgb))
  using(var g=Graphics.FromImage(sheet))
  using(var font=new Font(\"Consolas\",11))
