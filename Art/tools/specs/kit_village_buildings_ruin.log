        rod('Lean-to post brace',(right-.15,y,2.15),(right-.64,y,2.98),.075,'wood_light')
    box('Lean-to roof',(middle,-.35,3.12),(right-left+.18,4.8,.16),
        'roof_shingle',(0,.20,0))
    box('Lean-to fascia',(right,-.35,2.94),(.15,4.8,.22),'rust')
    # Anvil is a solid extruded silhouette including horn, waist and feet.
    ax,ay = 3.32,1.45
    box('Anvil timber block',(ax,ay,.62),(.72,.68,.96),'wood_dark')
    poly = [(-.50,1.12),(.50,1.12),(.35,1.30),(.17,1.37),(.22,1.64),
            (.56,1.70),(.77,1.86),(-.49,1.86),(-.77,1.72),(-.38,1.62),
            (-.19,1.39),(-.25,1.27)]
    extrude('Forge iron anvil',[(ax+x,z) for x,z in poly],.48,'iron',ay)
    qx,qy = 2.73,2.20
    lathe('Quench barrel staves',(qx,qy,.25),[(0,.40),(.15,.46),(.75,.46),(.95,.40)],
          'wood_weathered',12)
    for z in (.40,.92,1.17):
        cylinder('Quench barrel iron hoop',(qx,qy,z),.475,.09,'iron',12)
    cylinder('Quench barrel recessed water',(qx,qy,1.19),.34,.055,'glass',16)
    for i in range(10):
        a = i*TAU/10
        rod('Barrel stave seam',(qx+.45*math.cos(a),qy+.45*math.sin(a),.43),
            (qx+.45*math.cos(a),qy+.45*math.sin(a),1.08),.022,'wood_dark',5)
    chimney(-2.90,b+1.2,4.70,6.6)
    # Large hourglass is safely above the porch and closed barn doors.
    start = len(PARTS)
    hourglass((0,f+.56,5.01),.91)
    # A taller profile keeps both bulbs legible from the steep game camera.
    for obj in PARTS[start:]:
        for v in obj.data.vertices:
            v.co.z = 5.20+(v.co.z-5.01)*1.30
    for x in (-3.25,1.32):
        bullet((x,f+.18,5.67),1.15)
    crate((-2.25,f+.69,.22))
    crate((2.03,f+.69,.22))
    lantern((-1.65,f+.40,2.90),.7)


