+def snapped_plank(label, a, b, width=.23, depth=.15, role='wood_light'):
+    """A capped, chunky splinter; its unbroken end is embedded in a support."""
+    a,b = Vector(a),Vector(b)
+    length = (b-a).length
+    obj = extrude(label,[(-width/2,0),(width/2,0),(width/2,length-.16),
+                        (width*.12,length-.16),(width*.12,length),
+                        (-width*.14,length-.08),(-width/2,length-.08)],
+                  depth,role)
+    obj.data.transform(Matrix.Translation(a) @
+                       (b-a).to_track_quat('Z','Y').to_matrix().to_4x4())
+    return obj
+
+
+def wall_crack(front, x, top, length=.80, labels=('Alternating wall plank',)):
+    """Cut a shallow stepped groove, then put dark wood inside the recess."""
+    poly = [(x-.045,top),(x+.045,top),(x+.045,top-length*.30),
+            (x+.15,top-length*.30),(x+.15,top-length*.59),
+            (x+.065,top-length*.59),(x+.065,top-length),
+            (x-.015,top-length),(x-.015,top-length*.51),
+            (x+.055,top-length*.51),(x+.055,top-length*.39),
+            (x-.045,top-length*.39)]
+    cutter = extrude('Temporary inset crack cutter',poly,.15,'wood_dark',front+.09,False)
+    PARTS.remove(cutter)
+    for obj in list(PARTS):
+        if not any(obj.name.startswith(label) for label in labels):
+            continue
+        lo,hi = bounds(obj)
+        if hi.x<x-.05 or lo.x>x+.16 or hi.z<top-length or lo.z>top:
+            continue
+        if lo.y>front+.16 or hi.y<front-.01:
+            continue
+        bpy.context.view_layer.objects.active = obj
+        mod = obj.modifiers.new('Recessed age crack','BOOLEAN')
+        mod.operation,mod.solver,mod.object = 'DIFFERENCE','EXACT',cutter
+        # Cut before the worn-edge bevel; retain a closed back to the groove.
+        bpy.ops.object.modifier_move_up(modifier=mod.name)
+        bpy.ops.object.modifier_apply(modifier=mod.name)
+    bpy.data.objects.remove(cutter,do_unlink=True)
+    extrude('Dark recessed age crack',poly,.025,'wood_dark',front+.012,False)
+
+
+def corner_top(x, y, width, front, height, cx=0):
+    """Three broad stair steps remove the upper +X / front corner."""
+    dx,dy = cx+width/2-x,front-y
+    if dx < 1.85 and dy < 1.95:
+        loss = (.62 if dx > 1.28 else 1.18 if dx > .65 else 1.85)
+        loss += .22 if dy < .68 else 0
+        return height-loss
+    return height
+
+
