"""One deterministic metre-scale Arena; grey role materials, top-centred origin.

Independent closed slabs are intentional, as in the landmark kit. The preview
uses temporary role colours AFTER export, restoring all shaders afterwards.
"""

import math
import random
from array import array
from fractions import Fraction
from pathlib import Path

import bmesh
import bpy
from mathutils import Euler, Matrix, Vector


ROOT = Path(__file__).resolve().parents[2]
OUTPUT = ROOT / 'Game/Assets/Art/Characters/Ch2/Kit_Arena.fbx'
PREVIEW = ROOT / 'Art/tools/specs/kit_ch2_arena_preview.png'
ROLES = set('stone stone_dark wood wood_dark iron iron_dark rail_steel brass'.split())
MATERIALS = {}
PARTS = []
SERIAL = 0
TAU = math.tau


def setup_materials():
    for name in sorted(ROLES):
        mat = bpy.data.materials.new(name)
        mat.use_nodes = True
        mat.diffuse_color = (.5, .5, .5, 1)
        shader = mat.node_tree.nodes['Principled BSDF']
        shader.inputs['Base Color'].default_value = (.5, .5, .5, 1)
        shader.inputs['Roughness'].default_value = .85
        shader.inputs['Metallic'].default_value = 0
        MATERIALS[name] = mat


def mesh(label, verts, faces, role, bevel=False):
    global SERIAL
    assert role in ROLES
    SERIAL += 1
    data = bpy.data.meshes.new(f'{label}_{SERIAL}')
    data.from_pydata(verts, [], faces)
    data.update()
    obj = bpy.data.objects.new(data.name, data)
    bpy.context.collection.objects.link(obj)
    data.materials.append(MATERIALS[role])
    if bevel:
        # Same 25 mm, two-segment upper-perimeter bevel as the landmark kit.
        # Reserve it for the exposed plates and hub; repeated thin inlays and
        # wedge seams retain their hand-authored topology to meet the budget.
        mod = obj.modifiers.new('Chunky softened edges 25mm', 'BEVEL')
        mod.width = .025
        mod.segments = 2
        mod.affect = 'EDGES'
        mod.use_clamp_overlap = True
        mod.limit_method = 'WEIGHT'
        weights = data.attributes.new('bevel_weight_edge', 'FLOAT', 'EDGE')
        top = max(v.co.z for v in data.vertices)
        for edge in data.edges:
            if all(abs(data.vertices[i].co.z - top) < 1e-5 for i in edge.vertices):
                weights.data[edge.index].value = 1
    PARTS.append(obj)
    return obj


def slab(label, outline, bottom, top, role, bevel=False):
    n = len(outline)
    verts = [(x, y, z) for z in (bottom, top) for x, y in outline]
    faces = [tuple(reversed(range(n))), tuple(range(n, 2 * n))]
    faces += [(j, (j + 1) % n, (j + 1) % n + n, j + n) for j in range(n)]
    return mesh(label, verts, faces, role, bevel)


def box(label, loc, size, role, angle=0, bevel=False):
    x, y, z = (s / 2 for s in size)
    obj = slab(label, [(-x, -y), (x, -y), (x, y), (-x, y)], -z, z, role, bevel)
    obj.data.transform(Matrix.Translation(Vector(loc)) @
                       Euler((0, 0, angle)).to_matrix().to_4x4())
    return obj


def polar(radius, angle):
    return (radius * math.cos(angle), radius * math.sin(angle))


def disc(label, radius, bottom, top, role, bevel=False):
    return slab(label, [polar(radius, j * TAU / 24) for j in range(24)],
                bottom, top, role, bevel)


def ring(label, inner, outer, bottom, top, role):
    n = 72
    verts = [(r * math.cos(j * TAU / n), r * math.sin(j * TAU / n), z)
             for r, z in ((inner, bottom), (outer, bottom),
                          (outer, top), (inner, top)) for j in range(n)]
    faces = [(k * n + j, k * n + (j + 1) % n,
              ((k + 1) % 4) * n + (j + 1) % n, ((k + 1) % 4) * n + j)
             for k in range(4) for j in range(n)]
    return mesh(label, verts, faces, role)


def wedge(label, inner, outer, a, b, bottom, top, role, gap=0):
    # Offset the rays by half the gap to keep the coping joints constant-width.
    # Two arc segments per block retain the kit's chunky circular silhouette.
    ai, ao = math.asin(gap / (2 * inner)), math.asin(gap / (2 * outer))
    outer_arc = [polar(outer, a + ao + (b - a - 2 * ao) * j / 2) for j in range(3)]
    inner_arc = [polar(inner, a + ai + (b - a - 2 * ai) * j / 2) for j in range(3)]
    return slab(label, outer_arc + inner_arc[::-1], bottom, top, role)


def difference(obj, cutter):
    bpy.context.view_layer.objects.active = obj
    mod = obj.modifiers.new('Inset without coplanar overlay', 'BOOLEAN')
    mod.operation = 'DIFFERENCE'
    mod.solver = 'EXACT'
    mod.object = cutter
    bpy.ops.object.modifier_apply(modifier=mod.name)


def remove_part(obj):
    PARTS.remove(obj)
    bpy.data.objects.remove(obj, do_unlink=True)


def paving():
    # Shared course boundaries keep the entire floor a closed manifold shell.
    # Counts change only every four courses, keeping economical rectangular
    # setts about 0.9 m tangentially x 0.6 m radially at the outside of a group.
    rng = random.Random(20261118)
    courses = 26
    counts = [16 * (1 + k // 4) for k in range(courses)]
    boundaries = [{Fraction(0)}]
    for k in range(1, courses):
        boundaries.append({Fraction(j, counts[k - 1]) for j in range(counts[k - 1])} |
                          {Fraction(j, counts[k]) for j in range(counts[k])})
    boundaries.append({Fraction(j, counts[-1]) for j in range(counts[-1])})
    verts, faces, roles = [], [], []
    indices = {}

    def vertex(radius, turn, z):
        x, y = polar(radius, float(turn) * TAU)
        key = tuple(round(v, 7) for v in (x, y, z))
        if key not in indices:
            indices[key] = len(verts)
            verts.append((x, y, z))
        return indices[key]

    for k, count in enumerate(counts):
        inner, outer = 15.4 * k / courses, 15.4 * (k + 1) / courses
        for j in range(count):
            a, b = Fraction(j, count), Fraction(j + 1, count)
            outer_turns = [a] + sorted(t for t in boundaries[k + 1] if a < t < b) + [b]
            face = [vertex(outer, t % 1, -.08) for t in outer_turns]
            if k:
                inner_turns = [a] + sorted(t for t in boundaries[k] if a < t < b) + [b]
                face += [vertex(inner, t % 1, -.08) for t in reversed(inner_turns)]
            else:
                face.append(vertex(0, 0, -.08))
            faces.append(face)
            roles.append('stone_dark' if rng.random() < 1 / 6 else 'stone')
    outer = sorted(boundaries[-1])
    top = [vertex(15.4, t, -.08) for t in outer]
    bottom = [vertex(15.4, t, -.3) for t in outer]
    faces.append(tuple(reversed(bottom)))
    roles.append('stone')
    for j in range(len(outer)):
        nxt = (j + 1) % len(outer)
        faces.append((bottom[j], bottom[nxt], top[nxt], top[j]))
        roles.append('stone')
    obj = mesh('Concentric laid stone setts', verts, faces, 'stone')
    obj.data.materials.append(MATERIALS['stone_dark'])
    for face, role in zip(obj.data.polygons, roles):
        face.material_index = int(role == 'stone_dark')
    obj['sett_count'] = sum(counts)
    return obj


def deck_surface(start, stop, angle, rng):
    # One continuous solid deck with face-assigned flush rail heads and plates.
    # This keeps the exact top at Z=0 without overlapping coplanar surfaces.
    # Planks are .45 m along the deck, with .04 m dark inset seams. They span
    # the deck transversely. Plates span under both rails every 1.2 m.
    edges = {start, stop}
    for j in range(64):
        a = -15.5 + j * .49
        for x in (a, min(a + .45, 15.5)):
            if start < x < stop:
                edges.add(round(x, 6))
    plate_centres = [j * 1.2 for j in range(-12, 13)]
    for centre in plate_centres:
        for x in (centre - .10, centre + .10):
            if start < x < stop:
                edges.add(round(x, 6))
    xs = sorted(edges)
    ys = [-1.42, -.81, -.69, .69, .81, 1.42]
    stride = len(ys)
    verts = [(x, y, 0) for x in xs for y in ys]
    faces, roles = [], []
    boards = ['wood_dark' if rng.random() < .7 else 'wood' for j in range(64)]
    for i in range(len(xs) - 1):
        x = (xs[i] + xs[i + 1]) / 2
        board = min(63, int((x + 15.5) / .49))
        seam = (x + 15.5) - board * .49 > .45
        plate = any(abs(x - centre) < .100001 for centre in plate_centres)
        for j in range(stride - 1):
            a, b = i * stride + j, (i + 1) * stride + j
            faces.append((a, b, b + 1, a + 1))
            role = 'wood_dark' if seam else boards[board]
            if plate:
                role = 'iron_dark'
            if j in (1, 3):
                role = 'rail_steel'
            roles.append(role)
    # Reuse all boundary vertices on the walls and bottom, with no T-junctions.
    perimeter = ([i * stride for i in range(len(xs))] +
                 [(len(xs) - 1) * stride + j for j in range(1, stride)] +
                 [i * stride + stride - 1 for i in reversed(range(len(xs) - 1))] +
                 list(reversed(range(1, stride - 1))))
    bottom = []
    for index in perimeter:
        x, y, z = verts[index]
        bottom.append(len(verts))
        verts.append((x, y, -.075))
    faces.append(tuple(reversed(bottom)))
    roles.append('wood_dark')
    for i, a in enumerate(perimeter):
        nxt = (i + 1) % len(perimeter)
        faces.append((bottom[i], bottom[nxt], perimeter[nxt], a))
        roles.append('wood_dark')
    obj = mesh('Transverse planks and flush railway hardware', verts, faces, 'wood')
    slots = ['wood'] + sorted(ROLES - {'wood'})
    for name in slots[1:]:
        obj.data.materials.append(MATERIALS[name])
    for face, role in zip(obj.data.polygons, roles):
        face.material_index = slots.index(role)
    obj.data.transform(Matrix.Rotation(angle, 4, 'Z'))
    # Dissolve only coplanar faces with the same material. Rail/plate/plank
    # boundaries survive, while invisible subdivisions inside a role disappear.
    bm = bmesh.new()
    bm.from_mesh(obj.data)
    bm.normal_update()
    bmesh.ops.dissolve_limit(bm, angle_limit=.001, use_dissolve_boundaries=False,
                            verts=list(bm.verts), edges=list(bm.edges),
                            delimit={'MATERIAL'})
    bm.to_mesh(obj.data)
    bm.free()
    return obj


def build():
    rng = random.Random(20261118)
    paving()
    # The middle vertex of each outer arc includes the cardinal extrema.
    rim = []
    for j in range(24):
        a = j * TAU / 24 - TAU / 48
        rim.append(wedge('Stone coping block', 15.4, 16, a, a + TAU / 24,
                         -.3, 0, 'stone', gap=.025))
    # The 31 m decks extend 0.1 m beyond the pit at each end. Seat those ends
    # in the coping, preserving the top-centred origin without z-fighting.
    for angle, indices in ((0, (0, 12)), (math.pi / 2, (6, 18))):
        cutter = box('Temporary coping bridge seat', (0, 0, -.02),
                     (31, 3.2, .12), 'stone', angle)
        for index in indices:
            difference(rim[index], cutter)
        remove_part(cutter)
    for hour in range(12):
        a = math.pi / 2 - hour * TAU / 12
        x, y = polar(15.7, a)
        cutter = box('Temporary stud recess', (x, y, 0), (.35, .35, .05), 'stone', a)
        difference(rim[(6 - hour * 2) % 24], cutter)
        remove_part(cutter)
        box('Inset brass hour stud', (x, y, -.0125), (.35, .35, .025), 'brass', a)

    ring('Outer wheel ring rail', 14.53, 14.67, -.065, -.03, 'rail_steel')
    for j in range(36):
        a = j * TAU / 36
        x, y = polar(14.6, a)
        box('Outer wheel rail base plate', (x, y, -.068), (.34, .46, .020),
            'iron_dark', a)

    start = len(PARTS)
    deck_surface(-15.5, 15.5, 0, rng)
    for lo, hi in ((-15.5, -1.6), (1.6, 15.5)):
        deck_surface(lo, hi, math.pi / 2, rng)
    for angle, intervals in ((0, ((-15.5, 15.5),)),
                             (math.pi / 2, ((-15.5, -1.6), (1.6, 15.5)))):
        c, s = math.cos(angle), math.sin(angle)
        for lo, hi in intervals:
            for offset in (-1.51, 1.51):
                d = (lo + hi) / 2
                box('Iron bridge edge girder', (d * c - offset * s, d * s + offset * c, -.04),
                    (hi - lo, .18, .08), 'iron', angle, bevel=True)
    decks = PARTS[start:]
    cutter = disc('Temporary king-pin socket', 1.8, -.2, .1, 'iron_dark')
    for obj in decks:
        # Apply the kit bevel before cutting the central socket.
        bpy.context.view_layer.objects.active = obj
        for mod in list(obj.modifiers):
            bpy.ops.object.modifier_apply(modifier=mod.name)
        difference(obj, cutter)
    remove_part(cutter)
    disc('Iron king-pin disc', 1.8, -.078, -.012, 'iron_dark')
    # A single closed toothed outline avoids coplanar faces between teeth/cap.
    teeth = []
    for j in range(12):
        for fraction, radius in ((0, .9), (.22, 1.0), (.62, 1.0), (.84, .9)):
            teeth.append(polar(radius, (j + fraction) * TAU / 12))
    slab('Brass king-pin cap with twelve low teeth', teeth, -.012, 0, 'brass')


def triangles(obj):
    obj.data.calc_loop_triangles()
    return len(obj.data.loop_triangles)


def finish():
    bpy.ops.object.select_all(action='DESELECT')
    for obj in PARTS:
        obj.select_set(True)
        bpy.context.view_layer.objects.active = obj
        for mod in list(obj.modifiers):
            bpy.ops.object.modifier_apply(modifier=mod.name)
        obj.select_set(False)
    for obj in PARTS:
        obj.select_set(True)
    bpy.context.view_layer.objects.active = PARTS[0]
    bpy.ops.object.join()
    obj = bpy.context.object
    obj.name = 'Arena'
    obj.data.name = 'Arena_Mesh'
    bm = bmesh.new()
    bm.from_mesh(obj.data)
    bmesh.ops.recalc_face_normals(bm, faces=list(bm.faces))
    assert all(e.is_manifold for e in bm.edges), 'Open/non-manifold slab'
    assert all(f.calc_area() > 1e-10 for f in bm.faces), 'Degenerate face'
    # Lock the same tessellation for the renderer, FBX and Unity importer.
    bmesh.ops.triangulate(bm, faces=list(bm.faces), ngon_method='BEAUTY')
    assert all(e.is_manifold for e in bm.edges), 'Non-manifold triangulation'
    assert all(f.calc_area() > 1e-10 for f in bm.faces), 'Degenerate triangle'
    bm.to_mesh(obj.data)
    bm.free()
    for face in obj.data.polygons:
        face.use_smooth = False
    obj.data.update()
    obj.location = (0, 0, 0)
    obj.rotation_euler = (0, 0, 0)
    obj.scale = (1, 1, 1)
    bpy.context.view_layer.update()
    assert triangles(obj) <= 9000, triangles(obj)
    assert all(abs(obj.dimensions[i] - (32, 32, .3)[i]) < .001 for i in range(3)), tuple(obj.dimensions)
    assert abs(max(v.co.z for v in obj.data.vertices)) < 1e-6
    assert abs(min(v.co.z for v in obj.data.vertices) + .3) < 1e-6
    assert all(math.isfinite(c) for v in obj.data.vertices for c in v.co)
    assert set(m.name for m in obj.data.materials) == ROLES
    obj['dimensions_m'] = [32, 32, .3]
    obj['front'] = '+Y'
    obj['chapter'] = 'The Stopped Station'
    obj['origin_rule'] = 'top center'
    obj['solid_obstacle'] = False
    obj['rail_gauge_m'] = 1.5
    obj['triangle_count'] = triangles(obj)
    obj['design_revision'] = '2026-11-18 railway turntable pit'
    obj['pit_floor_z_m'] = -.08
    obj['ring_rail_radius_m'] = 14.6
    obj['bridge_width_m'] = 3.2
    obj['bridge_length_m'] = 31.0
    obj['rail_head_width_m'] = .12
    return obj


def export(obj):
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    bpy.ops.object.select_all(action='DESELECT')
    obj.select_set(True)
    bpy.context.view_layer.objects.active = obj
    assert len(bpy.context.scene.objects) == 1
    for mat in obj.data.materials:
        assert tuple(mat.node_tree.nodes['Principled BSDF'].inputs['Base Color'].default_value) == (.5, .5, .5, 1)
    bpy.ops.export_scene.fbx(
        filepath=str(OUTPUT), use_selection=True,
        axis_forward='-Z', axis_up='Y', apply_scale_options='FBX_SCALE_UNITS',
        bake_space_transform=True, object_types={'MESH'}, use_mesh_modifiers=True,
        mesh_smooth_type='FACE', add_leaf_bones=False, bake_anim=False,
    )
    assert OUTPUT.is_file() and OUTPUT.stat().st_size > 1024
    print(f'EXPORTED Arena {triangles(obj)} '
          f'{tuple(round(d, 4) for d in obj.dimensions)}', flush=True)


def preview(obj):
    # Render-only palette, using precisely one colour per exported role.
    palette = {
        'stone': (.43, .405, .36), 'stone_dark': (.355, .34, .305),
        'wood': (.20, .135, .085), 'wood_dark': (.115, .085, .060),
        'iron': (.16, .18, .185), 'iron_dark': (.055, .065, .068),
        'rail_steel': (.52, .58, .60), 'brass': (.53, .34, .11),
    }
    helpers = []
    scene = bpy.context.scene
    scene.render.engine = 'CYCLES'
    scene.cycles.samples = 24
    scene.cycles.use_denoising = True
    scene.render.resolution_x = 900
    scene.render.resolution_y = 900
    scene.render.resolution_percentage = 100
    scene.render.image_settings.file_format = 'PNG'
    scene.render.film_transparent = False
    scene.view_settings.view_transform = 'Standard'
    scene.world = bpy.data.worlds.new('Preview world')
    scene.world.use_nodes = True
    scene.world.node_tree.nodes['Background'].inputs['Color'].default_value = (.10, .115, .13, 1)
    scene.world.node_tree.nodes['Background'].inputs['Strength'].default_value = .7
    for name, colour in palette.items():
        mat = MATERIALS[name]
        mat.diffuse_color = (*colour, 1)
        mat.node_tree.nodes['Principled BSDF'].inputs['Base Color'].default_value = (*colour, 1)
    try:
        light = bpy.data.objects.new('Preview sun', bpy.data.lights.new('Preview sun', 'SUN'))
        scene.collection.objects.link(light)
        helpers.append(light)
        light.data.energy = 2.5
        light.data.angle = math.radians(15)
        light.rotation_euler = (math.radians(25), math.radians(-20), math.radians(-25))
        camera = bpy.data.objects.new('Preview camera', bpy.data.cameras.new('Preview camera'))
        scene.collection.objects.link(camera)
        helpers.append(camera)
        camera.data.type = 'ORTHO'
        camera.data.ortho_scale = 36
        scene.camera = camera
        pixels = array('f', [0]) * (1800 * 900 * 4)
        for index, elevation in enumerate((90, 55)):
            a = math.radians(elevation)
            camera.location = (0, -60 * math.cos(a), 60 * math.sin(a))
            camera.rotation_euler = (Vector((0, 0, -.1)) - camera.location).to_track_quat('-Z', 'Y').to_euler()
            # Save each view temporarily so pixel data remains accessible on
            # headless Blender builds that expose no Render Result pixels.
            temp = PREVIEW.with_name(f'.arena_preview_{index}.png')
            scene.render.filepath = str(temp)
            bpy.ops.render.render(write_still=True)
            im = bpy.data.images.load(str(temp), check_existing=False)
            src = array('f', [0]) * (900 * 900 * 4)
            im.pixels.foreach_get(src)
            for row in range(900):
                start = (row * 1800 + index * 900) * 4
                pixels[start:start + 3600] = src[row * 3600:(row + 1) * 3600]
            bpy.data.images.remove(im)
            temp.unlink()
        sheet = bpy.data.images.new('Arena top and 55 degree preview', width=1800, height=900)
        sheet.pixels.foreach_set(pixels)
        sheet.filepath_raw = str(PREVIEW)
        sheet.file_format = 'PNG'
        sheet.save()
        print(f'PREVIEW {PREVIEW}', flush=True)
    finally:
        for mat in MATERIALS.values():
            mat.diffuse_color = (.5, .5, .5, 1)
            mat.node_tree.nodes['Principled BSDF'].inputs['Base Color'].default_value = (.5, .5, .5, 1)
        scene.camera = None
        for helper in helpers:
            bpy.data.objects.remove(helper, do_unlink=True)
    assert len(scene.objects) == 1 and scene.objects[0] == obj


def main():
    bpy.ops.wm.read_factory_settings(use_empty=True)
    # Remove unused startup materials so role names never acquire .001 suffixes.
    for mat in list(bpy.data.materials):
        bpy.data.materials.remove(mat)
    bpy.context.scene.unit_settings.system = 'METRIC'
    bpy.context.scene.unit_settings.scale_length = 1
    setup_materials()
    build()
    obj = finish()
    export(obj)
    PREVIEW.parent.mkdir(parents=True, exist_ok=True)
    preview(obj)
    print('DONE', flush=True)


if __name__ == '__main__':
    main()



