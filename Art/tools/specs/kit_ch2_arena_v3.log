+
+
+def preview(obj):
+    palette = {
+        'stone': (.43, .405, .36), 'stone_dark': (.20, .195, .18),
+        'iron': (.16, .18, .185), 'iron_dark': (.045, .055, .060),
+        'rail_steel': (.37, .45, .49), 'brass': (.64, .405, .12),
