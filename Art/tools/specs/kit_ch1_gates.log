        assert names == {'Piece_%02d' % i for i in range(count)} | {'Splinter_%d' % i for i in range(3)}, names
    elif 'RewardDoor' in path.name:
        assert names == {'Frame', 'Leaf_L', 'Leaf_R'}, names
    else:
        assert len(objects) == 1
    print('VERIFIED', path.name, len(objects), flush=True)
