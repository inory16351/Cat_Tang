+    text('CORRIDORS  /  10.4 m', -2.0, 8.65, .36)
+    text('PORTALS', 8.3, 8.65, .36)
+    titles = ['01  BADLANDS', '02  OUTSKIRTS', '03  SHERIFF ALLEY', '04  MELTING PLAZA']
