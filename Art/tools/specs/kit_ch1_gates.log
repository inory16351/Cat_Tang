+                                  (sign * 2.9, .68), (sign * 2.7, .55),
+                                  (sign * 2.3, .80)], y - 1.27, y + 1.27, 'stone')
+                    parts.append(wall)
+                for i, y in enumerate((-3.8, 0, 3.8)):
