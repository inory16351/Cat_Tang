+def fit_xy(poly, sx, sy):
+    lo = [min(p[j] for p in poly) for j in (0, 1)]
+    hi = [max(p[j] for p in poly) for j in (0, 1)]
+    return [((x-(lo[0]+hi[0])/2)*sx/(hi[0]-lo[0]),
+             (y-(lo[1]+hi[1])/2)*sy/(hi[1]-lo[1])) for x, y in poly]
