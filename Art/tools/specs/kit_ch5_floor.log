+def star(x, y, z, size=.055):
+    # A small asymmetrical, closed crystal flake, not a circle or regular star.
+    poly = [(x-size*.60,y-size*.08),(x-size*.12,y-size*.45),
+            (x+size*.51,y-size*.16),(x+size*.26,y+size*.37),
+            (x-size*.17,y+size*.55)]
