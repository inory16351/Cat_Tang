+    extrude('Fallen glass right pane',[(-.08,-.40),(.66,-.40),(.66,.34),(.11,.05)],.06,'glass_blue')
+    extrude('Fallen glass upper pane',[(-.65,.44),(-.25,.20),(.08,.12),(.62,.42)],.06,'glass_blue')
+    move_group(start,(0,.51,.07),(math.pi/2,0,.11))
