+            v.y -= radius*.10
+            inner.append(len(verts))
+            verts.append(tuple(v))
+        faces[2] = tuple(inner)
+        faces += [(outer[j],outer[(j+1) % 4],inner[(j+1) % 4],inner[j]) for j in range(4)]
