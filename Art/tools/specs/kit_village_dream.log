+                   ((.08,.44,.12),(.18,.55,.95),.23),
+                   ((.46,-.39,.12),(.74,-.47,.78),.21)):
+        crystal('Tall exposed time crystal',a,b,r)
+    # Opaque-body compatible dial: actually recessed into the +Y hex facet.
