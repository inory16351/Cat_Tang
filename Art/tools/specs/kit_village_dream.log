+    matrix = Matrix.Translation(a) @ (b-a).to_track_quat('Z','Y').to_matrix().to_4x4()
+    for p in PARTS[-2 if core else -1:]:
+        p.verts = [matrix @ v for v in p.verts]
+    return part
