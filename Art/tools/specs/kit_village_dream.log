+                    beam('Gold inlay on X',(x-s*height*.15,.17,-height*.37),
+                         (x+s*height*.15,.17,height*.37),.045,.045,'gold')
+        move_group(start,loc,(.08,tilt,.10*tilt))
+        lump('Moss around numeral feet',(loc[0],loc[1]+.19,.23),(.49,.38,.25),'cactus_dark')
