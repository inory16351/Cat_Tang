+    for z in (-.22,.22):
+        hoop('Blue time spacer',(0,0,z),.27,.09,.075,'crystal_blue',n=12,rot=(math.pi/2,0,0))
+        cylinder('Luminous exposed axle collar',(0,0,z+.055),.16,.06,'crystal_core',n=8)
+
