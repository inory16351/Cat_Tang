+    box('Broken back brace',(-.28,-.24,1.13),(1.11,.15,.15),'wood_weathered',rot=(0,-.19,0))
+    extrude('Broken clock crest',[(-.94,3.67),(-.94,3.96),(-.66,4.10),(-.38,4.29),
