+            x = side*(.19+.035*(j % 2))
+            crystal('Rift growing edge splinter',(x,0,z),
+                    (x+side*(.20+.045*(j % 2)),.02,z+.48),.105,core=(j % 2 == 0))
+    # Clock debris aims at the slit: a gear, a Roman IX and a bent hand.
+    gear((-.56,.11,1.19),.26,.09,'brass',teeth=10,broken=(2,),rot=(.3,.4,.25))
