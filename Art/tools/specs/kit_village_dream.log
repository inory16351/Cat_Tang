+    assert len(scene.objects) == 12 and all(o.type == 'MESH' for o in scene.objects)
+    preview(exported)
+    assert len(scene.objects) == 12 and all(o.type == 'MESH' for o in scene.objects)
+    assert all(tuple(m.diffuse_color) == (.5,.5,.5,1) for m in MATS.values())
+    print('DONE',flush=True)
