+    gear((-.18,-.12,.82),1.91,.27,'brass',teeth=22,broken=(2,3,7,8,15))
+    for p in PARTS[start:]:
+        p.verts = [Vector((v.x,v.y,max(.06,v.z))) for v in p.verts]
+    # Solids wholly below the cut become degenerate; discard them before bevel.
+    PARTS[start:] = [p for p in PARTS[start:] if max(v.z for v in p.verts) > .061]
+    gear((.94,.40,.60),.78,.19,'brass',teeth=13,broken=(3,),rot=(.23,.12,-.16))
