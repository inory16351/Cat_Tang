+    def transform(self, loc=(0, 0, 0), rot=(0, 0, 0), scale=(1, 1, 1)):
+        matrix = (Matrix.Translation(Vector(loc)) @
+                  Euler(rot).to_matrix().to_4x4() @
+                  Matrix.Diagonal(Vector((*scale, 1))))
