+    vertices = [(x+size,y,z),(x,y+size,z),(x-size,y,z),(x,y-size,z),
+                (x,y,z+size*1.6),(x,y,z-size*1.6)]
+    return mesh('Stardust', vertices,
+                [(j,(j+1)%4,p) for p in (4,5) for j in range(4)],
