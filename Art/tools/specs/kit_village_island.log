+
+def mesh(label, vertices, faces, role, bevel=True):
+    data = bpy.data.meshes.new(label)
+    data.from_pydata(vertices, [], faces)
+    data.materials.append(MATS[role])
+    data.update()
+    bm = bmesh.new()
+    bm.from_mesh(data)
