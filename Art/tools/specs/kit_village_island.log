+        box('Hitching brass cap',(x,-.85,1.45),(.28,.29,.08),'brass')
+        ring('Hitching iron tether ring',(x,-.68,.92),.10,.15,.06,'iron',n=12,
+             rot=(math.pi/2,0,0))
