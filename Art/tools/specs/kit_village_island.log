+    faces = [tuple(reversed(range(n)))]
+    faces += [(i*n+j,i*n+(j+1)%n,(i+1)*n+(j+1)%n,(i+1)*n+j)
+              for i in range(len(points)-1) for j in range(n)]
+    faces.append(tuple(range((len(points)-1)*n,len(points)*n)))
