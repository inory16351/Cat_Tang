+
+def box(label, loc, size, role, rot=(0, 0, 0), bevel=True):
+    x, y, z = (v / 2 for v in size)
+    vertices = [(-x,-y,-z), (x,-y,-z), (x,y,-z), (-x,y,-z),
+                (-x,-y,z), (x,-y,z), (x,y,z), (-x,y,z)]
+    faces = [(0,3,2,1), (4,5,6,7), (0,1,5,4), (1,2,6,5),
+             (2,3,7,6), (3,0,4,7)]
