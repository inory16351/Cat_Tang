+def dead_tree():
+    trunk = [(-.55,.15,0),(-.38,.44,.80),(-.18,.79,1.65),(.10,1.18,2.45),
+             (.38,1.56,2.84)]
+    tube('Dead tree leaning into void',trunk,[.25,.21,.15,.09,.025],
+         'wood_weathered',n=6)
+    for points,radii in (
+        ([trunk[1],(-1.1,.82,1.25),(-1.45,1.10,1.72)],[.13,.08,.025]),
+        ([trunk[2],(.55,1.0,1.88),(.96,1.29,2.30)],[.12,.07,.025]),
+        ([trunk[3],(-.25,1.39,2.83),(-.52,1.40,3.13)],[.07,.045,.02]),
+        ([(-1.1,.82,1.25),(-1.45,.68,1.35)],[.065,.025]),
+    ):
+        tube('Broken dead tree bough',points,radii,'wood_weathered')
+    for i in range(4):
+        x = -.6+(i-1.5)*.3
+        tube('Exposed tree root gripping lip',[(-.55,.15,.16),(x,.48,-.12),
+             (x+.15,.87,-1.3),(x+.32,.72,-3.1-i*.37)],
+             [.13,.11,.065,.025],'root')
+    for layer,count in enumerate((4,3,2,1)):
+        for i in range(count):
+            s = .18-layer*.036
+            box('Tree crown dissolving splinter',(.45+i*.17,1.5,3.15+layer*.29),
+                (s,.07,s*1.2),'wood_weathered',rot=(.1,.3,i*.3))
+    crumbs((.45,1.6,3.1),7,(.12,.08,1),1.2)
+
