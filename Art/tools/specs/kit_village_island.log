+
+def tube(label, points, radii, role, n=5):
+    """Closed tapered polygonal strand; .04 m minimum diameter."""
+    if isinstance(radii, (float, int)):
+        radii = [radii]*len(points)
+    vertices = []
+    for i, p in enumerate(points):
