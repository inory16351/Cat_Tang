+        for v in obj.data.vertices:
+            if v.co.y > 1.05:
+                v.co.y -= random.uniform(0,.20)
+        cylinder('Old iron board nail',(x,-.12,.15),.025,.045,'iron',n=6)
+    wagon_wheel()
+    falling_chunks(6,4,edge=True)
