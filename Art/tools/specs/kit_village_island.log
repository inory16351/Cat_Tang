+def cylinder(label, loc, radius, depth, role, n=12, rot=(0,0,0)):
+    vertices = [(radius*math.cos(j*TAU/n), radius*math.sin(j*TAU/n), z)
+                for z in (-depth/2, depth/2) for j in range(n)]
