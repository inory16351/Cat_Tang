+# This is the exact Unity invisible-edge-wall polygon. Never grow or bevel it.
+OUTLINE = [
+    (-7.0,-41.0), (-7.2,-20.0), (-7.0,0.0), (-7.4,12.0),
+    (-11.0,14.0), (-15.5,17.5), (-17.0,23.0), (-16.0,29.0),
