+        box('Sign relief diamond',(s*1.5,-.34,4.31),(.15,.06,.15),'gold',rot=(0,math.pi/4,0))
+    clock_1159((0,0,5.04),.42,False)
+    for s in (-1,1):
+        scroll('Clock pediment scroll',(s*.64,-.12,4.91),.29,s)
