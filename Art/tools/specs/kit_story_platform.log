+    cylinder('Pocket watch dial',(.18,-.45,1.34),.079,.04,'clock_face',n=12,rot=(math.pi/2,0,0))
+    beam('Pocket minute hand',(.18,-.475,1.34),(.18,-.475,1.395),.04,.04,'iron_dark')
