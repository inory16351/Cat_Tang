    box('Lantern base', (x, y, z - .18), (.2, .2, .05), 'brass')


def steps(x, y, w, n=2, role='plank'):
    for k in range(n):
        h = .18 * (n - k)
        box('Step', (x, y + .32 * k, h / 2), (w, .32, h), role)


