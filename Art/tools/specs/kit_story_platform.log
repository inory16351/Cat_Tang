+        box('Flat cap peak',(0,-.16,1.743),(.32,.21,.055),'shadow',rot=(.08,0,0),bevel=False)
+        box('Warm thin cap peak rim',(0,-.265,1.743),(.3,.04,.045),'shadow_rim',bevel=False)
+    move_group(start,scale=(s,s,s))
+    return s
