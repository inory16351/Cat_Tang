+        for dx in (-.88,.88):
+            box('Booth upright',(cx+dx,.2,1.95),(.13,.15,1.7),'wood_dark')
+        box('Warm booth interior',(cx,.36,1.95),(1.64,.06,1.5),'window_lit',bevel=False)
+        box('Booth window glass',(cx,.25,1.95),(1.64,.06,1.5),'glass',bevel=False)
