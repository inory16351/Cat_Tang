+        z = 3.4+1.13*(1-(x/4.2)**2)
+        beam('Arch lattice diagonal',(x,0,z),(x+.25,0,z+.4),.055,.07,'iron')
+    box('Gold sign outer frame',(0,-.12,4.31),(3.7,.22,.8),'gold')
+    box('Green enamel sign board',(0,-.26,4.31),(3.44,.1,.57),'paint_green')
