+def assembled_mesh(name):
+    objects = []
+    for bevel in (True, False):
+        verts, faces, indices = [], [], []
+        for p in PARTS:
+            if p.bevel != bevel:
+                continue
+            offset = len(verts)
+            verts.extend(p.verts)
+            faces.extend(tuple(offset + i for i in f) for f in p.faces)
