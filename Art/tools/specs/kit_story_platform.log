+    rod('Clock hanging link',(1.2,0,4.35),(1.2,0,4.14),.045,'brass',n=6)
+    clock_1159((1.2,0,3.44),.7)
+    for s in (-1,1):
+        scroll('Clock gold crest curl',(1.2+s*.21,0,4.13),.2,s)
+    box('Gold clock crest',(1.2,0,4.24),(.2,.14,.18),'gold',rot=(0,math.pi/4,0))
