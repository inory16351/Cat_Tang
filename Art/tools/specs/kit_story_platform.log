+def inside(pt, poly=OUTLINE):
+    x, y = pt
+    result = False
+    for i, (x1,y1) in enumerate(poly):
+        x2,y2 = poly[(i+1) % len(poly)]
+        if (y1 > y) != (y2 > y) and x < (x2-x1)*(y-y1)/(y2-y1)+x1:
+            result = not result
+    return result
