+                (cx+.66*math.cos(a),-.34+.22*math.sin(a),1.4),.045,'brass',n=6,bevel=False)
+    # Arched lattice has real negative space. Its lowest member is above 3.2m.
+    for zoff,role,r in ((0,'iron',.09),(.43,'gold',.055)):
