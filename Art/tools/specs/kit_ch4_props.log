+             loc=(side*.145*scale,0,.09*scale),rot=(math.pi/2,0,0))
+    cylinder('Key centre boss',(0,.035*scale,.05*scale),.085*scale,.11*scale,
+             'gold',n=10,rot=(math.pi/2,0,0))
+    for obj in PARTS[start:]:
+        place(obj,loc,rot)
+
