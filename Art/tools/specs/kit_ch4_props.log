+        box('Raised hour tick',(x+.77*radius*math.sin(a),y+.065,z+.77*radius*math.cos(a)),
+            (.045,.04,.11 if j%3 else .15),'dial_mark',rot=(0,a,0),bevel=False)
+    for a,length in ((-.65,.49*radius),(1.0,.66*radius)):
