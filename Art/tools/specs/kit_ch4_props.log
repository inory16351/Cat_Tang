+def cog_bits():
+    for i,(x,y,r,z) in enumerate(((-.36,-.35,.20,.025),(.31,-.30,.22,.025),
+            (-.15,.10,.24,.025),(.31,.31,.19,.025),(-.36,.37,.17,.025),(.02,.09,.15,.085))):
