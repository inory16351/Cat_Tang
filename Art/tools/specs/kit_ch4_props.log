+    ('ScrewBits',(1,1,.1),screw_bits,5000),
+    ('FloorGrate',(2,2,.03),floor_grate,5000),
+]
+
+
+def triangles(obj):
+    obj.data.calc_loop_triangles()
+    return len(obj.data.loop_triangles)
+
+
+def bounds(obj):
