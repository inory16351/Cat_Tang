+
+
+SPECS=[
+    ('GearFloor',(8,8,.56),gear_floor,5000),
+    ('WindSpring',(1,1,1.5),wind_spring,5000),
+    # Axis X => axial thickness is X; radial rolling extent is Y/Z.
