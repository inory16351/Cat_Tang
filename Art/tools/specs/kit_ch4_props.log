+    # Review-only scale doubles the small pieces; GearFloor stays at true scale.
+    layout=[(-6,0,1),(-.4,3.5,1.5),(3.2,3.5,1.5),(6.8,3.5,1.5),
+            (-.4,0,1.5),(3.2,0,1.5),(6.8,0,1.5),(0,-4,1.5),
+            (3.3,-4,1.5),(6.5,-4,1.5),(6.5,-7.3,1.25)]
