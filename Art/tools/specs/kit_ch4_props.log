+        box('Six radial iron spokes',(1.95*math.cos(a),1.95*math.sin(a),.006),
+            (2.45,.21,.048),'iron',rot=(0,0,a),bevel=False)
+    ring('Seventy percent radius gold line',2.82,.045,0,.025,'gold',n=72)
+    for j in range(12):
