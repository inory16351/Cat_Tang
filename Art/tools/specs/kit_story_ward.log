    ('HandMinuteRed', lambda: hand_minute('red_lacquer'), 600),
    ('PendulumS', pendulum_s, 900),
    ('DecoRound', deco_round, 3000),
    ('DecoSun', deco_sun, 3000),
    ('ClockShelf', clock_shelf, 6000),
    ('Workbench', workbench, 9000),
