def window():
    # Origin = opening bottom centre at floor, inner wall face y=0, room toward -Y.
    for side in (-1,1):
        box('Jamb liner', (side*1.07,.3,2.55), (.06,.6,2.9), 'wood')
        box('Side casing', (side*1.22,-.04,2.62), (.2,.08,3.25), 'wood_dark')
