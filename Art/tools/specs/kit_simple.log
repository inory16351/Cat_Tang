+                      "canvas" if (i + layer) % 2 else "sand",
+                      rotation=(0, RNG.uniform(-.035, .035), -.22 * x),
+                      rounding=.115)
+            obj.scale.y = RNG.uniform(.96, 1.04)
+
+
+def barrel(center, lying=False, twist=0):
+    # 輪郭の膨らんだ十二角樽。輪は中空の帯なので端面を隠しません。
+    before = len(PARTS)
+    n = 12
+    profile = [(-.43, .30), (-.33, .335), (0, .37), (.33, .335), (.43, .30)]
