+                profile=[mix(outer[k],outer[k+1],t0),mix(outer[k],outer[k+1],t1),
+                         mix(inner[k],inner[k+1],t1),mix(inner[k],inner[k+1],t0)]
+                prism('Pointed dark stone voussoir',profile,-.43,.43,
+                      'stone_dark' if j%2==0 else 'stone')
