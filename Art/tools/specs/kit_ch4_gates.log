+                  {1:'wood',2:'navy_paint',3:'copper',4:'glass'}[stage],False)
+        obj=join([obj],f'Splinter_{j}')
+        activate(obj)
+        bpy.ops.object.origin_set(type='ORIGIN_GEOMETRY',center='BOUNDS')
+        result.append(obj)
+    return result
