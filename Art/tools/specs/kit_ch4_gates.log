+    cylinder('Bell clapper',(x,y,z-.01*scale),.055*scale,.12*scale,
+             'iron',n=8,bevel=False)
+    cylinder('Bell suspension',(x,y,z+.49*scale),.04*scale,.14*scale,
+             'iron',n=6,bevel=False)
+
