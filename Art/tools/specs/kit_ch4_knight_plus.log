def needle_dagger():
    grip()
    box('Small straight crossguard',(0,0,.13),(.25,.10,.06),'brass')
    solid('Second hand needle',[(-.033,.15),(.033,.15),(.036,.43),
          (0,.53),(-.036,.43)],.045,'silver')
