s=s[:a]+'''def chimney(x, y, bottom, top, radius=.42, curl=.58):
    \"\"\"Masonry follows a rising helix; individual courses twist around its spine.

    Adjacent courses overlap, and a continuous dark core supports every brick.
    The open rolled lip is the highest connected geometry, with no fake smoke.
    \"\"\"
    def spine(t):
        a=t*TAU*1.12
        return Vector((x+curl*(math.cos(a)-1)*t,
                       y+curl*math.sin(a)*t,bottom+(top-bottom)*t))
    points=[tuple(spine(i/32)) for i in range(33)]
    tube('Corkscrew chimney continuous flue',points,radius*.81,'stone_dark',8)
    rows=math.ceil((top-bottom)/.28)
    for i in range(rows):
        t=(i+.5)/rows
        center=spine(t)
        tangent=(spine(min(1,t+.01))-spine(max(0,t-.01))).normalized()
        quat=tangent.to_track_quat('Z','Y')
        for j in range(4):
            a=j*TAU/4+i*.19
            offset=quat @ Vector((radius*.58*math.cos(a),radius*.58*math.sin(a),0))
            obj=box('Helical staggered brick',tuple(center+offset),
                    (radius*.99,radius*.90,(top-bottom)/rows+.04),
                    ('stone','stone_dark','rust')[(i+j)%3],(0,0,a))
            # Rotate the brick course perpendicular to the bent centreline.
            obj.data.transform(Matrix.Translation(center+offset) @ quat.to_matrix().to_4x4() @
                               Matrix.Translation(-(center+offset)))
    end=spine(1)
    tangent=(spine(1)-spine(.99)).normalized()
    start=len(PARTS)
    lip=ring('Open rust corkscrew chimney lip',(0,0,0),radius*1.14,.13,.19,'rust',16)
    transform(lip,tuple(end),tangent.to_track_quat('Y','Z').to_euler())
    return end.z+.24


