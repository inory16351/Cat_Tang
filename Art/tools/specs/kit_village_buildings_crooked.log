s=s[:a]+'''def mapped_block(label, loc, size, role, warp, segments=6):
    \"\"\"Closed subdivided box, bent by the same continuous lattice as its room.

    Shared grid vertices keep the six surfaces manifold after deformation.
    This is baked mesh deformation, so the FBX needs no modifier evaluator.
    \"\"\"
    nx, ny, nz = 1, 1, segments
    vertices, faces, lookup = [], [], {}
    def vertex(i,j,k):
        key = (i,j,k)
        if key not in lookup:
            lookup[key] = len(vertices)
            vertices.append(warp((loc[0]+size[0]*(i/nx-.5),
                                  loc[1]+size[1]*(j/ny-.5),
                                  loc[2]+size[2]*(k/nz-.5))))
        return lookup[key]
    for k in range(nz):
        for i in range(nx):
            faces += [(vertex(i,0,k),vertex(i+1,0,k),vertex(i+1,0,k+1),vertex(i,0,k+1)),
                      (vertex(i,ny,k+1),vertex(i+1,ny,k+1),vertex(i+1,ny,k),vertex(i,ny,k))]
        for j in range(ny):
            faces += [(vertex(0,j,k+1),vertex(0,j+1,k+1),vertex(0,j+1,k),vertex(0,j,k)),
                      (vertex(nx,j,k),vertex(nx,j+1,k),vertex(nx,j+1,k+1),vertex(nx,j,k+1))]
    faces += [(vertex(0,0,0),vertex(0,ny,0),vertex(nx,ny,0),vertex(nx,0,0)),
              (vertex(0,0,nz),vertex(nx,0,nz),vertex(nx,ny,nz),vertex(0,ny,nz))]
    return mesh(label,vertices,faces,role)


def deform_parts(start, warp):
    for obj in PARTS[start:]:
        for v in obj.data.vertices:
            v.co = warp(v.co)


def dream_volume(label, width, depth, height, center, bottom, yaw=0,
                 lean=.45, paint=None, holes=(), windows=(), ruin=False,
                 roof_role='roof_shingle', ground=False):
    \"\"\"One hollow stacked room: a baked bend/taper/twist lattice, not a cube.

    All boards, trim, openings and terrace shingles share the lattice. Ground
    deformation fades to zero around the central straight entrance pocket.
    \"\"\"
    cx,cy = center
    phase = .55 if lean>0 else 2.1
    angle = math.radians(yaw)
    def warp(p):
        x,y,z = p
        t = max(0,min(1,z/height))
        doorway = 1
        if ground and abs(x)<1.75 and y>depth/2-.35:
            doorway = max(0,(abs(x)-.90)/.85)
        bulge = .105*math.sin(math.pi*t)-.055*t
        xx = x*(1+bulge)+lean*t*t
        yy = y*(1+.07*math.sin(math.pi*t))+.18*math.sin(math.pi*t+phase)*t
        twist = math.radians(5)*math.sin(t*math.pi/2)*(1 if lean>0 else -1)
        xx,yy = xx*math.cos(twist)-yy*math.sin(twist),xx*math.sin(twist)+yy*math.cos(twist)
        xx,yy = x+(xx-x)*doorway,y+(yy-y)*doorway
        zz = z+t*t*(.23*math.sin(x*.95+phase)+.16*math.sin(y*1.1)
                         -.20*(abs(x)/(width/2))**4)
        return (cx+xx*math.cos(angle)-yy*math.sin(angle),
                cy+xx*math.sin(angle)+yy*math.cos(angle),bottom+zz)
    def wall(length, origin, rotation, cuts, frontwall=False):
        n = math.ceil(length/.46)
        pitch = length/n
        c,sn = math.cos(rotation),math.sin(rotation)
        def wallwarp(p):
            x,y,z=p
            return warp((origin[0]+x*c-y*sn,origin[1]+x*sn+y*c,z))
        for i in range(n):
            u = -length/2+(i+.5)*pitch
            top = height
            if ruin and frontwall and i>=n-3:
                top -= (.32,.73,.48)[i-(n-3)]
            rectangles = [(u-pitch/2+.007,u+pitch/2-.007,0,top)]
            for hu,hz,hw,hh in cuts:
                result=[]
                for l,r,a,b in rectangles:
                    left,right=max(l,hu-hw/2),min(r,hu+hw/2)
                    low,high=max(a,hz),min(b,hz+hh)
                    if left>=right or low>=high:
                        result.append((l,r,a,b))
                    else:
                        result += [(l,left,a,b),(right,r,a,b),
                                   (left,right,a,low),(left,right,high,b)]
                rectangles=[q for q in result if q[1]-q[0]>.045 and q[3]-q[2]>.045]
            for l,r,a,b in rectangles:
                role = paint if paint and i%3 else WOOD[i%5]
                mapped_block(label+' bowed plank',((l+r)/2,0,(a+b)/2),
                             (r-l,.16,b-a),role,wallwarp)
    allholes=list(holes)+[(x,z-h/2,w*1.06,h*1.09) for x,z,w,h,*_ in windows]
    wall(width,(0,depth/2),0,allholes,True)
    wall(width,(0,-depth/2),math.pi,())
    for side in (-1,1):
        wall(depth,(side*width/2,0),-side*math.pi/2,())
    for x in (-width/2,width/2):
        for y in (-depth/2,depth/2):
            mapped_block(label+' bent corner post',(x,y,height/2),(.23,.23,height),
                         'wood_dark',warp,9)
    # Curved horizontal trim / drooping eaves sampled along every edge.
    for zz in (.12,height-.08):
        for y in (-depth/2-.06,depth/2+.06):
            points=[warp((-width/2+i*width/18,y,zz)) for i in range(19)]
            tube(label+' wax cornice',points,.105,'cloth_cream',6)
        for x in (-width/2,width/2):
            points=[warp((x,-depth/2+i*depth/12,zz)) for i in range(13)]
            tube(label+' side cornice',points,.105,'wood_light',6)
    for index,item in enumerate(windows):
        x,z,w,h,*rest=item
        start=len(PARTS)
        window(label+' uneven window',x,depth/2+.08,z,w,h,
               trim='cloth_cream',tilt=rest[0] if rest else (-.08 if index%2 else .09))
        deform_parts(start,warp)
    # Thick shingled terrace, with scalloped silhouette and a torn corner.
    cols,rows=max(3,math.ceil(width/.75)),max(3,math.ceil(depth/.8))
    for i in range(cols):
        for j in range(rows):
            if ruin and i>=cols-2 and j>=rows-2 and (i+j)%2==0:
                continue
            x=-width/2+(i+.5)*width/cols
            y=-depth/2+(j+.5)*depth/rows
            # Sampling across the panel makes roof edges visibly wave.
            mapped_block(label+' melted roof shingle',(x,y,height+.035),
                (width/cols+.045,depth/rows+.045,.16),
                roof_role if (i+j)%5 else 'rust',warp,1)
    if ruin:
        for i in range(3):
            x=width/2-.7-i*.24
            a=warp((x,depth/2-.10,height-.15))
            b=warp((x-.20,depth/2-.12,height+.25+.13*(i%2)))
            snapped_plank(label+' attached roof splinter',a,b,.16,.13)
    return warp


def false_front(warp, width, height, paint):
    start=len(PARTS)
    for i in range(11):
        x=-width/2+(i+.5)*width/11
        top=height+.32+.55*(1-(x/(width/2))**2)+.13*math.sin(i*1.2)
        if i>=9:
            top-=.38
        box('Wavering broken western false front',(x,0,(height-.18+top)/2),
            (width/11-.015,.18,top-height+.18),paint)
    deform_parts(start,warp)


def balcony(warp, width, depth, height):
    start=len(PARTS)
    for i in range(13):
        x=-width/2+(i+.5)*width/13
        box('Cantilever balcony deck',(x,depth/2+.47,.04),
            (width/13-.012,.99,.15),WOOD[i%5])
