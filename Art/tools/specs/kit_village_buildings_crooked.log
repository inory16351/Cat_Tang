def corner_top(x, y, width, front, height, cx=0):
    """Three broad stair steps remove the upper +X / front corner."""
    dx,dy = cx+width/2-x,front-y
    if dx < 1.85 and dy < 1.95:
        loss = (.62 if dx > 1.28 else 1.18 if dx > .65 else 1.85)
        loss += .22 if dy < .68 else 0
        return height-loss
    return height


def wall_boards(length, height, loc, rotation, holes, paint=None, ceiling=None):
    """Closed thick wall boards split around true window and door openings.

    holes are (horizontal centre, bottom, width, height) in wall-local space.
    """
    n = math.ceil(length/.54)
    pitch = length/n
    for i in range(n):
        u = -length/2+(i+.5)*pitch
        # Clip each board exactly at the opening edges; dropping an entire
        # intersecting board would leave visible slits beside the window frame.
        world = Vector(loc)+Euler((0,0,rotation)).to_matrix() @ Vector((u,0,0))
        top = ceiling(world.x,world.y) if ceiling else height
        rectangles = [(u-pitch/2+.011,u+pitch/2-.011,.24,top)]
        for hu,hz,hw,hh in holes:
            cut = []
            for left,right,a,b in rectangles:
                l,r = max(left,hu-hw/2),min(right,hu+hw/2)
                low,high = max(a,hz),min(b,hz+hh)
                if l>=r or low>=high:
                    cut.append((left,right,a,b))
                    continue
                cut += [(left,l,a,b),(r,right,a,b),(l,r,a,low),(l,r,high,b)]
            rectangles = [(l,r,a,b) for l,r,a,b in cut if r-l>.005 and b-a>.005]
        for left,right,a,b in rectangles:
            role = paint if paint and i%4 != 0 else WOOD[i%len(WOOD)]
            obj = box('Alternating wall plank',((left+right)/2,0,(a+b)/2),
                      (right-left,.15,b-a),role)
            transform(obj,loc,(0,0,rotation))


def shell(width, depth, height, front_holes, paint=None, cx=0):
    front,back = depth/2-1.6,-depth/2
    center = (front+back)/2
    ceiling = lambda x,y: corner_top(x,y,width,front,height,cx)
    sideholes = [(center+.65,1.55,1.25,1.5)]
    if height > 6:
        sideholes += [(center-.9,4.55,1.25,1.5)]
    # All four elevations are built rather than a solid cube with facade plates.
    wall_boards(width,height,(cx,front,0),0,
                [(u-cx,z,w,h) for u,z,w,h in front_holes],paint,ceiling)
    rearholes = [(-width*.25,1.55,1.2,1.5),(width*.25,1.55,1.2,1.5)]
    if height > 6:
        rearholes += [(-width*.25,4.55,1.2,1.5),(width*.25,4.55,1.2,1.5)]
    wall_boards(width,height,(cx,back,0),math.pi,rearholes,paint,ceiling)
    for s in (-1,1):
        # Local u maps to world Y with the appropriate sign.
        holes = [((center-u)*s,z,w,h) for u,z,w,h in sideholes]
        wall_boards(front-back,height,(cx+s*width/2,center,0),-s*math.pi/2,holes,paint,ceiling)
        for u,z,w,h in sideholes:
            window('Side window',cx+s*(width/2+.08),u,z+h/2,w,h,
                   trim='cloth_cream' if paint else 'wood_light',side=-s*math.pi/2)
    for u,z,w,h in rearholes:
        window('Rear window',cx-u,back-.09,z+h/2,w,h,trim='wood_light',side=math.pi)
    middle = (left+right)/2
    box('Lean-to stone floor',(middle,-.125,.14),(right-left,5.05,.28),'stone')
    for y in (-2.45,1.65):
        box('Lean-to outer post',(right-.15,y,1.58),(.17,.18,2.9),'wood_dark')
        rod('Lean-to post brace',(right-.15,y,2.15),(right-.64,y,2.98),.075,'wood_light')
    # Rear end of the workshop shelter has also been torn away; the anvil,
    # front landing and entrance porch remain covered and unobstructed.
    for i in range(5):
        for j in range(6):
            if j<((2,2,1,1,0)[i]):
                continue
            x = left+(i+.5)*(right-left)/5
            box('Broken lean-to roof board',(x,-2.75+(j+.5)*.8,
                3.12-(x-middle)*math.tan(.20)),
                ((right-left)/5+.03,.78,.16),'roof_shingle',(0,.20,0))
    box('Broken lean-to fascia',(right,.40,2.94),(.15,3.30,.22),'rust')
    for yy in (-2.35,-1.55):
        rod('Lean-to exposed crossbeam',(left,yy,3.23),(right-.15,yy,2.91),.095,'wood_dark')
    snapped_plank('Lean-to snapped rafter',(right-.15,-1.55,2.91),
                  (right-.32,-2.26,2.75),.22,.17)
    # Anvil is a solid extruded silhouette including horn, waist and feet.
    ax,ay = 3.32,1.45
    box('Anvil timber block',(ax,ay,.62),(.72,.68,.96),'wood_dark')
    poly = [(-.50,1.12),(.50,1.12),(.35,1.30),(.17,1.37),(.22,1.64),
            (.56,1.70),(.77,1.86),(-.49,1.86),(-.77,1.72),(-.38,1.62),
            (-.19,1.39),(-.25,1.27)]
    extrude('Forge iron anvil',[(ax+x,z) for x,z in poly],.48,'iron',ay)
    qx,qy = 2.73,2.20
    lathe('Quench barrel staves',(qx,qy,.25),[(0,.40),(.15,.46),(.75,.46),(.95,.40)],
          'wood_weathered',12)
    for z in (.40,.92,1.17):
        cylinder('Quench barrel iron hoop',(qx,qy,z),.475,.09,'iron',12)
    cylinder('Quench barrel recessed water',(qx,qy,1.19),.34,.055,'glass',16)
    for i in range(10):
        a = i*TAU/10
        rod('Barrel stave seam',(qx+.45*math.cos(a),qy+.45*math.sin(a),.43),
            (qx+.45*math.cos(a),qy+.45*math.sin(a),1.08),.022,'wood_dark',5)
    chimney(-2.90,b+1.2,4.70,6.6)
    # Large hourglass is safely above the porch and closed barn doors.
    start = len(PARTS)
    hourglass((0,f+.56,5.01),.91)
    # A taller profile keeps both bulbs legible from the steep game camera.
    for obj in PARTS[start:]:
        for v in obj.data.vertices:
            v.co.z = 5.20+(v.co.z-5.01)*1.30
    for x in (-3.25,):
        bullet((x,f+.18,5.67),1.15)
    crate((-2.25,f+.69,.22))
    crate((2.03,f+.69,.22))
    lantern((-1.65,f+.40,2.90),.7)
    wall_crack(f,-1.80,4.29,.64)
    wall_crack(f,.96,4.05,.50)


def mannequin(loc, role):
    x,y,z = loc
    cylinder('Dress form wood foot',(x,y,z+.05),.31,.10,'wood',10)
    rod('Dress form wooden stand',(x,y,z+.1),(x,y,z+.64),.055,'wood')
    lathe('Tailored dress-form silhouette',(x,y,z+.54),
          [(0,.38),(.18,.34),(.48,.18),(.69,.23),(.89,.32),
           (1.04,.21),(1.10,.09),(1.24,.09)],role,12,bevel=False)
    cylinder('Mannequin neck cap',(x,y,z+1.81),.12,.07,'wood',10)
    ring('Dress form waist tape',(x,y+.23,z+1.06),.20,.045,.06,'gold',12)


def wardrobe():
    w,d,h = 7.5,7,4.65
    f,b = shell(w,d,h,[(0,.22,1.4,2.5),(-2.3,.85,2.5,2.3),
                      (2.60,1.55,1.15,1.55)],paint='paint_sage')
    roof(w,f,b,h,1.05,'roof_shingle')
    crest(w,f,h,6.65,'paint_sage')
    boardwalk(w,f)
    door(f,1.4)
    porch(f,2.05,3.10)
    window('Tailor right window',2.6,f+.12,2.325,1.15,1.55,True,trim='cloth_cream')
    # Projecting five-sided bay with proper plinth, canopy, returns and glass.
    x = -2.3
    plan = [(-1.24,0),(-1.24,.47),(-.92,.88),(.92,.88),(1.24,.47),(1.24,0)]
    for z in (.83,3.55):
        n = len(plan)
        verts = [(x+u,f+v,z+zz) for zz in (-.09,.09) for u,v in plan]
        faces = [tuple(reversed(range(n))),tuple(range(n,2*n))]
        faces += [(i,(i+1)%n,(i+1)%n+n,i+n) for i in range(n)]
        mesh('Tailor bay plinth / canopy',verts,faces,'cloth_cream')
    box('Bay rear lit backdrop',(x,f+.02,2.18),(2.4,.09,2.56),'window_lit')
    for u,v in plan[1:-1]:
        box('Bay window cream upright',(x+u,f+v,2.18),(.105,.105,2.61),'cloth_cream')
    # Side glass panes; the frontal pane is rolled up for the window display.
    for s in (-1,1):
        box('Bay return glass',(x+s*1.21,f+.24,2.18),(.055,.44,2.46),'glass')
        box('Bay angled glass',(x+s*1.07,f+.67,2.18),(.055,.49,2.46),'glass',
            (0,0,s*math.radians(38)))
    box('Bay upper transom',(x,f+.89,3.29),(1.84,.06,.27),'glass')
    box('Bay lower protective rail',(x,f+.92,1.05),(1.86,.10,.10),'cloth_cream')
    mannequin((x-.46,f+.55,.94),'cloth_cream')
    mannequin((x+.46,f+.55,.94),'cloth_red')
    # The sign survives on a bare stud where its surrounding wall vanished.
    snapped_plank('Exposed spool sign mounting stud',(2.65,f+.10,2.94),
                  (2.65,f+.10,4.52),.24,.18,'wood_dark')
    sy,sz = sign_bracket(2.65,f,4.33,1.12)
    # Spool axis Z, wide wooden flanges, raised red thread bands and needle.
    for zz in (-.42,.42):
        cylinder('Thread spool wood flange',(2.65,sy,sz+zz),.47,.12,'wood_light',12)
    cylinder('Thread spool red winding',(2.65,sy,sz),.31,.76,'cloth_red',12)
    for j in range(5):
        cylinder('Raised thread band',(2.65,sy,sz-.29+j*.145),.34,.045,'cloth_red',12)
    rod('Large iron sewing needle',(2.32,sy+.35,sz-.60),
        (3.13,sy+.35,sz+.80),.035,'iron')
    ring('Needle eye',(3.12,sy+.35,sz+.76),.105,.04,.06,'iron',12)
    # Real fabric pennants on a sagging cord across the eaves.
    def cord_height(u):
        return 4.52-.22*math.sin((u/w+.5)*math.pi)-max(0,u-1.45)*.67
    points = [(-w/2+i*w/16,f+.45,cord_height(-w/2+i*w/16)) for i in range(17)]
    tube('Bunting cord',points,.025,'wood_dark')
    for i in range(13):
        u = -w*.46+(i+.5)*w*.92/13
        if u>2.25:
            continue
        zz = cord_height(u)
        extrude('Fabric bunting pennant',[(u-.20,zz),(u+.20,zz),(u,zz-.42)],
                .05,('cloth_red','cloth_cream','paint_rose')[i%3],f+.46,False)
    lantern((.99,f+.45,2.55),.65)
    wall_crack(f,1.30,4.38,.84)
    wall_crack(f,-.94,4.30,.59)


def arch_segment(inner, outer, a, b, bottom, depth, role, steps=4):
    angles = [a+(b-a)*j/steps for j in range(steps+1)]
    poly = [(outer*math.cos(t),bottom+outer*math.sin(t)) for t in angles]
    poly += [(inner*math.cos(t),bottom+inner*math.sin(t)) for t in reversed(angles)]
    return extrude('Grand arch curved beam segment',poly,depth,role,-.20)


def ruined_clock_hood(x, side):
    """Hollow, roofless patches expose a clock case without losing its dial."""
    box('Clock hood dark interior',(x,-.20,6.04),(1.70,2.18,.16),'wood_dark')
    front = [(x-.96,6.02),(x+.96,6.02),(x+.85,6.42),
             (x,6.85),(x-.85,6.42)]
    if side==1:
        front = [(x-.96,6.02),(x+.43,6.02),(x+.43,6.18),
                 (x+.17,6.18),(x+.17,6.56),(x,6.85),(x-.85,6.42)]
    extrude('Broken clock hood front',front,.18,'wood_weathered',1.00)
    extrude('Clock hood rear remnants',[(x-.96,6.02),(x+.96,6.02),
            (x+.66,6.34),(x+.32,6.34),(x+.32,6.56),
            (x-.20,6.56),(x-.20,6.70),(x-.85,6.42)],.18,'wood_dark',-1.35)
    for pitch in (-1,1):
        for i in range(4):
            for j in range(5):
                crater = side==-1 and pitch==-1 and i in (1,2,3) and j in (1,2,3)
                corner = side==1 and pitch==1 and j>=(2 if i<2 else 3)
                if crater or corner:
                    continue
