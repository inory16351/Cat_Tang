# ?ㅽ뻾: "C:/Program Files/Blender Foundation/Blender 5.3/blender.exe" -b --factory-startup -P Art/tools/blender_kit_village_buildings.py
"""Deterministic village kit; stock Blender only. Metres, Z up, front +Y.

Run exports first with neutral role materials, then renders a coloured review.
Broken edges stay on the buildings; rising debris is spawned by the game.
The gate deliberately substitutes an open passage for the shops' closed door.
No shared helpers, input assets, textures, or other source files are modified.
"""

import math
import random
from pathlib import Path

import bmesh
import bpy
from mathutils import Euler, Matrix, Vector
from mathutils.bvhtree import BVHTree


ROOT = Path(__file__).resolve().parents[2]
OUTPUT = ROOT / 'Game/Assets/Art/Characters/Village'
PREVIEW = ROOT / 'Art/tools/specs/blender_kit_village_buildings_preview.png'
ROLES = ('wood', 'wood_dark', 'wood_light', 'wood_weathered', 'plank',
         'roof_shingle', 'roof_tin', 'stone', 'stone_dark', 'sand_glow',
         'brass', 'gold', 'gold_drip', 'iron', 'rust', 'canvas', 'cloth_red',
         'cloth_cream', 'paint_rose', 'paint_sage', 'glass', 'window_lit',
         'lantern_glow', 'clock_face')
SOFT = {'canvas', 'cloth_red', 'cloth_cream', 'glass', 'window_lit',
        'lantern_glow', 'sand_glow', 'clock_face'}
PALETTE = {
    'wood': (.46, .25, .12), 'wood_dark': (.21, .105, .055),
    'wood_light': (.76, .51, .28), 'wood_weathered': (.49, .40, .29),
    'plank': (.63, .38, .20), 'roof_shingle': (.37, .24, .18),
    'roof_tin': (.60, .53, .41), 'stone': (.60, .55, .45),
    'stone_dark': (.30, .27, .22), 'sand_glow': (1, .77, .29),
    'brass': (.72, .45, .13), 'gold': (1, .67, .17),
    'gold_drip': (.96, .47, .055), 'iron': (.16, .17, .15),
    'rust': (.54, .22, .10), 'canvas': (.81, .66, .43),
    'cloth_red': (.67, .16, .105), 'cloth_cream': (.96, .87, .67),
    'paint_rose': (.69, .36, .31), 'paint_sage': (.43, .51, .32),
    'glass': (.67, .69, .54), 'window_lit': (1, .79, .40),
    'lantern_glow': (1, .56, .16), 'clock_face': (.98, .91, .73),
}
MATS, PARTS = {}, []
WOOD = ('wood', 'wood_weathered', 'wood_light', 'wood', 'wood_dark')
TAU = math.tau


def materials():
    for role in ROLES:
        mat = bpy.data.materials.new(role)
        mat.use_nodes = True
        mat.diffuse_color = (.5, .5, .5, 1)
        nodes = mat.node_tree.nodes
        nodes.clear()
        shader = nodes.new('ShaderNodeBsdfPrincipled')
        shader.inputs['Base Color'].default_value = (.5, .5, .5, 1)
        shader.inputs['Roughness'].default_value = .8
        shader.inputs['Metallic'].default_value = 0
        out = nodes.new('ShaderNodeOutputMaterial')
        mat.node_tree.links.new(shader.outputs['BSDF'], out.inputs['Surface'])
        MATS[role] = mat


def mesh(label, verts, faces, role, bevel=True):
    data = bpy.data.meshes.new(label)
    data.from_pydata(verts, [], faces)
    data.materials.append(MATS[role])
    data.update()
    obj = bpy.data.objects.new(label, data)
    bpy.context.collection.objects.link(obj)
    if bevel and role not in SOFT:
        mod = obj.modifiers.new('Worn 0.02m edges / two segments', 'BEVEL')
        mod.width, mod.segments = .02, 2
        mod.limit_method, mod.angle_limit = 'ANGLE', math.radians(45)
    PARTS.append(obj)
    return obj


def transform(obj, loc=(0, 0, 0), rot=(0, 0, 0)):
    obj.data.transform(Matrix.Translation(Vector(loc)) @
                       Euler(rot).to_matrix().to_4x4())
    return obj


def box(label, loc, size, role, rot=(0, 0, 0), bevel=True):
    x, y, z = (s / 2 for s in size)
    return transform(mesh(label,
        [(-x,-y,-z), (x,-y,-z), (x,y,-z), (-x,y,-z),
         (-x,-y,z), (x,-y,z), (x,y,z), (-x,y,z)],
        [(0,3,2,1), (4,5,6,7), (0,1,5,4), (1,2,6,5),
         (2,3,7,6), (3,0,4,7)], role, bevel), loc, rot)


def lathe(label, loc, rings, role, n=10, rot=(0, 0, 0), bevel=True):
    verts = [(r*math.cos(j*TAU/n), r*math.sin(j*TAU/n), z)
             for z, r in rings for j in range(n)]
    faces = [tuple(reversed(range(n)))]
    faces += [(k*n+j, k*n+(j+1)%n, (k+1)*n+(j+1)%n, (k+1)*n+j)
              for k in range(len(rings)-1) for j in range(n)]
    faces.append(tuple(range((len(rings)-1)*n, len(rings)*n)))
    return transform(mesh(label, verts, faces, role, bevel), loc, rot)


def cylinder(label, loc, radius, depth, role, n=12, rot=(0, 0, 0), bevel=True):
    return lathe(label, loc, [(-depth/2,radius), (depth/2,radius)],
                 role, n, rot, bevel)


def rod(label, a, b, radius, role, n=6, bevel=True):
    a, b = Vector(a), Vector(b)
    obj = cylinder(label, (0,0,0), radius, (b-a).length, role, n, bevel=bevel)
    obj.data.transform(Matrix.Translation((a+b)/2) @
                       (b-a).to_track_quat('Z','Y').to_matrix().to_4x4())
    return obj


def tube(label, points, radius, role, n=5):
    verts = []
    for i, point in enumerate(points):
        tangent = (Vector(points[min(i+1,len(points)-1)]) -
                   Vector(points[max(0,i-1)])).normalized()
        ref = Vector((0,1,0)) if abs(tangent.y) < .9 else Vector((1,0,0))
        u = ref.cross(tangent).normalized()
        v = tangent.cross(u)
        verts += [tuple(Vector(point)+radius*(u*math.cos(j*TAU/n)+v*math.sin(j*TAU/n)))
                  for j in range(n)]
    faces = [tuple(reversed(range(n)))]
    faces += [(k*n+j,k*n+(j+1)%n,(k+1)*n+(j+1)%n,(k+1)*n+j)
              for k in range(len(points)-1) for j in range(n)]
    faces.append(tuple(range((len(points)-1)*n,len(points)*n)))
    return mesh(label,verts,faces,role,bevel=False)


def extrude(label, polygon, depth, role, y=0, bevel=True):
    n = len(polygon)
    verts = [(x,y+d,z) for d in (-depth/2,depth/2) for x,z in polygon]
    faces = [tuple(reversed(range(n))), tuple(range(n,2*n))]
    faces += [(j,(j+1)%n,(j+1)%n+n,j+n) for j in range(n)]
    return mesh(label,verts,faces,role,bevel)


def ring(label, loc, radius, band, depth, role, n=24):
    verts = [(r*math.cos(j*TAU/n),y,r*math.sin(j*TAU/n))
             for r,y in ((radius-band,-depth/2),(radius,-depth/2),
                         (radius,depth/2),(radius-band,depth/2)) for j in range(n)]
    faces = [(k*n+j,k*n+(j+1)%n,((k+1)%4)*n+(j+1)%n,((k+1)%4)*n+j)
             for k in range(4) for j in range(n)]
    return transform(mesh(label,verts,faces,role),loc)


def scroll(loc, scale=.8, flip=1):
    x,y,z = loc
    points = []
    for i in range(15):
        t = i/14
        angle = -.65+t*TAU*1.1
        r = scale*(.45-.33*t)
        points.append((x+flip*r*math.cos(angle),y,z+r*math.sin(angle)))
    tube('Gold carved scroll',points,.045,'gold')


def dial(loc, radius, cracked=False, hour=10, minute=10):
    x,y,z = loc
    if cracked:
        # Two closed, physically separated halves expose a real lightning crack.
        for side in (-1,1):
            arc = [(x+radius*math.cos(a),z+radius*math.sin(a))
                   for a in [(-math.pi/2 if side==1 else math.pi/2)+j*math.pi/16
                             for j in range(17)]]
            zig = [(x+side*.045+dx*radius,z+zz*radius)
                   for dx,zz in ((0,1),(.06,.55),(-.12,.27),(.09,-.08),
                                 (-.07,-.5),(0,-1))]
            if side == 1:
                poly = arc+zig
            else:
                poly = arc+list(reversed(zig))
            extrude('Split ivory clock dial',poly,.12,'clock_face',y,False)
    else:
        cylinder('Ivory clock dial',loc,radius,.12,'clock_face',32,(math.pi/2,0,0))
    ring('Brass clock bezel',(x,y+.04,z),radius*1.12,radius*.12,.16,'brass',32)
    for i in range(12):
        a = i*TAU/12
        box('Gold numeral block',(x+radius*.81*math.sin(a),y+.13,
                                 z+radius*.81*math.cos(a)),
            (.075,.065,.16 if i%3==0 else .10),'gold',(0,a,0))
    for angle,length,width in (((hour+minute/60)*TAU/12,radius*.52,.085),
                               (minute*TAU/60,radius*.73,.065)):
        rod('Iron frozen clock hand',(x,y+.21,z),
            (x+math.sin(angle)*length,y+.21,z+math.cos(angle)*length),
            width/2,'iron')
    cylinder('Clock axle',(x,y+.235,z),.10,.09,'brass',10,(math.pi/2,0,0))


def drip(loc, length=.65):
    x,y,z = loc
    extrude('Sagging molten dial gold',
            [(x-.15,z+.07),(x+.16,z+.02),(x+.12,z-.19),
             (x+.07,z-length+.09),(x,z-length),(x-.06,z-length+.10),
             (x-.08,z-.26)],.095,'gold_drip',y)


def lantern(loc, scale=1):
    x,y,z = loc
    box('Lantern glowing bulb',(x,y,z),(.26*scale,.24*scale,.44*scale),'lantern_glow')
    for zz in (-.28,.28):
        box('Lantern iron cap',(x,y,z+zz*scale),(.40*scale,.36*scale,.10*scale),'iron')
    for xx in (-.17,.17):
        for yy in (-.15,.15):
            rod('Lantern cage',(x+xx*scale,y+yy*scale,z-.23*scale),
                (x+xx*scale,y+yy*scale,z+.23*scale),.025*scale,'brass')
    ring('Lantern hanging loop',(x,y,z+.41*scale),.12*scale,.045,.07,'iron',12)


def boardwalk(width, front, cx=0, gate=False):
    # Exactly 1.2m along the complete +Y frontage. The gate has no threshold
    # spanning its passage: only the two side landings receive boards/steps.
    intervals = [(-width/2,width/2)] if not gate else [(-4.35,-2.25),(2.25,4.35)]
    for lo,hi in intervals:
        n = max(1,round((hi-lo)/.48))
        for i in range(n):
            x = cx+lo+(i+.5)*(hi-lo)/n
            box('Front boardwalk / 1.2m deep',(x,front+.60,.14),
                ((hi-lo)/n-.025,1.2,.16),WOOD[i%len(WOOD)])
        box('Boardwalk front fascia',(cx+(lo+hi)/2,front+1.18,.12),
            (hi-lo,.09,.22),'wood_dark')
    for side in (-1,1):
        if gate:
            x,sw = side*3.3,1.9
        else:
            if side == -1:
                continue
            x,sw = 0,2.1
        box('Lower entrance step',(x,front+1.47,.045),(sw,.36,.09),'wood_weathered')
        box('Upper entrance step',(x,front+1.28,.11),(sw,.30,.10),'plank')


def door(front, width=1.45, height=2.5, double=False):
    box('Entrance dark reveal',(0,front+.025,.22+height/2),
        (width+.16,.16,height+.08),'wood_dark')
    n = 8 if double else 5
    for i in range(n):
        x = (i+.5)*width/n-width/2
        box('Closed entrance door board',(x,front+.14,.22+height/2),
            (width/n-.018,.15,height-.04),WOOD[(i+2)%len(WOOD)])
    for x in (-width/2-.09,width/2+.09):
        box('Door jamb',(x,front+.21,.22+height/2),(.16,.23,height+.22),'wood_light')
    box('Door carved lintel',(0,front+.22,height+.35),(width+.43,.26,.22),'wood_light')
    for side in (-1,1):
        for zz in (.75,height-.25):
            box('Iron strap hinge',(side*(width/2-.22),front+.245,zz),
                (.42,.07,.095),'iron')
            cylinder('Hinge pin',(side*(width/2-.045),front+.25,zz),.055,.22,'iron',8)
        if double or side == 1:
            knobx = side*(.14 if double else width*.29)
            cylinder('Brass knob backplate',(knobx,front+.25,1.35),.10,.055,'brass',10,
                     (math.pi/2,0,0))
            cylinder('Brass door knob',(knobx,front+.32,1.35),.075,.11,'brass',10,
                     (math.pi/2,0,0))
    if double:
        box('Barn centre stile',(0,front+.24,.22+height/2),(.085,.09,height),'iron')
        for side in (-1,1):
            rod('Barn diagonal door brace',(side*.12,front+.25,.42),
                (side*(width/2-.14),front+.25,height+.04),.07,'wood_light')


def window(label, u, y, z, width=1.3, height=1.55, shutters=False,
           trim='wood_light', side=0):
    """Build locally facing +Y, optionally rotate onto a side or rear wall."""
    start = len(PARTS)
    box(label+' lit inset',(0,0,0),(width,.08,height),'window_lit')
    for x in (-width/2,width/2):
        box(label+' upright',(x,.075,0),(.13,.16,height+.20),trim)
    for zz in (-height/2,height/2):
        box(label+' lintel sill',(0,.09,zz),(width+.24,.22,.13),trim)
    box(label+' mullion',(0,.12,0),(.07,.12,height),'wood_dark')
    box(label+' crossbar',(0,.12,0),(width,.12,.07),'wood_dark')
    if shutters:
        for s in (-1,1):
            box('Rose shutter',(s*(width/2+.29),0,0),(.40,.12,height),'paint_rose')
            for zz in (-height*.30,height*.30):
                box('Shutter carved rail',(s*(width/2+.29),.08,zz),(.42,.08,.085),'cloth_cream')
    for obj in PARTS[start:]:
        transform(obj,(u,y,z),(0,0,side))


def snapped_plank(label, a, b, width=.23, depth=.15, role='wood_light'):
    """A capped, chunky splinter; its unbroken end is embedded in a support."""
    a,b = Vector(a),Vector(b)
    length = (b-a).length
    obj = extrude(label,[(-width/2,0),(width/2,0),(width/2,length-.16),
                        (width*.12,length-.16),(width*.12,length),
                        (-width*.14,length-.08),(-width/2,length-.08)],
                  depth,role)
    obj.data.transform(Matrix.Translation(a) @
                       (b-a).to_track_quat('Z','Y').to_matrix().to_4x4())
    return obj


def wall_crack(front, x, top, length=.80, labels=('Alternating wall plank',)):
    """Cut a shallow stepped groove, then put dark wood inside the recess."""
    poly = [(x-.045,top),(x+.045,top),(x+.045,top-length*.30),
            (x+.15,top-length*.30),(x+.15,top-length*.59),
            (x+.065,top-length*.59),(x+.065,top-length),
            (x-.015,top-length),(x-.015,top-length*.51),
            (x+.055,top-length*.51),(x+.055,top-length*.39),
            (x-.045,top-length*.39)]
    cutter = extrude('Temporary inset crack cutter',poly,.15,'wood_dark',front+.09,False)
    PARTS.remove(cutter)
    for obj in list(PARTS):
        if not any(obj.name.startswith(label) for label in labels):
            continue
        lo,hi = bounds(obj)
        if hi.x<x-.05 or lo.x>x+.16 or hi.z<top-length or lo.z>top:
            continue
        if lo.y>front+.16 or hi.y<front-.01:
            continue
        bpy.context.view_layer.objects.active = obj
        mod = obj.modifiers.new('Recessed age crack','BOOLEAN')
        mod.operation,mod.solver,mod.object = 'DIFFERENCE','EXACT',cutter
        # Cut before the worn-edge bevel; retain a closed back to the groove.
        bpy.ops.object.modifier_move_up(modifier=mod.name)
        bpy.ops.object.modifier_apply(modifier=mod.name)
    bpy.data.objects.remove(cutter,do_unlink=True)
    extrude('Dark recessed age crack',poly,.025,'wood_dark',front+.012,False)


def corner_top(x, y, width, front, height, cx=0):
    """Three broad stair steps remove the upper +X / front corner."""
    dx,dy = cx+width/2-x,front-y
    if dx < 1.85 and dy < 1.95:
        loss = (.62 if dx > 1.28 else 1.18 if dx > .65 else 1.85)
        loss += .22 if dy < .68 else 0
        return height-loss
    return height


def wall_boards(length, height, loc, rotation, holes, paint=None, ceiling=None):
    """Closed thick wall boards split around true window and door openings.

    holes are (horizontal centre, bottom, width, height) in wall-local space.
    """
    n = math.ceil(length/.54)
    pitch = length/n
    for i in range(n):
        u = -length/2+(i+.5)*pitch
        # Clip each board exactly at the opening edges; dropping an entire
        # intersecting board would leave visible slits beside the window frame.
        world = Vector(loc)+Euler((0,0,rotation)).to_matrix() @ Vector((u,0,0))
        top = ceiling(world.x,world.y) if ceiling else height
        rectangles = [(u-pitch/2+.011,u+pitch/2-.011,.24,top)]
        for hu,hz,hw,hh in holes:
            cut = []
            for left,right,a,b in rectangles:
                l,r = max(left,hu-hw/2),min(right,hu+hw/2)
                low,high = max(a,hz),min(b,hz+hh)
                if l>=r or low>=high:
                    cut.append((left,right,a,b))
                    continue
                cut += [(left,l,a,b),(r,right,a,b),(l,r,a,low),(l,r,high,b)]
            rectangles = [(l,r,a,b) for l,r,a,b in cut if r-l>.005 and b-a>.005]
        for left,right,a,b in rectangles:
            role = paint if paint and i%4 != 0 else WOOD[i%len(WOOD)]
            obj = box('Alternating wall plank',((left+right)/2,0,(a+b)/2),
                      (right-left,.15,b-a),role)
            transform(obj,loc,(0,0,rotation))


def shell(width, depth, height, front_holes, paint=None, cx=0):
    front,back = depth/2-1.6,-depth/2
    center = (front+back)/2
    ceiling = lambda x,y: corner_top(x,y,width,front,height,cx)
    sideholes = [(center+.65,1.55,1.25,1.5)]
    if height > 6:
        sideholes += [(center-.9,4.55,1.25,1.5)]
    # All four elevations are built rather than a solid cube with facade plates.
    wall_boards(width,height,(cx,front,0),0,
                [(u-cx,z,w,h) for u,z,w,h in front_holes],paint,ceiling)
    rearholes = [(-width*.25,1.55,1.2,1.5),(width*.25,1.55,1.2,1.5)]
    if height > 6:
        rearholes += [(-width*.25,4.55,1.2,1.5),(width*.25,4.55,1.2,1.5)]
    wall_boards(width,height,(cx,back,0),math.pi,rearholes,paint,ceiling)
    for s in (-1,1):
        # Local u maps to world Y with the appropriate sign.
        holes = [((center-u)*s,z,w,h) for u,z,w,h in sideholes]
        wall_boards(front-back,height,(cx+s*width/2,center,0),-s*math.pi/2,holes,paint,ceiling)
        for u,z,w,h in sideholes:
            window('Side window',cx+s*(width/2+.08),u,z+h/2,w,h,
                   trim='cloth_cream' if paint else 'wood_light',side=-s*math.pi/2)
    for u,z,w,h in rearholes:
        window('Rear window',cx-u,back-.09,z+h/2,w,h,trim='wood_light',side=math.pi)
    box('Stone footing',(cx,center,.12),(width+.12,front-back+.12,.24),'stone_dark')
    box('Ground floor',(cx,center,.23),(width,front-back,.12),'plank')
    for x in (cx-width/2,cx+width/2):
        for y in (front,back):
            top = ceiling(x,y)
            box('Surviving corner post',(x,y,top/2),(.24,.25,top),'wood_dark')
            box('Corner painted inset',(x,y+.14,top/2),(.12,.07,top-.28),
                'cloth_cream' if paint else 'wood_light')
    for z in (.38,height-.12):
        for y in (front+.10,back-.10):
            lost = 1.95 if z>height/2 and y>front-.2 else 0
            box('Front and rear trim band',(cx-lost/2,y,z),(width+.18-lost,.17,.17),
                'cloth_cream' if paint else 'wood_light')
        for x in (cx-width/2-.08,cx+width/2+.08):
            lost = 2.04 if z>height/2 and x>cx else 0
            box('Side trim band',(x,center-lost/2,z),(.15,front-back-lost,.17),
                'cloth_cream' if paint else 'wood_light')
    # Dark loft is well BELOW the missing roof, never a patch over the hole.
    box('Unlit loft floor exposed through ruin',(cx,center,height-2.25),
        (width-.36,front-back-.30,.16),'wood_dark')
    x = cx+width/2
    snapped_plank('Snapped corner upright',(x,front,height-2.30),
                  (x-.30,front-.12,height-1.35),.24,.22,'wood_weathered')
    snapped_plank('Exposed fractured wall header',(x-2.15,front,height-.36),
                  (x-1.02,front-.18,height-.68),.22,.20)
    rod('Exposed corner diagonal',(x-.17,front-.18,height-2.15),
        (x-1.75,front-.22,height-.76),.095,'wood_dark')
    return front,back


def roof(width, front, back, eave, rise, role, cx=0):
    half = width/2+.22
    run = math.sqrt(half*half+rise*rise)
    angle = math.atan2(rise,half)
    # Two deliberately large voids: a ragged roof crater and the torn-away
    # front-right corner. All remaining tiles bear on rafters or neighbours.
    rows,columns = 7,8
    def missing(side,i,j):
        # The wound runs from an interrupted eave over the ridge. Its size
        # reads at the game camera, rather than as a few missing shingles.
        crater_rows = ((3,4),(2,5),(1,6),(1,6),(2,6),(3,6),(3,5))
        lo,hi = crater_rows[i]
        crater = side == -1 and lo<=j<=hi
        ridge = side == 1 and ((i==5 and 3<=j<=4) or (i==6 and 3<=j<=5))
        corner = side == 1 and i<4 and j >= (5,6,6,7)[i]
        return crater or ridge or corner
    for side in (-1,1):
        for i in range(rows):
            t = (i+.5)/rows
            for j in range(columns):
                if missing(side,i,j):
                    continue
                y = back-.22+(j+.5)*(front-back+.44)/columns
                x,z = cx+side*half*(1-t),eave+rise*t
                box('Overlapping roof panel',(x,y,z),
                    (run/rows+.035,(front-back+.44)/columns-.025,.13),role,
                    (0,side*angle,0))
                if role == 'roof_tin' and i in (0,5):
                    box('Standing tin seam',(x,y,z+.075),
                        (run/rows,.055,.055),'rust',(0,side*angle,0))
        if side==1:
            box('Broken corner eave fascia',(cx+half,(front+back-2.45)/2,eave-.05),
                (.18,front-back+.60-2.45,.23),'wood_light')
        else:
            pitch = (front-back+.44)/columns
            for lo,hi in ((back-.30,back-.22+3*pitch),
                          (back-.22+5*pitch,front+.30)):
                box('Crater interrupted eave fascia',(cx-half,(lo+hi)/2,eave-.05),
                    (.18,hi-lo,.23),'wood_light')
        for y in (back+.35,(front+back)/2,front-1.85):
            rod('Roof triangular rafter',(cx+side*half,y,eave-.14),
                (cx+side*.16,y,eave+rise-.16),.105,'wood_dark')
    box('Exposed ridge backbone',(cx,(front+back)/2,eave+rise-.18),
        (.24,front-back+.15,.30),'wood_dark')
    for t in (.31,.66):
        box('Exposed roof purlin',(cx-half*(1-t),(front+back)/2,eave+rise*t-.18),
            (.18,front-back-.25,.22),'wood_weathered')
    snapped_plank('Roof crater snapped rafter',
                  (cx-half,back+(front-back)*.45,eave-.14),
                  (cx-half*.55,back+(front-back)*.45,eave+rise*.39),.25,.18)
    snapped_plank('Attached roof plank hanging into crater',
                  (cx-half*.29,back+(front-back)*.62,eave+rise*.72),
                  (cx-half*.50,back+(front-back)*.58,eave+rise*.24),.30,.13,
                  'wood_weathered')
    # The front gable is physically missing its right-hand stair-step corner.
    for y in (back-.02,front+.02):
        poly = [(cx-width/2,eave-.16),(cx+width/2,eave-.16),(cx,eave+rise-.18)]
        if y>front:
            poly = [(cx-width/2,eave-.16),(cx+width*.10,eave-.16),
                    (cx+width*.10,eave+.20),(cx+width*.24,eave+.20),
                    (cx+width*.24,eave+rise*.45),(cx,eave+rise-.18)]
        extrude('Ragged front / surviving rear gable',poly,.16,
                'wood_weathered',y)
        for side in (-1,1):
            if y>front and side==1:
                continue
            rod('Surviving gable rake trim',(cx+side*half,y,eave),
                (cx+side*.12,y,eave+rise-.06),.075,'wood_light')
    for j in (0,2):
        box('Interrupted ridge cap',(cx,back+(j+.5)*(front-back)/4,eave+rise),
            (.30,(front-back)/4-.08,.16),'brass')


def crest(width, front, base, crown, paint='wood_light', cx=0):
    # Jagged stepped skyline keeps the crumbling edge on the building itself.
    n = math.ceil(width/.57)
    for i in range(n):
        x = -width/2+(i+.5)*width/n
        profile = 1-abs(x)/(width/2)
        top = base+(crown-base)*(.54+.46*profile)
        if x > width*.29:
            continue
        if x > width*.16:
            top = base+(.24 if i%2 else .53)
        if i%5 == 1:
            top -= .32
        box('Broken false-front crest board',(cx+x,front+.06,(base+top)/2),
            (width/n-.024,.22,top-base),paint if i%3 else 'wood_weathered')
        if i%5 != 1:
            box('Interrupted crest crown molding',(cx+x,front+.10,top+.015),
                (width/n+.015,.32,.11),'gold' if i%3==0 else 'wood_light')
    surviving = width*.77
    middle = cx-width*.115
    box('Fractured false-front cornice',(middle,front+.13,base+.11),
        (surviving+.26,.36,.23),'wood_dark')
    box('Broken cornice gold line',(middle,front+.34,base+.16),
        (surviving+.34,.07,.07),'gold')
    for i in range(max(3,round(width/.65))):
        x = cx-width*.46+i*width*.92/(max(3,round(width/.65))-1)
        if x>cx+width*.25:
            continue
        box('Cornice dentil',(x,front+.24,base-.12),(.16,.28,.24),'wood_light')
    for side in (-1,1):
        if side == -1:
            scroll((cx+side*width*.34,front+.25,base+.74),.9,side)
    snapped_plank('Crest snapped backing spar',(cx+width*.12,front-.08,base+.22),
                  (cx+width*.28,front-.08,base+.53),.22,.18,'wood_dark')


def porch(front, width=2.5, height=3.05):
    box('Little entrance awning',(0,front+.63,height),(width,1.30,.16),
        'roof_shingle',(-math.radians(7),0,0))
    box('Porch carved front fascia',(0,front+1.23,height-.10),(width,.14,.24),'wood_light')
    for side in (-1,1):
        x = side*(width/2-.14)
        box('Porch post',(x,front+1.13,(height+.22)/2),(.13,.14,height-.22),'wood_dark')
        rod('Porch angled bracket',(x,front+1.12,height-.65),
            (x,front+.67,height-.10),.065,'wood_light')


def sign_bracket(x, front, z, reach=1):
    box('Iron hanging sign wall plate',(x,front+.13,z-.22),(.16,.13,.74),'iron')
    rod('Iron sign bracket',(x,front+.16,z),(x,front+reach,z),.055,'iron')
    rod('Iron bracket diagonal',(x,front+.18,z-.46),(x,front+reach*.80,z),.045,'iron')
    for yy in (front+reach*.5,front+reach*.91):
        rod('Hanging sign chain',(x,yy,z-.03),(x,yy,z-.37),.025,'iron')
    return front+reach*.75,z-.60


def chimney(x, y, bottom, top):
    for row in range(max(1,round((top-bottom)/.32))):
        z = bottom+.16+row*.32
        for j in range(2):
            xx = x+(j-.5)*.42
            box('Chimney staggered masonry',(xx+(row%2)*.035,y,z),
                (.40,.72,.30),'stone' if (row+j)%3 else 'stone_dark')
    box('Rust chimney lip',(x,y,top+.05),(.98,.90,.16),'rust')
    box('Open chimney dark flue',(x,y,top+.15),(.62,.54,.07),'stone_dark')


def inn():
    w,d,h = 10.4,8,6.55
    front_holes = [(0,.22,1.5,2.5)]
    front_holes += [(x,1.5,1.45,1.65) for x in (-3.4,3.4)]
    front_holes += [(x,4.55,1.2,1.55) for x in (-3.4,-1.15,1.15,3.4)]
    f,b = shell(w,d,h,front_holes)
    roof(w,f,b,h,1.25,'roof_shingle')
    crest(w,f,h,8.55,'paint_rose')
    boardwalk(w,f)
    door(f)
    for x in (-3.4,3.4):
        window('Inn ground window',x,f+.11,2.325,1.45,1.65,True)
    for x in (-3.4,-1.15,1.15):
        window('Inn second floor window',x,f+.11,5.325,1.2,1.55,True)
    # Full-width second-storey balcony doubles as the entrance porch roof.
    for i in range(19):
        if i<3:
            continue
        box('Balcony floorboard',(-4.9+(i+.5)*9.8/19,f+.68,3.58),
            (9.8/19-.018,1.35,.14),WOOD[i%len(WOOD)])
    for x in (-4.85,-2.4,2.4,4.85):
        box('Balcony lower support post',(x,f+1.14,1.91),(.18,.18,3.36),'wood_dark')
        rod('Balcony corbel',(x,f+1.13,2.96),(x,f+.57,3.53),.09,'wood_light')
    for x in (-4.85,-2.4,0,2.4,4.85):
        if x == -4.85:
            continue
        box('Balcony railing newel',(x,f+1.25,4.14),(.18,.18,1.14),'paint_rose')
        cylinder('Balcony brass post cap',(x,f+1.25,4.76),.12,.10,'brass',8)
    for i in range(25):
        if i<4:
            continue
        box('Balcony railing baluster',(-4.75+i*9.5/24,f+1.25,4.12),(.065,.075,.85),'wood_light')
    for z in (3.76,4.61):
        box('Balcony surviving front rail',(.80,f+1.25,z),(8.35,.14,.12),'wood_dark')
        for side in (-1,1):
            if side==-1:
                continue
            box('Balcony return rail',(side*4.87,f+.66,z),(.12,1.22,.12),'wood_dark')
            for yy in (.3,.65,1.0):
                box('Balcony return baluster',(side*4.87,f+yy,4.14),(.07,.07,.85),'wood_light')
    snapped_plank('Balcony snapped floor joist',(-2.45,f+.90,3.48),
                  (-3.82,f+.94,3.22),.24,.19,'wood_dark')
    snapped_plank('Balcony attached dangling railing',(-3.17,f+1.25,4.61),
                  (-3.69,f+1.12,3.94),.16,.14,'wood_weathered')
    snapped_plank('Balcony fractured deck end',(-3.18,f+.05,3.58),
                  (-3.35,f+.88,3.40),.34,.14)
    # Cuckoo-house is a large relief volume embedded in the crest.
    cy = f+.49
    extrude('Cuckoo clock carved wooden house',
            [(-1.05,6.65),(1.05,6.65),(1.05,7.76),(0,8.40),(-1.05,7.76)],
            .52,'wood_dark',cy)
    for s in (-1,1):
        rod('Cuckoo gable gold rake',(s*1.19,cy+.30,7.76),(0,cy+.30,8.50),.075,'gold')
    dial((0,cy+.31,7.20),.48,hour=6,minute=30)
    for s in (-1,1):
        box('Closed tiny cuckoo door',(s*.14,cy+.32,7.96),(.25,.11,.33),'wood_light')
        box('Cuckoo tiny door iron hinge',(s*.23,cy+.39,7.96),(.065,.05,.12),'iron')
        # Three broad alternating pine-cone tiers read at the game camera.
        x = s*.70
        rod('Pine cone weight chain',(x,cy+.35,6.76),(x,cy+.35,5.82),.025,'brass')
        for j in range(4):
            z = 5.64+j*.13
            lathe('Carved pine cone weight',(x,cy+.35,z),
                  [(-.06,.06),(.02,.14-j*.012),(.12,.065)],'wood_dark',8)
    for s in (-1,1):
        scroll((-2.05 if s==-1 else 1.30,f+.34,7.25),1.10,s)
    sy,sz = sign_bracket(4.35,f,3.15,.92)
    # A blank, chunky carved board: intentionally no lettering.
    start = len(PARTS)
    poly = [(-.62,-.34),(.50,-.34),(.70,-.10),(.62,.30),(-.48,.38),(-.71,.12)]
    extrude('Inn blank carved hanging board',poly,.16,'wood_dark')
    for i in range(len(poly)):
        a,c = poly[i],poly[(i+1)%len(poly)]
        rod('Inn sign gold frame',(a[0],.105,a[1]),(c[0],.105,c[1]),.055,'gold')
    for obj in PARTS[start:]:
        transform(obj,(4.35,sy,sz),(0,0,math.pi/5))
    for x in (-1.05,1.05):
        lantern((x,f+.40,2.60),.7)
    chimney(-3.2,b+1.25,6.95,8.10)
    drip((1.15,f+.35,7.03),.53)
    wall_crack(f,4.12,4.25,.72)
    wall_crack(f,-4.39,6.12,.64)


def rifle(loc, scale=1):
    x,y,z = loc
    box('Rifle walnut stock',(x-.10*scale,y,z-.42*scale),
        (.16*scale,.12,.46*scale),'wood_dark',(0,-.15,0))
    box('Rifle fore stock',(x,y,z),(.13*scale,.13,.55*scale),'wood_dark')
    rod('Rifle iron barrel',(x,y,z-.1*scale),(x,y,z+.85*scale),.035*scale,'iron')
    box('Rifle receiver',(x,y+.045,z-.18*scale),(.22*scale,.09,.17*scale),'iron')
    ring('Rifle trigger guard',(x-.02*scale,y+.09,z-.33*scale),.095*scale,.04,.06,'iron',10)


def revolver_sign(x, y, z):
    # True revolver silhouette with barrel, six-shot cylinder and angled grip.
    poly = [(-1.18,.25),(.42,.25),(.60,.12),(.63,-.10),(.42,-.25),
            (.62,-.88),(.19,-1.0),(-.04,-.28),(-.44,-.19),(-.44,.04),(-1.18,.04)]
    extrude('Oversize revolver iron silhouette',[(x+a,z+c) for a,c in poly],
            .20,'iron',y)
    extrude('Revolver wood grip',[(x+.12,z-.24),(x+.40,z-.27),
            (x+.55,z-.82),(x+.25,z-.90)],.245,'wood',y)
    box('Revolver long barrel',(x-.54,y,z+.16),(1.44,.25,.19),'iron')
    box('Revolver gold barrel inlay',(x-.54,y+.15,z+.18),(1.32,.055,.045),'gold')
    cylinder('Revolver fluted cylinder',(x-.13,y+.10,z-.005),.265,.20,'iron',12,(math.pi/2,0,0))
    for i in range(6):
        a = i*TAU/6
        cylinder('Revolver cylinder brass chamber',(x-.13+.17*math.cos(a),y+.22,z+.17*math.sin(a)),
                 .045,.04,'gold',6,(math.pi/2,0,0))
    ring('Revolver gold trigger guard',(x+.19,y+.13,z-.30),.22,.055,.10,'gold',16)
    box('Revolver hammer',(x+.46,y,z+.22),(.17,.15,.19),'iron',(0,.25,0))
    cylinder('Grip gold rivet',(x+.34,y+.15,z-.60),.065,.05,'gold',8,(math.pi/2,0,0))


def gunshop():
    w,d,h = 8.5,7,4.65
    holes = [(0,.22,1.45,2.5),(-2.65,1.1,2.6,1.9),(2.75,1.5,1.25,1.6)]
    f,b = shell(w,d,h,holes)
    roof(w,f,b,h,.95,'roof_tin')
    crest(w,f,h,6.80,'wood_light')
    boardwalk(w,f)
    door(f)
    window('Gun display',-2.65,f+.35,2.05,2.6,1.9)
    for x in (-3.95,-1.35):
        box('Display projecting jamb return',(x,f+.18,2.05),(.13,.37,2.1),'wood_light')
    for zz in (1.10,3.0):
        box('Display projecting sill return',(-2.65,f+.18,zz),(2.72,.37,.13),'wood_light')
