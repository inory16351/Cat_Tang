+    box('Long canopy front girder', (0, 1.24, 4.69), (7.90, 0.20, 0.23), 'iron', bevel='FRONT')
+    sloped_roof(8, rear, front, 5.23, 4.82, ribs=7)
+    # Lantern sits between columns, clear of the central shaft.
