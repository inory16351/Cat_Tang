+    for dx, dy in ((-0.19, -0.19), (-0.19, 0.19), (0.19, -0.19), (0.19, 0.19)):
+        rod('Lantern cage upright', (x + dx, y + dy, 2.87),
+            (x + dx, y + dy, 3.44), 0.025, 'iron', sides=4)
