+    box('Projecting pulley beam', (0, 0.47, 5.51), (0.25, 2.42, 0.28), 'wood', bevel='FRONT')
+    beam('Pulley beam diagonal support', (0, 0.10, 4.68), (0, 1.32, 5.40), 0.14, 'iron')
+    arc('Suspended pulley wheel', 0, 5.06, 0.15, 0.25, 1.36, 1.50,
