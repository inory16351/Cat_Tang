+    bpy.context.view_layer.update()
+    assert triangles(obj) <= 6000, (name,triangles(obj))
+    assert obj.location.length < 1e-6 and tuple(obj.scale) == (1,1,1)
+    assert abs(obj.dimensions.x-3.2)<1e-4 and abs(obj.dimensions.y-10)<1e-4
