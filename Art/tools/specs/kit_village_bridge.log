+        assert not any(p.role == 'lantern_glow' for p in PARTS)
+    buckets = defaultdict(list)
+    for part in PARTS:
+        buckets[(part.role,part.bevel)].append(part)
+    objects = []
+    for (role,bevel),parts in buckets.items():
+        verts,faces = [],[]
+        for part in parts:
+            offset = len(verts)
+            verts.extend(part.verts)
