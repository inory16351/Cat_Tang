    assert abs(lo.z) < 1e-5 and abs(lo.x+hi.x) < 1e-5 and abs(lo.y+hi.y) < 1e-5, name
    assert obj.location.length < 1e-6, name+' misplaced origin'
    assert all(math.isfinite(c) for v in obj.data.vertices for c in v.co), name
    if name == 'Fence':
