+                verts[end*4+k if end == 0 else len(verts)-4+k][0],
+                (a if end == 0 else b) + (1 if a > 0 else -1)*(.02,.12,.04,.16)[k],
+                verts[end*4+k if end == 0 else len(verts)-4+k][2])
