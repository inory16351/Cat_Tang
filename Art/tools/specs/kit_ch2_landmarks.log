+                         'iron_dark', n=10, rot=(math.pi / 2, 0, 0), bevel=False)
+    box('Wood carriage floor top 0.5m', (0, -.13, .425), (9.6, 2.82, .15), 'wood')
+    for x in [-4.9, 4.9]:
