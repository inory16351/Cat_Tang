+            for zz in (-height*.30,height*.30):
+                box('Shutter carved rail',(s*(width/2+.29),.08,zz),(.42,.08,.085),'cloth_cream')
+    for obj in PARTS[start:]:
+        transform(obj,(u,y,z),(0,0,side))
+
+
+def wall_boards(length, height, loc, rotation, holes, paint=None):
+    """Closed thick wall boards split around true window and door openings.
+
+    holes are (horizontal centre, bottom, width, height) in wall-local space.
+    """
+    n = math.ceil(length/.54)
+    pitch = length/n
+    for i in range(n):
+        u = -length/2+(i+.5)*pitch
+        # Clip each board exactly at the opening edges; dropping an entire
+        # intersecting board would leave visible slits beside the window frame.
+        rectangles = [(u-pitch/2+.011,u+pitch/2-.011,.24,height)]
+        for hu,hz,hw,hh in holes:
+            cut = []
+            for left,right,a,b in rectangles:
+                l,r = max(left,hu-hw/2),min(right,hu+hw/2)
+                low,high = max(a,hz),min(b,hz+hh)
+                if l>=r or low>=high:
+                    cut.append((left,right,a,b))
+                    continue
+                cut += [(left,l,a,b),(r,right,a,b),(l,r,a,low),(l,r,high,b)]
+            rectangles = [(l,r,a,b) for l,r,a,b in cut if r-l>.005 and b-a>.005]
+        for left,right,a,b in rectangles:
+            role = paint if paint and i%4 != 0 else WOOD[i%len(WOOD)]
+            obj = box('Alternating wall plank',((left+right)/2,0,(a+b)/2),
+                      (right-left,.15,b-a),role)
+            transform(obj,loc,(0,0,rotation))
+
+
+def shell(width, depth, height, front_holes, paint=None, cx=0):
+    front,back = depth/2-1.6,-depth/2
+    center = (front+back)/2
+    sideholes = [(center+.65,1.55,1.25,1.5)]
+    if height > 6:
+        sideholes += [(center-.9,4.55,1.25,1.5)]
+    # All four elevations are built rather than a solid cube with facade plates.
+    wall_boards(width,height,(cx,front,0),0,
+                [(u-cx,z,w,h) for u,z,w,h in front_holes],paint)
+    rearholes = [(-width*.25,1.55,1.2,1.5),(width*.25,1.55,1.2,1.5)]
+    if height > 6:
+        rearholes += [(-width*.25,4.55,1.2,1.5),(width*.25,4.55,1.2,1.5)]
+    wall_boards(width,height,(cx,back,0),math.pi,rearholes,paint)
+    for s in (-1,1):
+        # Local u maps to world Y with the appropriate sign.
+        holes = [((center-u)*s,z,w,h) for u,z,w,h in sideholes]
+        wall_boards(front-back,height,(cx+s*width/2,center,0),-s*math.pi/2,holes,paint)
+        for u,z,w,h in sideholes:
+            window('Side window',cx+s*(width/2+.08),u,z+h/2,w,h,
+                   trim='cloth_cream' if paint else 'wood_light',side=-s*math.pi/2)
+    for u,z,w,h in rearholes:
+        window('Rear window',cx-u,back-.09,z+h/2,w,h,trim='wood_light',side=math.pi)
+    box('Stone footing',(cx,center,.12),(width+.12,front-back+.12,.24),'stone_dark')
+    box('Ground floor',(cx,center,.23),(width,front-back,.12),'plank')
+    for x in (cx-width/2,cx+width/2):
+        for y in (front,back):
+            box('Full height corner post',(x,y,height/2),(.24,.25,height),'wood_dark')
+            box('Corner painted inset',(x,y+.14,height/2),(.12,.07,height-.28),
+                'cloth_cream' if paint else 'wood_light')
+    for z in (.38,height-.12):
+        for y in (front+.10,back-.10):
+            box('Front and rear trim band',(cx,y,z),(width+.18,.17,.17),
+                'cloth_cream' if paint else 'wood_light')
+        for x in (cx-width/2-.08,cx+width/2+.08):
+            box('Side trim band',(x,center,z),(.15,front-back,.17),
+                'cloth_cream' if paint else 'wood_light')
+    return front,back
+
+
+def roof(width, front, back, eave, rise, role, cx=0):
+    half = width/2+.22
+    run = math.sqrt(half*half+rise*rise)
+    angle = math.atan2(rise,half)
+    # Solid lower pitches; a few ridge tiles detach, exposing broken rafters.
+    for side in (-1,1):
+        for i in range(5):
+            t = (i+.5)/5
+            for j in range(4):
+                if i==4 and j in ((1,3) if side==1 else (0,2)):
+                    continue
+                y = back-.22+(j+.5)*(front-back+.44)/4
+                x,z = cx+side*half*(1-t),eave+rise*t
+                box('Overlapping roof panel',(x,y,z),
+                    (run/5+.055,(front-back+.44)/4-.025,.13),role,
+                    (0,side*angle,0))
+                if role == 'roof_tin' and i in (0,2):
+                    box('Standing tin seam',(x,y,z+.075),
+                        (run/5,.055,.055),'rust',(0,side*angle,0))
+        box('Eave fascia',(cx+side*half,(front+back)/2,eave-.05),
+            (.18,front-back+.60,.23),'wood_light')
+        for y in (back+.35,(front+back)/2,front-.25):
+            rod('Roof triangular rafter',(cx+side*half,y,eave-.14),
+                (cx+side*.16,y,eave+rise-.16),.07,'wood_dark')
+    # Front and rear closed gables, with separate trim and real depth.
+    for y in (back-.02,front+.02):
+        extrude('Complete roof gable',[(cx-width/2,eave-.16),
+                (cx+width/2,eave-.16),(cx,eave+rise-.18)],.16,
+                'wood_weathered',y)
+        for side in (-1,1):
+            rod('Gable rake trim',(cx+side*half,y,eave),
+                (cx+side*.12,y,eave+rise-.06),.075,'wood_light')
+    for j in (0,2):
+        box('Interrupted ridge cap',(cx,back+(j+.5)*(front-back)/4,eave+rise),
+            (.30,(front-back)/4-.08,.16),'brass')
+
+
+def crest(width, front, base, crown, paint='wood_light', cx=0):
+    # Jagged stepped skyline: the absent upper boards reappear in the fragments.
+    n = math.ceil(width/.57)
+    for i in range(n):
+        x = -width/2+(i+.5)*width/n
+        profile = 1-abs(x)/(width/2)
+        top = base+(crown-base)*(.54+.46*profile)
+        if i%5 == 1:
+            top -= .32
+        box('Broken false-front crest board',(cx+x,front+.06,(base+top)/2),
+            (width/n-.024,.22,top-base),paint if i%3 else 'wood_weathered')
+        if i%5 != 1:
+            box('Interrupted crest crown molding',(cx+x,front+.10,top+.015),
+                (width/n+.015,.32,.11),'gold' if i%3==0 else 'wood_light')
+    box('False-front cornice',(cx,front+.13,base+.11),(width+.26,.36,.23),'wood_dark')
+    box('Cornice gold line',(cx,front+.34,base+.16),(width+.34,.07,.07),'gold')
+    for i in range(max(3,round(width/.65))):
+        x = cx-width*.46+i*width*.92/(max(3,round(width/.65))-1)
+        box('Cornice dentil',(x,front+.24,base-.12),(.16,.28,.24),'wood_light')
+    for side in (-1,1):
+        scroll((cx+side*width*.34,front+.25,base+.74),.9,side)
+
+
+def porch(front, width=2.5, height=3.05):
+    box('Little entrance awning',(0,front+.63,height),(width,1.30,.16),
+        'roof_shingle',(-math.radians(7),0,0))
+    box('Porch carved front fascia',(0,front+1.23,height-.10),(width,.14,.24),'wood_light')
+    for side in (-1,1):
+        x = side*(width/2-.14)
+        box('Porch post',(x,front+1.13,(height+.22)/2),(.13,.14,height-.22),'wood_dark')
+        rod('Porch angled bracket',(x,front+1.12,height-.65),
+            (x,front+.67,height-.10),.065,'wood_light')
+
+
+def sign_bracket(x, front, z, reach=1):
+    box('Iron hanging sign wall plate',(x,front+.13,z-.22),(.16,.13,.74),'iron')
+    rod('Iron sign bracket',(x,front+.16,z),(x,front+reach,z),.055,'iron')
+    rod('Iron bracket diagonal',(x,front+.18,z-.46),(x,front+reach*.80,z),.045,'iron')
+    for yy in (front+reach*.5,front+reach*.91):
+        rod('Hanging sign chain',(x,yy,z-.03),(x,yy,z-.37),.025,'iron')
+    return front+reach*.75,z-.60
+
+
+def dissolve(width, back, front, start, top, roles, cx=0, clock_bits=False):
+    """Four rising layers, decreasing count/size; all above the solid 2/3.
+
+    Front and rear source tiles participate so the effect reads all around.
+    The topmost speck fixes the intended height without scaling entrances.
+    """
+    for layer,count in enumerate((15,11,7,4)):
+        f = layer/3
+        size = .44*(1-.67*f)
+        zbase = start+(top-start-.20)*f
+        for i in range(count):
+            x = cx+random.uniform(-width*.46,width*.46)
+            y = random.choice((front,back,(front+back)/2))+random.uniform(-.22,.22)
+            z = min(top-.16,zbase+random.uniform(0,.19))
+            if clock_bits and i%4==0:
+                gear((x,y,z),size*.65,'brass',8,
+                     (random.uniform(-.35,.35),random.uniform(-.3,.3),0))
+            else:
+                box('Floating broken plank / shingle',(x,y,z),
+                    (size*random.uniform(.8,1.5),size*.65,size*.32),
+                    roles[i%len(roles)],
+                    (random.uniform(-.5,.5),random.uniform(-.45,.45),random.uniform(-.4,.4)))
+            if i%2==0:
+                for k in range(3):
+                    box('Rising sand grain trail',(x+.055*k,y+.02*k,z-.18-k*.12),
+                        (.045,.045,.065-k*.007),'sand_glow',bevel=False)
+    box('Last vanishing sand grain',(cx+.25,(front+back)/2,top-.025),
+        (.05,.05,.05),'sand_glow',bevel=False)
+
+
+def chimney(x, y, bottom, top, fragment_top):
+    for row in range(max(1,round((top-bottom)/.32))):
+        z = bottom+.16+row*.32
+        for j in range(2):
+            xx = x+(j-.5)*.42
+            box('Chimney staggered masonry',(xx+(row%2)*.035,y,z),
+                (.40,.72,.30),'stone' if (row+j)%3 else 'stone_dark')
+    box('Rust chimney lip',(x,y,top+.05),(.98,.90,.16),'rust')
+    box('Open chimney dark flue',(x,y,top+.15),(.62,.54,.07),'stone_dark')
+    for layer,count in enumerate((4,3,2,1)):
+        for j in range(count):
+            t = layer/3
+            z = top+.35+(fragment_top-top-.50)*t
+            box('Dissolving chimney brick',(x+random.uniform(-.35,.35),y+random.uniform(-.3,.3),z),
+                (.28*(1-t*.65),.21*(1-t*.65),.13),'stone' if j%2 else 'rust',
+                (.1,j*.3,layer*.23))
+            box('Frozen chimney sand spark',(x+.12+layer*.09,y+.18,z+.12),
+                (.055,.055,.09),'sand_glow',bevel=False)
+
+
+def inn():
+    w,d,h = 10.4,8,6.55
+    front_holes = [(0,.22,1.5,2.5)]
+    front_holes += [(x,1.5,1.45,1.65) for x in (-3.4,3.4)]
+    front_holes += [(x,4.55,1.2,1.55) for x in (-3.4,-1.15,1.15,3.4)]
+    f,b = shell(w,d,h,front_holes)
+    roof(w,f,b,h,1.25,'roof_shingle')
+    crest(w,f,h,8.55,'paint_rose')
+    boardwalk(w,f)
+    door(f)
+    for x in (-3.4,3.4):
+        window('Inn ground window',x,f+.11,2.325,1.45,1.65,True)
+    for x in (-3.4,-1.15,1.15,3.4):
+        window('Inn second floor window',x,f+.11,5.325,1.2,1.55,True)
+    # Full-width second-storey balcony doubles as the entrance porch roof.
+    for i in range(19):
+        box('Balcony floorboard',(-4.9+(i+.5)*9.8/19,f+.68,3.58),
+            (9.8/19-.018,1.35,.14),WOOD[i%len(WOOD)])
+    for x in (-4.85,-2.4,2.4,4.85):
+        box('Balcony lower support post',(x,f+1.14,1.91),(.18,.18,3.36),'wood_dark')
+        rod('Balcony corbel',(x,f+1.13,2.96),(x,f+.57,3.53),.09,'wood_light')
+    for x in (-4.85,-2.4,0,2.4,4.85):
+        box('Balcony railing newel',(x,f+1.25,4.14),(.18,.18,1.14),'paint_rose')
+        cylinder('Balcony brass post cap',(x,f+1.25,4.76),.12,.10,'brass',8)
+    for i in range(25):
+        box('Balcony railing baluster',(-4.75+i*9.5/24,f+1.25,4.12),(.065,.075,.85),'wood_light')
+    for z in (3.76,4.61):
+        box('Balcony full front rail',(0,f+1.25,z),(9.95,.14,.12),'wood_dark')
+        for side in (-1,1):
+            box('Balcony return rail',(side*4.87,f+.66,z),(.12,1.22,.12),'wood_dark')
+            for yy in (.3,.65,1.0):
+                box('Balcony return baluster',(side*4.87,f+yy,4.14),(.07,.07,.85),'wood_light')
+    # Cuckoo-house is a large relief volume embedded in the crest.
+    cy = f+.49
+    extrude('Cuckoo clock carved wooden house',
+            [(-1.05,6.65),(1.05,6.65),(1.05,7.76),(0,8.40),(-1.05,7.76)],
+            .52,'wood_dark',cy)
+    for s in (-1,1):
+        rod('Cuckoo gable gold rake',(s*1.19,cy+.30,7.76),(0,cy+.30,8.50),.075,'gold')
+    dial((0,cy+.31,7.20),.48,hour=6,minute=30)
+    for s in (-1,1):
+        box('Closed tiny cuckoo door',(s*.14,cy+.32,7.96),(.25,.11,.33),'wood_light')
+        box('Cuckoo tiny door iron hinge',(s*.23,cy+.39,7.96),(.065,.05,.12),'iron')
+        # Three broad alternating pine-cone tiers read at the game camera.
+        x = s*.70
+        rod('Pine cone weight chain',(x,cy+.35,6.76),(x,cy+.35,5.82),.025,'brass')
+        for j in range(4):
+            z = 5.64+j*.13
+            lathe('Carved pine cone weight',(x,cy+.35,z),
+                  [(-.06,.06),(.02,.14-j*.012),(.12,.065)],'wood_dark',8)
+    for s in (-1,1):
+        scroll((s*2.05,f+.34,7.25),1.45,s)
+    sy,sz = sign_bracket(4.35,f,3.15,.92)
+    # A blank, chunky carved board: intentionally no lettering.
+    start = len(PARTS)
+    poly = [(-.62,-.34),(.50,-.34),(.70,-.10),(.62,.30),(-.48,.38),(-.71,.12)]
+    extrude('Inn blank carved hanging board',poly,.16,'wood_dark')
+    for i in range(len(poly)):
+        a,c = poly[i],poly[(i+1)%len(poly)]
+        rod('Inn sign gold frame',(a[0],.105,a[1]),(c[0],.105,c[1]),.055,'gold')
+    for obj in PARTS[start:]:
+        transform(obj,(4.35,sy,sz),(0,0,math.pi/5))
+    for x in (-1.05,1.05):
+        lantern((x,f+.40,2.60),.7)
+    chimney(-3.2,b+1.25,6.95,8.10,10.15)
+    drip((1.15,f+.35,7.03),.53)
+    dissolve(w,b,f,8.30,11,('roof_shingle','wood_light','paint_rose','gold'))
+
+
+def rifle(loc, scale=1):
+    x,y,z = loc
+    box('Rifle walnut stock',(x-.10*scale,y,z-.42*scale),
+        (.16*scale,.12,.46*scale),'wood_dark',(0,-.15,0))
+    box('Rifle fore stock',(x,y,z),(.13*scale,.13,.55*scale),'wood_dark')
+    rod('Rifle iron barrel',(x,y,z-.1*scale),(x,y,z+.85*scale),.035*scale,'iron')
+    box('Rifle receiver',(x,y+.045,z-.18*scale),(.22*scale,.09,.17*scale),'iron')
+    ring('Rifle trigger guard',(x-.02*scale,y+.09,z-.33*scale),.095*scale,.04,.06,'iron',10)
+
+
+def revolver_sign(x, y, z):
+    # True revolver silhouette with barrel, six-shot cylinder and angled grip.
+    poly = [(-1.18,.25),(.42,.25),(.60,.12),(.63,-.10),(.42,-.25),
+            (.62,-.88),(.19,-1.0),(-.04,-.28),(-.44,-.19),(-.44,.04),(-1.18,.04)]
+    extrude('Oversize revolver iron silhouette',[(x+a,z+c) for a,c in poly],
+            .20,'iron',y)
+    extrude('Revolver wood grip',[(x+.12,z-.24),(x+.40,z-.27),
+            (x+.55,z-.82),(x+.25,z-.90)],.245,'wood',y)
+    box('Revolver long barrel',(x-.54,y,z+.16),(1.44,.25,.19),'iron')
+    box('Revolver gold barrel inlay',(x-.54,y+.15,z+.18),(1.32,.055,.045),'gold')
+    cylinder('Revolver fluted cylinder',(x-.13,y+.10,z-.005),.265,.20,'iron',12,(math.pi/2,0,0))
+    for i in range(6):
+        a = i*TAU/6
+        cylinder('Revolver cylinder brass chamber',(x-.13+.17*math.cos(a),y+.22,z+.17*math.sin(a)),
+                 .045,.04,'gold',6,(math.pi/2,0,0))
+    ring('Revolver gold trigger guard',(x+.19,y+.13,z-.30),.22,.055,.10,'gold',16)
+    box('Revolver hammer',(x+.46,y,z+.22),(.17,.15,.19),'iron',(0,.25,0))
+    cylinder('Grip gold rivet',(x+.34,y+.15,z-.60),.065,.05,'gold',8,(math.pi/2,0,0))
+
+
+def gunshop():
+    w,d,h = 8.5,7,4.65
+    holes = [(0,.22,1.45,2.5),(-2.65,1.1,2.6,1.9),(2.75,1.5,1.25,1.6)]
+    f,b = shell(w,d,h,holes)
+    roof(w,f,b,h,.95,'roof_tin')
+    crest(w,f,h,6.80,'wood_light')
+    boardwalk(w,f)
+    door(f)
+    window('Gun display',-2.65,f+.35,2.05,2.6,1.9)
+    for x in (-3.95,-1.35):
+        box('Display projecting jamb return',(x,f+.18,2.05),(.13,.37,2.1),'wood_light')
+    for zz in (1.10,3.0):
+        box('Display projecting sill return',(-2.65,f+.18,zz),(2.72,.37,.13),'wood_light')
+    # Display rifles sit ahead of the opaque review glass and behind the rack.
+    for i in range(4):
+        rifle((-3.47+i*.55,f+.57,1.86),.85)
+    for zz in (1.32,1.80):
+        box('Rifle display rack',(-2.65,f+.67,zz),(2.35,.14,.12),'wood_light')
+    window('Gunshop side display',2.75,f+.10,2.3,1.25,1.6)
+    # Individual thick fabric stripes follow the same sloping awning plane.
+    for i in range(16):
+        x = -w/2+(i+.5)*w/16
+        role = 'canvas' if i%2==0 else 'cloth_red'
+        box('Red and canvas awning stripe',(x,f+.70,4.00),
+            (w/16-.012,1.48,.07),role,(-math.radians(10),0,0))
+        extrude('Striped scalloped valance',[(x-w/32,3.88),(x+w/32,3.88),
+                (x+w/32,3.65),(x,3.57),(x-w/32,3.65)],.075,role,f+1.40,False)
+    for x in (-4.05,4.05):
+        box('Awning iron support',(x,f+1.25,2.04),(.11,.12,3.64),'iron')
+        rod('Awning brace',(x,f+1.24,3.39),(x,f+.6,4.01),.055,'iron')
+    sy,sz = sign_bracket(2.15,f,5.08,1.08)
+    revolver_sign(2.1,sy,sz+.15)
+    # Six-point sheriff star with six raised rounded points.
+    radius = .68
+    polygon = [(radius*(1 if i%2==0 else .46)*math.sin(i*TAU/12),
+                5.95+radius*(1 if i%2==0 else .46)*math.cos(i*TAU/12)) for i in range(12)]
+    extrude('Sheriff gold star',polygon,.15,'gold',f+.34)
+    for i in range(6):
+        a = i*TAU/6
+        cylinder('Sheriff rounded point',(radius*math.sin(a),f+.44,5.95+radius*math.cos(a)),
+                 .08,.09,'brass',8,(math.pi/2,0,0))
+    cylinder('Sheriff centre boss',(0,f+.46,5.95),.19,.09,'brass',12,(math.pi/2,0,0))
+    lantern((1.0,f+.40,2.6),.75)
+    dissolve(w,b,f,6.70,9,('roof_tin','rust','wood_light','gold'))
+
+
+def bullet(loc, scale=1):
+    lathe('Brass cartridge',loc,[(0,.095*scale),(.07*scale,.115*scale),
+          (.14*scale,.095*scale),(.48*scale,.095*scale),
+          (.60*scale,.07*scale),(.72*scale,.022*scale)],'brass',8)
+
+
+def crate(loc):
+    x,y,z = loc
+    box('Cartridge crate dark interior',(x,y,z+.30),(.85,.67,.54),'wood_dark')
+    for zz in (z+.14,z+.47):
+        for yy in (y-.36,y+.36):
+            box('Crate slat',(x,yy,zz),(.97,.10,.22),'wood_light')
+        for xx in (x-.45,x+.45):
+            box('Crate end slat',(xx,y,zz),(.10,.70,.22),'wood_weathered')
+    for xx in (-.31,.31):
+        box('Crate iron band',(x+xx,y+.42,z+.32),(.065,.06,.59),'iron')
+    for j in range(2):
+        for i in range(4):
+            bullet((x+(i-1.5)*.20,y+(j-.5)*.24,z+.46),.65)
+
+
+def hourglass(loc, scale=1):
+    x,y,z = loc
+    for dz in (-.9,.9):
+        obj = ring('Hourglass open brass end ring',(0,0,0),.62*scale,
+                   .105*scale,.13,'brass',20)
+        transform(obj,(x,y,z+dz*scale),(math.pi/2,0,0))
+    for xx in (-.49,.49):
+        for yy in (-.25,.25):
+            rod('Hourglass brass column',(x+xx*scale,y+yy*scale,z-.86*scale),
+                (x+xx*scale,y+yy*scale,z+.86*scale),.045*scale,'brass')
+    # Separate rear glass half-bulbs leave a real open front cutaway so the
+    # sand remains visible even with the required opaque grey Principled BSDF.
+    for side in (-1,1):
+        rings = [(side*v*scale,r*scale) for v,r in
+                 ((.03,.06),(.25,.25),(.57,.44),(.78,.40))]
+        rings.sort()
+        count = 10
+        verts = [(x+r*math.cos(math.pi+j*math.pi/count),
+                  y+r*math.sin(math.pi+j*math.pi/count),z+zz)
+                 for zz,r in rings for j in range(count+1)]
+        # Give the half glass shell .045m thickness with Blender solidify.
+        faces = [(k*(count+1)+j,k*(count+1)+j+1,(k+1)*(count+1)+j+1,
+                  (k+1)*(count+1)+j) for k in range(len(rings)-1) for j in range(count)]
+        obj = mesh('Hourglass rear glass bulb',verts,faces,'glass',False)
+        mod = obj.modifiers.new('Thick glass cutaway','SOLIDIFY')
+        mod.thickness = .045
+    lathe('Upper frozen sand',(x,y+.015,z),[(.17*scale,.05*scale),
+          (.53*scale,.29*scale),(.66*scale,.30*scale)],'sand_glow',12,bevel=False)
+    lathe('Lower sand mound',(x,y+.015,z),[(-.77*scale,.35*scale),
+          (-.67*scale,.29*scale),(-.40*scale,.025*scale)],'sand_glow',12,bevel=False)
+    rod('Frozen hourglass sand stream',(x,y+.04,z-.40*scale),
+        (x,y+.04,z+.17*scale),.026*scale,'sand_glow')
+
