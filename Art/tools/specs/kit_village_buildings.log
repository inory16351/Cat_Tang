+
+def cylinder(label, loc, radius, depth, role, n=12, rot=(0, 0, 0), bevel=True):
+    return lathe(label, loc, [(-depth/2,radius), (depth/2,radius)],
+                 role, n, rot, bevel)
+
+
+def rod(label, a, b, radius, role, n=6, bevel=True):
