+def arch_segment(inner, outer, a, b, bottom, depth, role, steps=4):
+    angles = [a+(b-a)*j/steps for j in range(steps+1)]
+    poly = [(outer*math.cos(t),bottom+outer*math.sin(t)) for t in angles]
+    poly += [(inner*math.cos(t),bottom+inner*math.sin(t)) for t in reversed(angles)]
+    return extrude('Grand arch curved beam segment',poly,depth,role,-.20)
+
+
+def timegate():
+    # Inner faces at +/-2.25, arch underside starts at Z=6.0 at its spring.
+    # No base/floor/door/glass/VFX spans the 4.5m x 6m traversable opening.
+    for side in (-1,1):
+        x = side*3.28
+        box('Clock pillar stone plinth',(x,-.20,.19),(2.04,2.60,.38),'stone_dark')
+        box('Clock pillar upper plinth',(x,-.20,.45),(1.90,2.40,.18),'stone')
+        box('Grandfather case rear',(x,-1.23,3.45),(1.76,.20,5.85),'wood_dark')
+        for s in (-1,1):
+            box('Grandfather case side',(x+s*.81,-.20,3.49),(.19,2.18,5.88),
+                'wood_dark' if s==side else 'wood_weathered')
+            box('Clock case fluted front stile',(x+s*.78,.96,3.40),(.22,.22,5.30),'wood_light')
+            box('Clock case gold stile inlay',(x+s*.78,1.085,3.45),(.065,.06,4.85),'gold')
+        for z in (.88,4.75,6.0):
+            box('Clock case cream crosspiece',(x,.94,z),(1.80,.22,.19),'cloth_cream')
+        for z in (1.16,5.88):
+            box('Case wraparound cornice',(x,-.17,z),(1.96,2.48,.18),'wood_light')
+        # Closed glass case doors with a centre mullion. The central glazed
+        # section is recessed behind the actual lantern pendulum for legibility.
+        box('Pendulum door recessed glass',(x,-.67,2.92),(1.32,.07,3.30),'glass')
+        for s in (-1,1):
+            box('Glass door side pane',(x+s*.58,.92,2.94),(.13,.06,3.4),'glass')
+        for z in (1.25,4.62):
+            box('Pendulum glass door frame',(x,1.04,z),(1.44,.13,.12),'brass')
+        for zz in (1.7,4.1):
+            box('Case glass door iron hinge',(x-side*.70,1.08,zz),(.17,.07,.20),'iron')
+        cylinder('Case door brass knob',(x+side*.56,1.13,2.85),.075,.12,'brass',10,(math.pi/2,0,0))
+        rod('Lantern pendulum rod',(x,.72,4.58),(x,.72,2.08),.045,'brass')
+        lantern((x,.76,1.98),1.40)
+        ring('Pendulum brass halo',(x,.79,1.98),.53,.065,.10,'brass',20)
+        # Small clock hoods distinguish the full-depth pillars as clock cases.
+        dial((x,1.05,5.28),.44,hour=11,minute=59)
+        extrude('Grandfather clock peaked hood',[(x-.96,6.02),(x+.96,6.02),
+                (x+.85,6.42),(x,6.85),(x-.85,6.42)],2.46,'wood_dark',-.20)
+        for s in (-1,1):
+            rod('Clock hood gilded rake',(x+s*.96,1.12,6.12),(x,1.12,6.87),.065,'gold')
+        # Exterior lanterns hang outboard, never inside the passage.
+        hx = x+side*.84
+        tube('Outboard lantern iron hook',[(hx,1.04,4.55),(hx+side*.12,1.38,4.78),
+             (hx+side*.20,1.38,4.66),(hx+side*.20,1.38,4.37)],.055,'iron')
+        lantern((hx+side*.18,1.38,3.90),.88)
+        # Each clock case gets its own tiny porch and board steps.
+        box('Pillar door canopy',(x,1.22,4.87),(1.98,.60,.14),'roof_tin')
+        for z in (1.53,3.95):
+            box('Rear clock panel band',(x,-1.37,z),(1.56,.10,.13),'brass')
+        for i in range(4):
+            box('Rear case inset board',(x-.56+i*.37,-1.36,3.12),(.34,.09,3.6),WOOD[i])
+    boardwalk(8.7,.80,gate=True)
+    for i in range(9):
+        # Central top segments partially disappear instead of an intact cap
+        # with arbitrary confetti added on top.
+        if i==4:
+            continue
+        a,b = i*math.pi/9+.012,(i+1)*math.pi/9-.012
+        arch_segment(2.25,2.92,a,b,6.0,1.65,'wood_dark' if i%2 else 'wood_weathered')
+        arch_segment(2.27,2.36,a,b,6.0,1.79,'gold',3)
+    # Clock lies above the free passage, at the arch crown, 11:59 exactly.
+    dial((0,.88,8.35),1.28,True,hour=11,minute=59)
+    for x,length in ((-.73,.60),(-.18,1.03),(.40,.76),(.82,.47)):
+        zz = 8.35-math.sqrt(max(0,1.28**2-x*x))
+        drip((x,1.12,zz+.13),length)
+    for s in (-1,1):
+        scroll((s*1.70,.83,7.58),1.4,s)
+        scroll((s*2.24,.83,6.68),.95,-s)
+        gear((s*1.20,.62,9.26),.30,'brass',10)
+    # Uppermost arch boards, gears and numeral blocks rise in four layers.
+    dissolve(7.5,-1.05,.9,9.05,11,('gold','wood_dark','brass'),clock_bits=True)
+    for i in range(7):
+        x = -2.25+i*.73
+        z = 9.35+(i%3)*.48
+        box('Floating clock numeral upright',(x,.10,z),(.065,.10,.28),'gold',
+            (0,(-.35+i*.1),0))
+        if i%2==0:
+            box('Floating numeral serif',(x,.10,z+.13),(.17,.11,.055),'gold')
+
+
+SPECS = (
+    ('Inn',(11,8,11),inn),
+    ('GunShop',(9,7,9),gunshop),
+    ('AmmoWorkshop',(9,8,9),ammoworkshop),
+    ('Wardrobe',(8,7,9),wardrobe),
+    ('TimeGate',(9,4,11),timegate),
+)
+
+
+def triangles(obj):
+    obj.data.calc_loop_triangles()
+    return len(obj.data.loop_triangles)
+
+
+def bounds(obj):
+    return (Vector(tuple(min(v.co[i] for v in obj.data.vertices) for i in range(3))),
+            Vector(tuple(max(v.co[i] for v in obj.data.vertices) for i in range(3))))
+
+
+def material_coverage(obj):
+    """Occlusion-aware projected visible area from the 55-degree review view."""
+    obj.data.calc_loop_triangles()
+    verts = [v.co.copy() for v in obj.data.vertices]
+    tris = list(obj.data.loop_triangles)
+    tree = BVHTree.FromPolygons(verts,[tuple(t.vertices) for t in tris],all_triangles=True)
+    view = Vector((0,math.cos(math.radians(55)),math.sin(math.radians(55))))
+    distance = max(obj.dimensions)*3
+    areas = {}
+    for index,t in enumerate(tris):
+        facing = t.normal.dot(view)
+        if facing <= 0:
+            continue
+        center = sum((verts[i] for i in t.vertices),Vector())/3
+        _,_,hit,_ = tree.ray_cast(center+view*distance,-view,distance+.01)
+        if hit == index:
+            role = obj.data.materials[t.material_index].name
+            areas[role] = areas.get(role,0)+t.area*facing
+    total = sum(areas.values())
+    assert total > 0,obj.name
+    return {role:area/total for role,area in areas.items()}
+
+
+def check_gate_passage(obj):
+    """No triangle may cross the walking envelope, including disconnected FX."""
+    # Check a densely sampled ray grid through the full gate depth.
+    tree = BVHTree.FromObject(obj,bpy.context.evaluated_depsgraph_get())
+    for i in range(29):
+        x = -2.22+i*4.44/28
+        for j in range(39):
+            z = .03+j*5.94/38
+            hit,_,_,_ = tree.ray_cast(Vector((x,3,z)),Vector((0,-1,0)),6)
+            assert hit is None,('Blocked gate passage',x,z,hit)
+
+
+def finish(name, target):
+    bpy.ops.object.select_all(action='DESELECT')
+    # Apply the identical bevel on all rigid parts before joining. A collapse
+    # pass removes excess bevel tessellation while respecting material borders.
+    for obj in PARTS:
+        obj.select_set(True)
+        bpy.context.view_layer.objects.active = obj
+        for mod in list(obj.modifiers):
+            bpy.ops.object.modifier_apply(modifier=mod.name)
+        obj.select_set(False)
+    for obj in PARTS:
+        obj.select_set(True)
+    bpy.context.view_layer.objects.active = PARTS[0]
+    bpy.ops.object.join()
+    obj = bpy.context.object
+    obj.name,obj.data.name = name,name+'_Mesh'
+    # Recalculate first, so decimation works consistently on closed submeshes.
+    bm = bmesh.new()
+    bm.from_mesh(obj.data)
+    bmesh.ops.recalc_face_normals(bm,faces=list(bm.faces))
+    bm.to_mesh(obj.data)
+    bm.free()
+    raw = triangles(obj)
+    if raw > 11900:
+        mod = obj.modifiers.new('Building 12000 triangle budget','DECIMATE')
+        mod.ratio,mod.delimit = 11850/raw,{'MATERIAL'}
+        bpy.ops.object.modifier_apply(modifier=mod.name)
+    assert triangles(obj)<=12000,(name,triangles(obj))
+    bm = bmesh.new()
+    bm.from_mesh(obj.data)
+    bmesh.ops.recalc_face_normals(bm,faces=list(bm.faces))
+    assert all(e.is_manifold for e in bm.edges),(name,'open mesh edge')
+    bm.to_mesh(obj.data)
+    bm.free()
+    obj.data.update()
+    bpy.context.view_layer.update()
+    lo,hi = bounds(obj)
+    # Footprint origin is authored at (0,0,0); do not recentre on drifting FX
+    # or nonuniformly scale the 1.2m boardwalk / 4.5m gate passage.
+    assert obj.location.length < 1e-6,name
+    assert abs(lo.z)<.025 and abs(hi.z-target[2])<.15,(name,lo,hi)
+    assert all(abs(obj.dimensions[i]-target[i])<1.2 for i in range(2)),(name,obj.dimensions)
+    assert all(math.isfinite(c) for v in obj.data.vertices for c in v.co),name
+    assert all(mat.name in ROLES for mat in obj.data.materials),name
+    for mat in obj.data.materials:
+        assert tuple(mat.diffuse_color)==(.5,.5,.5,1)
+        shader = mat.node_tree.nodes['Principled BSDF']
+        assert tuple(shader.inputs['Base Color'].default_value)==(.5,.5,.5,1)
+        assert not any(n.type.startswith('TEX_') for n in mat.node_tree.nodes)
+    coverage = material_coverage(obj)
+    assert sum(v>.002 for v in coverage.values())>=6,(name,coverage)
+    assert max(coverage.values())<=.55,(name,'material dominance',coverage)
+    if name=='TimeGate':
+        check_gate_passage(obj)
+    obj['front'] = '+Y'
+    obj['origin'] = 'Bottom centre of building footprint, metres'
+    obj['approx_size_m'] = list(target)
+    obj['triangle_count'] = triangles(obj)
+    obj['vanishing_layers'] = 4
+    obj['walkthrough'] = name=='TimeGate'
+    obj['boardwalk_depth_m'] = 1.2
+    destination = OUTPUT / ('Kit_V_'+name+'.fbx')
+    bpy.ops.export_scene.fbx(
+        filepath=str(destination),use_selection=True,
+        axis_forward='-Z',axis_up='Y',apply_scale_options='FBX_SCALE_UNITS',
+        bake_space_transform=True,object_types={'MESH'},use_mesh_modifiers=True,
+        mesh_smooth_type='FACE',add_leaf_bones=False,bake_anim=False,
+    )
+    assert destination.is_file() and destination.stat().st_size>1024,destination
+    print('VISIBLE '+name+' '+str({k:round(v,3) for k,v in
+          sorted(coverage.items(),key=lambda item:-item[1])}),flush=True)
+    print(f'EXPORTED {name} {triangles(obj)} {tuple(round(d,4) for d in obj.dimensions)}',flush=True)
+    return obj
+
+
+def preview(objects):
+    """Only viewport colours change, strictly after the final neutral FBX."""
+    scene = bpy.context.scene
+    scene.render.engine = 'BLENDER_WORKBENCH'
+    scene.render.resolution_x,scene.render.resolution_y = 1600,900
+    scene.render.resolution_percentage = 100
+    scene.render.image_settings.file_format = 'PNG'
+    scene.render.filepath = str(PREVIEW)
+    scene.render.film_transparent = False
+    scene.render.use_file_extension = True
+    scene.view_settings.view_transform = 'Standard'
+    shading = scene.display.shading
+    shading.light,shading.color_type = 'FLAT','MATERIAL'
+    shading.show_shadows,shading.show_cavity = False,True
+    shading.cavity_type = 'BOTH'
+    shading.curvature_ridge_factor,shading.curvature_valley_factor = 1.55,1.15
+    shading.show_specular_highlight = False
+    shading.show_object_outline = True
+    shading.object_outline_color = (.055,.035,.02)
+    shading.background_type = 'WORLD'
+    if scene.world is None:
+        scene.world = bpy.data.worlds.new('Review world')
+    scene.world.color = (.045,.052,.075)
+    locations = [obj.location.copy() for obj in objects]
+    helpers = []
+    try:
+        for role,mat in MATS.items():
+            mat.diffuse_color = (*PALETTE[role],1)
+        gap = 1.75
+        widths = [obj.dimensions.x for obj in objects]
+        total = sum(widths)+gap*(len(objects)-1)
+        x = -total/2
+        for obj,width in zip(objects,widths):
+            lo,hi = bounds(obj)
+            obj.location.x = x-lo.x
+            x += width+gap
+        data = bpy.data.cameras.new('Review camera')
+        cam = bpy.data.objects.new('Review camera',data)
+        scene.collection.objects.link(cam)
+        helpers.append(cam)
+        scene.camera = cam
+        cam.data.type,cam.data.ortho_scale = 'ORTHO',total+2
+        angle = math.radians(55)
+        target = Vector((0,0,4.0))
+        cam.location = target+Vector((0,45*math.cos(angle),45*math.sin(angle)))
+        cam.rotation_euler = (target-cam.location).to_track_quat('-Z','Y').to_euler()
