+def ribbon(points, width=.16, role='gold'):
+    # A thick rectangular ribbon, not a zero-thickness curve.
+    verts = []
+    for i,p in enumerate(points):
+        t = (Vector(points[min(i+1,len(points)-1)])-
+             Vector(points[max(0,i-1)])).normalized()
+        u = Vector((0,1,0)).cross(t).normalized()
+        for a,b in ((-1,-1),(1,-1),(1,1),(-1,1)):
+            verts.append(tuple(Vector(p)+u*a*width/2+Vector((0,b*.025,0))))
+    faces = [(3,2,1,0)]
+    faces += [(k*4+j,k*4+(j+1)%4,(k+1)*4+(j+1)%4,(k+1)*4+j)
+              for k in range(len(points)-1) for j in range(4)]
+    faces.append(tuple(range((len(points)-1)*4,len(points)*4)))
+    mesh('Curling tape measure ribbon',verts,faces,role,False)
+    for i,p in enumerate(points):
+        if i%2 == 0:
+            box('Tape measure dark graduation',(p[0],p[1]+.034,p[2]),(.075,.045,.045),'iron')
+
+
+def wardrobe():
+    w,d,h = 7.5,7,4.65
+    f,b = shell(w,d,h,[(0,.22,1.4,2.5),(-2.3,.85,2.5,2.3),
+                      (2.60,1.55,1.15,1.55)],paint='paint_sage')
+    roof(w,f,b,h,1.05,'roof_shingle')
+    crest(w,f,h,6.65,'paint_sage')
+    boardwalk(w,f)
+    door(f,1.4)
+    porch(f,2.05,3.10)
+    window('Tailor right window',2.6,f+.12,2.325,1.15,1.55,True,trim='cloth_cream')
+    # Projecting five-sided bay with proper plinth, canopy, returns and glass.
+    x = -2.3
+    plan = [(-1.24,0),(-1.24,.47),(-.92,.88),(.92,.88),(1.24,.47),(1.24,0)]
+    for z in (.83,3.19):
+        n = len(plan)
+        verts = [(x+u,f+v,z+zz) for zz in (-.09,.09) for u,v in plan]
+        faces = [tuple(reversed(range(n))),tuple(range(n,2*n))]
+        faces += [(i,(i+1)%n,(i+1)%n+n,i+n) for i in range(n)]
+        mesh('Tailor bay plinth / canopy',verts,faces,'cloth_cream')
+    box('Bay rear lit backdrop',(x,f+.02,2.0),(2.4,.09,2.2),'window_lit')
+    for u,v in plan[1:-1]:
+        box('Bay window cream upright',(x+u,f+v,2.0),(.105,.105,2.25),'cloth_cream')
+    # Side glass panes; the frontal pane is rolled up for the window display.
+    for s in (-1,1):
+        box('Bay return glass',(x+s*1.21,f+.24,2.0),(.055,.44,2.1),'glass')
+        box('Bay angled glass',(x+s*1.07,f+.67,2.0),(.055,.49,2.1),'glass',
+            (0,0,s*math.radians(38)))
+    box('Bay upper transom',(x,f+.89,2.93),(1.84,.06,.27),'glass')
+    box('Bay lower protective rail',(x,f+.92,1.05),(1.86,.10,.10),'cloth_cream')
+    mannequin((x-.46,f+.55,.94),'cloth_cream')
+    mannequin((x+.46,f+.55,.94),'cloth_red')
+    sy,sz = sign_bracket(2.65,f,4.33,1.12)
+    # Spool axis Z, wide wooden flanges, raised red thread bands and needle.
+    for zz in (-.42,.42):
+        cylinder('Thread spool wood flange',(2.65,sy,sz+zz),.47,.12,'wood_light',12)
+    cylinder('Thread spool red winding',(2.65,sy,sz),.31,.76,'cloth_red',12)
+    for j in range(5):
+        cylinder('Raised thread band',(2.65,sy,sz-.29+j*.145),.34,.045,'cloth_red',12)
+    rod('Large iron sewing needle',(2.32,sy+.35,sz-.60),
+        (3.13,sy+.35,sz+.80),.035,'iron')
+    ring('Needle eye',(3.12,sy+.35,sz+.76),.105,.04,.06,'iron',12)
+    # Real fabric pennants on a sagging cord across the eaves.
+    points = [(-w/2+i*w/16,f+.45,4.52-.22*math.sin(i*math.pi/16)) for i in range(17)]
+    tube('Bunting cord',points,.025,'wood_dark')
+    for i in range(13):
+        u = -w*.46+(i+.5)*w*.92/13
+        zz = 4.52-.22*math.sin((u/w+.5)*math.pi)
+        extrude('Fabric bunting pennant',[(u-.20,zz),(u+.20,zz),(u,zz-.42)],
+                .05,('cloth_red','cloth_cream','paint_rose')[i%3],f+.46,False)
+    points = [(1.1+.43*math.sin(t*TAU*1.35),f+.48+.10*math.sin(t*math.pi),5.1+t*3.38)
+              for t in [i/32 for i in range(33)]]
+    ribbon(points)
+    lantern((.99,f+.45,2.55),.65)
+    dissolve(w,b,f,6.65,9,('roof_shingle','paint_sage','cloth_cream','gold'))
