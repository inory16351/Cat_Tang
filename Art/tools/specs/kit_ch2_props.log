+    extrude_y('Arched warm ticket window', arch, .425, .475, 'window_lit', bevel=False)
+    points = [(-radius, .50, 1.08), (-radius, .50, spring)]
+    points += [(-radius * math.cos(i * math.pi / 12), .50,
