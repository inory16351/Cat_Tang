+            beam('Silver dial hand',(0,.083,0),(math.sin(a)*l,.083,math.cos(a)*l),.04,.03,'silver')
+        cylinder('Dial pivot',(0,.11,0),.04,.03,'red_lacquer',8,FACE)
+    for obj in PARTS[start:]: place(obj,loc,rot)
