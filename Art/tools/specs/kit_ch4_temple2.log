+
+
+def candle(x,y,bottom,h,r=.055):
+    cylinder('Ivory candle',(x,y,bottom+h/2),r,h,'porcelain',10)
+    cylinder('Silver candle socket',(x,y,bottom+.025),r*1.26,.05,'silver',10)
