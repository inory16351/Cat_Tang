        box('Rose wall cornice',(0,-.28,z),(6,d,h),role,True)
    clock(0,.12,3.60,1.70,rose=True)
    # Pointed altar recess: dark interior and layered stone archivolts.
    inner = pointed(0,.92,1.33,2.08,8)
