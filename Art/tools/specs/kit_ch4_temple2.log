+def reliquary():
+    for z,w,h,role in ((.08,1.4,.16,'stone'),(.18,1.31,.04,'silver'),
+                       (.265,1.20,.13,'stone_dark'),(.35,1.28,.04,'silver'),(.405,1.14,.07,'stone')):
+        box('Stepped shrine pedestal',(0,0,z),(w,w,h),role,True)
+    for x in (-.48,.48):
