import runpy
import bpy
from mathutils import Vector
kit = runpy.run_path('Art/tools/blender_kit_ch4_temple2.py')
for name, dims, build, budget in kit['SPECS']:
    bpy.ops.wm.read_factory_settings(use_empty=True)
    path = kit['OUTPUT'] / ('Kit_' + name + '.fbx')
    bpy.ops.import_scene.fbx(filepath=str(path))
    objects = list(bpy.context.scene.objects)
    assert len(objects) == 1 and objects[0].type == 'MESH', (name, objects)
    obj = objects[0]
    assert obj.name == name, (name, obj.name)
    points = [obj.matrix_world @ v.co for v in obj.data.vertices]
    lo = Vector(tuple(min(p[i] for p in points) for i in range(3)))
    hi = Vector(tuple(max(p[i] for p in points) for i in range(3)))
    assert all(abs((hi-lo)[i]-dims[i]) < .0001 for i in range(3)), (name, lo, hi)
    assert abs(lo.z) < .0001 and abs(lo.x+hi.x) < .0001 and abs(lo.y+hi.y) < .0001, (name, lo, hi)
    assert obj.location.length < .0001, (name, obj.location)
    obj.data.calc_loop_triangles()
    assert len(obj.data.loop_triangles) <= budget
    for mat in obj.data.materials:
        assert mat.name in kit['PALETTE'], (name, mat.name)
        color = mat.node_tree.nodes['Principled BSDF'].inputs['Base Color'].default_value
        assert all(abs(c-.5) < .00001 for c in color[:3]), (name, mat.name, color[:])
    print('VERIFIED_FBX', name, len(obj.data.loop_triangles), tuple(round(v,4) for v in hi-lo), flush=True)
print('ALL_SIX_FBX_VERIFIED', flush=True)
