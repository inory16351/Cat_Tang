+SPECS = [
+    ('Wall_Storehouse', 6, 4.0, storehouse),
+    ('Wall_Gears', 6, 4.5, gears),
+    ('Wall_BellArch', 6, 4.5, bell_arch),
+    ('Wall_DialBack', 8, 4.76, dial_back),
+    ('Wall_Pendulum', 6, 5.0, pendulum),
