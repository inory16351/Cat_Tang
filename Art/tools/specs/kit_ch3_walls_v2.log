+    for i, (x, h) in enumerate(zip((-3, -1, 1, 3), (4.2, 2.2, 4.2, 3.0))):
+        column(x, h, i in (0, 2))
+    crown = [(-3.58, 4.51), (-3.42, 4.64), (-2.62, 4.61), (-1.95, 4.48),
