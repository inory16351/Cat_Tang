"""Deterministic, metre-scale Blender 5.x wall kit; stock Blender only."""

import math
import random
from pathlib import Path

import bmesh
import bpy
from mathutils import Euler, Matrix, Vector


ROOT = Path(__file__).resolve().parents[2]
