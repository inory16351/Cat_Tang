+        target = Vector((0, 0, .8))
+        elevation = math.radians(55)
+        camera.location = target+Vector((0, 50*math.cos(elevation), 50*math.sin(elevation)))
+        camera.rotation_euler = (target-camera.location).to_track_quat('-Z', 'Y').to_euler()
+        for obj in objects:
