+                    (hi-lo, 1.64, z1-z0),
+                    ('sandstone', 'sandstone_light', 'rock', 'sandstone_dark')[(row+i)%4])
+    box('Wall marble lower plinth', (0, .15, .10), (4, 1.8, .20), 'marble_dark')
+    box('Lower stacked ivory molding', (0, .15, .24), (4, 1.74, .08), 'ivory')
