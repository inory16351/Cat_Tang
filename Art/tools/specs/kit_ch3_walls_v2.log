+        band('Stepped carved gold oval profile', ellipse(rx, rz, 1.80),
+             ellipse(rx-thickness, rz-thickness, 1.80), rear, front, 'gold')
+    band('Rose gold raised oval bead', ellipse(1.24, 1.34, 1.80), ellipse(1.185, 1.285, 1.80),
+         1.10, 1.17, 'rose_gold')
