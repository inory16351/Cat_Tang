+def wall():
+    # Four staggered courses; cut end blocks terminate exactly at tile boundaries.
+    for row in range(4):
+        cuts = [-2, -1, 0, 1, 2] if row%2 == 0 else [-2, -1.5, -.5, .5, 1.5, 2]
