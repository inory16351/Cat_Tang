+            if (row, i) in {(1, 1), (2, 2), (3, 1)}:
+                extrude('Chipped rose block', [(lo, z0), (hi, z0), (hi, z1-.12),
+                        (hi-.14, z1), (lo, z1)], -.7, .94,
+                        ('sandstone', 'sandstone_light', 'rock', 'sandstone_dark')[(row+i)%4])
+            else:
