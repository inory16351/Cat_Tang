+def cliff_island():
+    # A deliberately narrow top perimeter; all hanging rock stays behind Y=.2.
+    rim = [(-3, -2.12, 1.1), (-2.14, -1.35, 1.45), (-1.03, -.12, .95),
+           (-.14, .80, 1.6), (1.13, 2.06, 1.1), (2.04, 3, 1.38)]
