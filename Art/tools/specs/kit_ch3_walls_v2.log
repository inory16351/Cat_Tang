-    obj.data.update()
-    obj.location, obj.rotation_euler, obj.scale = (0, 0, 0), (0, 0, 0), (1, 1, 1)
-    bpy.context.view_layer.update()
-    low, high = bounds(obj)
-    assert abs(low.x+width/2) < 1e-5 and abs(high.x-width/2) < 1e-5, name
