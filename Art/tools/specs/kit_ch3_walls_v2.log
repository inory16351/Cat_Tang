+        crystal((x, -.16, z), h, .13, math.pi+(.16 if i%2 else -.20),
+                'crystal_rose' if i%2 else 'crystal', 'bronze')
+    tube('Gold vein across exposed island stratum', [(-1.70, .06, -.26),
+         (-1.30, -.02, -.63), (-1.03, -.06, -.89), (-.66, -.16, -1.20)],
+         .035, 'gold', n=5)
