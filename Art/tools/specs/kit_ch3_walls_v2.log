+def arch_path(radius, bottom=.10, spring=2.1, n=20):
+    return [(-radius, bottom), (-radius, spring)] + [
+        (radius*math.cos(math.pi-i*math.pi/n), spring+radius*math.sin(math.pi-i*math.pi/n))
+        for i in range(1, n+1)] + [(radius, bottom)]
+
