+    crack_strip(torso, (0, 1, 0), front, 0.017)
+    crack_strip(torso, (0, 1, 0), [(-0.24, 0.13), (-0.04, 0.20),
+                                 (0.17, 0.13), (0.28, 0.29), (0.43, 0.33)], 0.012)
