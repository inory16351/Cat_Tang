+def finish(name, height):
+    objects = PIECES + CRACKS + SHARDS
+    # Put the grounded shoe at z=0 and the midpoint of the two shoes at x=y=0.
+    feet = [obj for obj in PIECES if "shin and shoe" in obj["part"]]
+    foot_centers = [Vector(obj["foot_center"]) for obj in feet]
+    low_z = min(bounds(obj)[0].z for obj in PIECES)
+    offset = Vector(((foot_centers[0].x + foot_centers[1].x) / 2,
+                     (foot_centers[0].y + foot_centers[1].y) / 2, low_z))
+    top = max(bounds(obj)[1].z for obj in PIECES)
+    assert abs(top - height) < 0.00001 and abs(low_z) < 0.00001
+    triangles = 0
+    for obj in objects:
