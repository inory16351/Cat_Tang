+def arm(shoulder, elbow, hand):
+    Geometry().limb(shoulder, elbow, 0.077).object(label="upper arm")
+    Geometry().limb(elbow, hand, 0.066, 0.059).ellipsoid(
+        hand, (0.079, 0.078, 0.086)).object(label="forearm and mitten hand")
+
