+def split_garment(rings, label, rear_only=False):
+    spans = ((math.pi, math.pi * 1.5), (math.pi * 1.5, math.tau)) if rear_only else (
+        (-math.pi / 2, math.pi / 2), (math.pi / 2, math.pi * 1.5))
+    result = []
+    for start, end in spans:
