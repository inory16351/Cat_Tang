+          "ghost_dark": (0.45, 0.52, 0.62), "crack": (1.0, 1.0, 1.0)}
+MATERIALS = {}
+PIECES = []
+CRACKS = []
+SHARDS = []
+
+
+def activate(obj):
+    bpy.ops.object.select_all(action="DESELECT")
+    obj.select_set(True)
+    bpy.context.view_layer.objects.active = obj
+
