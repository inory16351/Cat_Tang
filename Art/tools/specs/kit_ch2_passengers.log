+        obj.data.calc_loop_triangles()
+        triangles += len(obj.data.loop_triangles)
+        low, high = bounds(obj)
+        assert ((low + high) / 2 - obj.location).length < 0.00001
+        assert obj.parent is None and obj.type == "MESH"
+        obj.data.name = obj.name
