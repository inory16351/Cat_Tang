+def bounds(obj):
+    points = [obj.matrix_world @ Vector(corner) for corner in obj.bound_box]
+    return (Vector(tuple(min(p[axis] for p in points) for axis in range(3))),
+            Vector(tuple(max(p[axis] for p in points) for axis in range(3))))
+
