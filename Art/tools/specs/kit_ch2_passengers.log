+    geo.vertices[shoe_start:] = [(x, y, z + lift) for x, y, z in geo.vertices[shoe_start:]]
+    obj = geo.object(label="shin and shoe")
+    obj["foot_center"] = (foot[0], foot[1], foot[2] + lift)
+    return obj
