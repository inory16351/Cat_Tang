def coal_pile():
    lump('Solid coal heap core', (0, -.05, .50), (4.35, 3.25, 1.30),
         'coal', detail=2, irregular=.12, ground=True)
    for j in range(22):
        a = j * 2.399963
        r = math.sqrt((j + .5) / 22)
        x, y = 1.83 * r * math.cos(a), 1.32 * r * math.sin(a)
