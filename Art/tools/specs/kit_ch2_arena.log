    for y in [-1.38, -.92, -.46, 0, .46, .92, 1.38]:
        beam('Red cowcatcher slat', (3.28, y, .98), (4.45, y, .22),
             .13, 'cloth_red', bevel=False)


def water_crane():
    cx, cy = -.30, -.27
    for sx in [-1, 1]:
        for sy in [-1, 1]:
            bottom = (cx + sx * 1.03, cy + sy * 1.04, .09)
            top = (cx + sx * .75, cy + sy * .75, 4.28)
