+    tube('Crack branch',[(-.24,front(2.56),2.56),(.02,front(2.63),2.63),
+                         (.14,front(2.78),2.78)],.018,'sandstone_dark',n=4,bevel=False)
+    crystal('Corner crystal tall',(.68,.69,.42),(.96,.91,1.65),.22)
