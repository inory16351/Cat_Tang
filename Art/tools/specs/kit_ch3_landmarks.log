+    matrix = Matrix.Translation(Vector((.40,.05,.93))) @ Euler(
+        (math.radians(-24),math.radians(-24),math.radians(8))).to_matrix().to_4x4()
+    oval = Matrix.Diagonal(Vector((1.12,1,.74,1)))
