+    faces = [(0,3,2,1),(4,5,6,7),(0,1,5,4),(1,2,6,5),(2,3,7,6),(3,0,4,7)]
+    mesh('Tapering rose sandstone obelisk',verts,faces,'sandstone')
+    tip = [(-.39,-.39,5.20),(.39,-.39,5.20),(.39,.39,5.20),
