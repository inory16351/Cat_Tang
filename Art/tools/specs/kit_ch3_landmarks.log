+                outer.append((i*n+j,i*n+(j+1) % n,(i+1)*n+(j+1) % n,(i+1)*n+j))
+    faces = outer + [tuple(k+count for k in reversed(face)) for face in outer]
+    # Close shell walls around the hole and both bulb rims.
