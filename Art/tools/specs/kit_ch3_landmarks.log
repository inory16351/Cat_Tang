+
+
+SPECS = [
+    ('LM_ArchRuin',(5.0,1.8,4.6),arch_ruin),
+    ('LM_CrystalSpire',(3.6,3.4,4.6),crystal_spire),
+    ('LM_Hourglass',(3.6,3.0,4.2),hourglass),
+    ('LM_FloatRock',(4.0,3.4,4.2),float_rock),
