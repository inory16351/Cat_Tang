+    mesh('Gold pyramidion',tip,[(0,3,2,1),(0,1,4),(1,2,4),(2,3,4),(3,0,4)],'gold')
+    z = 4.54
+    cylinder('Inset clock gold dial',(0,.452,z),.345,.035,'gold',n=24,
+             rot=(math.pi/2,0,0))
+    hoop('Clock dark gold bezel',(0,.481,z),.365,.045,.045,'gold_dark',n=24)
+    for i in range(12):
+        a = i*math.tau/12
+        rod('Clock raised hour mark',(.265*math.sin(a),.505,z+.265*math.cos(a)),
+            (.301*math.sin(a),.505,z+.301*math.cos(a)),.014,'gold_dark',n=4,bevel=False)
+    rod('Clock minute hand',(0,.526,z),(-.06,.526,z+.25),.024,'gold_dark',n=4)
+    rod('Clock hour hand',(0,.529,z),(.17,.529,z+.07),.028,'gold_dark',n=4)
+    cylinder('Clock hand pin',(0,.545,z),.042,.045,'gold',n=8,
+             rot=(math.pi/2,0,0))
+    crack = [(-.51,2.34),(-.24,2.56),(-.31,2.77),(.06,3.04),(.14,3.32),(.46,3.52)]
+    def front(z):
+        return .66-(z-.88)*(.28/4.34)+.008
+    tube('Diagonal dark fracture',[(x,front(z),z) for x,z in crack],.026,
