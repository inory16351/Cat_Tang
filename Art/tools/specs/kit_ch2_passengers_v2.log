+    seed = STATUE_SEED ^ zlib.crc32((obj.name + obj["part"]).encode("utf-8"))
+    rng = random.Random(seed)
+    bm = bmesh.new()
+    bm.from_mesh(obj.data)
+    bmesh.ops.recalc_face_normals(bm, faces=list(bm.faces))
+    bm.to_mesh(obj.data)
+    bm.free()
+    obj.data.update()
