+def top_crack(target, points):
+    vertices = []
+    for i, p in enumerate(points):
+        tangent = points[min(i + 1, len(points) - 1)] - points[max(0, i - 1)]
+        across = Vector((-tangent.y, tangent.x, 0)).normalized()
+        for sign in (-1, 1):
