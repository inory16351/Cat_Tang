+                      (a, a + 1, b + 1, b), (a + 2, b + 2, b + 3, a + 3)))
+    end = (len(points) - 1) * 4
+    faces.append((end, end + 2, end + 3, end + 1))
+    obj = Geometry().add(vertices, faces).object("crack", CRACKS, "plinth top fracture")
+    obj["starts_hidden"] = True
