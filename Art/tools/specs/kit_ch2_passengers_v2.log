+    rim = []
+    for i in range(8):
+        angle = math.tau * i / 8 + 0.15
+        radius = rng.uniform(0.96, 1.045)
+        rim.append(Vector((rx * radius * math.cos(angle), ry * radius * math.sin(angle), 0)))
+    # Replacing two original corners with pairs leaves an irregular decagon.
+    outline = []
