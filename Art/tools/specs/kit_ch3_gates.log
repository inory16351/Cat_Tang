+        faces += [(12 + j, 12 + (j + 1) % 6, 18) for j in range(6)]
+        obj = mesh('Leaning faceted crystal spire', verts, faces, 'crystal', False)
+        obj.data.materials.append(MATS['crystal_core'])
+        for p in obj.data.polygons:
+            if p.index % 6 == 2:
