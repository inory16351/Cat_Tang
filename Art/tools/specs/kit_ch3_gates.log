+def shoulder_arch():
+    # Vertical below 2.9; all curvature stays above the clearance rectangle.
+    return [(-2.59, .2), (-2.59, 2.96), (-2.37, 3.35),
+            (-1.60, 3.63), (0, 3.77), (1.60, 3.63),
+            (2.37, 3.35), (2.59, 2.96), (2.59, .2)]
