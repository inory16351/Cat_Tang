+def splinters(stage):
+    result = []
+    for i in range(3):
+        role = {1: 'sandstone', 2: 'wood', 3: 'marble', 4: 'cloud'}[stage]
+        length = .26 + i * .04
+        if stage == 4:
+            obj = lump('Cloud debris', (0, 0, 1.3), (.12, .04, length), role, True)
+        else:
+            obj = prism('Hidden debris', [(-.025, 1.3 - length / 2), (.045, 1.23),
+                                           (.027, 1.3 + length / 2), (-.035, 1.37)],
+                        -.018, .018, role, False)
+        obj = join([obj], f'Splinter_{i}')
+        activate(obj)
+        bpy.ops.object.origin_set(type='ORIGIN_GEOMETRY', center='BOUNDS')
+        result.append(obj)
+    return result
