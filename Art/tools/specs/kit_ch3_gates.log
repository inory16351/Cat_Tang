+
+def lantern(x, z, back=.0, scale=1):
+    """Inverted lantern: broad roof below the glass, mounting stem above."""
+    s = scale
+    cylinder('Upside down roof', (x, back, z - .13 * s), .16 * s, .12 * s,
+             'gold', n=6, top=.09 * s, bevel=False)
