+        x=.81*math.sin(a)+side*.10; z=.81*math.cos(a)+(.035 if side>0 else -.035)
+        box('Engraved clock minute batons',(x,.095,z),(.045,.045,.10 if j%4==0 else .045),'dial_mark',rot=(0,a,0),bevel=False)
