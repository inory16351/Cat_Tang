+    f=[(k*n+j,k*n+(j+1)%n,((k+1)%4)*n+(j+1)%n,((k+1)%4)*n+j) for k in range(4) for j in range(n)]
+    place(mesh(label,v,f,[role]*n+['gold']*n+['gold_dark']*n+['gold_dark']*n),loc)
+    x,y,z=loc
