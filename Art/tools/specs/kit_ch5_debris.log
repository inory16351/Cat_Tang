+    for z in (.45,.67,1.03): ring('Post brass collar',.12,.035,z,.08,'brass',n=12,loc=(-.88,-.56,0))
+    jagged_board('Torn metal post lip',(-.93,-.56,1.20),.18,.27,.13,'steel',rot=(math.pi/2,0,0),bevel=False)
