+    for ob in PARTS[start:]: ob.data.transform(Matrix.Diagonal((1,1,-1,1)))
+    transform_since(start,(0,0,0),(math.pi/2,math.radians(27),-.13))
+    # Collar and roots: no centering operation is allowed to move the entry pivot.
