+    shard('Fractured station lamp lens',(0,0,.12),(.24,.24,.25),'lamp_warm')
+    transform_since(start,(.23,-.62,.34),(0,.50,-.20))
+    tube('Railway gold rupture',[(-.58,-.70,.18),(-.43,-.38,.20),(-.50,-.08,.17),(-.22,.24,.19),(-.29,.59,.17)],.028,'crack_gold')
