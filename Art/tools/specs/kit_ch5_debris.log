+    for k in range(2):
+        for j in range(n):
+            a=k*n+j; b=k*n+(j+1)%n; c=(k+1)*n+(j+1)%n; d=(k+1)*n+j
+            f.extend([(a,b,c),(a,c,d)])
+            roles.extend([random.choice(['void_stone_dark','void_stone','marble_dark'])]*2)
+    for j in range(n):
