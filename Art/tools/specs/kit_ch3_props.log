import bpy, runpy
from pathlib import Path
from mathutils import Vector
ns = runpy.run_path('Art/tools/blender_kit_ch3_props.py', run_name='kit_validation')
for name, dims, build in ns['SPECS']:
    bpy.ops.wm.read_factory_settings(use_empty=True)
    for mat in list(bpy.data.materials):
        bpy.data.materials.remove(mat)
    path = ns['OUTPUT'] / ('Kit_' + name + '.fbx')
    bpy.ops.import_scene.fbx(filepath=str(path))
    objs = list(bpy.context.scene.objects)
    assert len(objs) == 1 and objs[0].type == 'MESH', name
    obj = objs[0]
    assert obj.name == name, (name, obj.name)
    assert obj.location.length < 1e-5, name
    world = [obj.matrix_world @ v.co for v in obj.data.vertices]
    low = Vector(tuple(min(v[i] for v in world) for i in range(3)))
    high = Vector(tuple(max(v[i] for v in world) for i in range(3)))
    floor = .6 if name == 'MirrorShard' else (.005 if name == 'Ripple' else 0)
    assert abs(low.z - floor) < 1e-4 and abs(high.z - dims[2]) < 1e-4, (name, low, high)
    assert all(abs((high-low)[i] - dims[i]) < 1e-4 for i in (0, 1)), name
    for mat in obj.data.materials:
        assert mat.name in ns['ROLES'], (name, mat.name)
        color = mat.node_tree.nodes.get('Principled BSDF').inputs['Base Color'].default_value
        assert all(abs(color[i] - .5) < 1e-5 for i in range(3)), (name, tuple(color))
    obj.data.calc_loop_triangles()
    count = len(obj.data.loop_triangles)
    assert count <= (4000 if name == 'MerchantMirror' else 2500), name
    if name in ('StandMirror', 'MerchantMirror', 'MirrorShard'):
        glass = [p for p in obj.data.polygons if obj.data.materials[p.material_index].name == 'mirror']
        assert any(p.normal.y > .99 for p in glass), name
        if name == 'MirrorShard':
            assert any(p.normal.y < -.99 for p in glass), name
            indices = {i for p in glass for i in p.vertices}
            thickness = max(obj.data.vertices[i].co.y for i in indices) - min(obj.data.vertices[i].co.y for i in indices)
            assert abs(thickness - .05) < 1e-4, thickness
        else:
            back = [p for p in obj.data.polygons if obj.data.materials[p.material_index].name == 'mirror_back']
            assert any(p.normal.y < -.99 for p in back), name
    if name == 'MemoryCrystal':
        dust = [p for p in obj.data.polygons if obj.data.materials[p.material_index].name == 'stardust']
        assert len(dust) == 32, len(dust)
        pending = {i for p in dust for i in p.vertices}
        groups = 0
        while pending:
            found = {pending.pop()}
            changed = True
            while changed:
                changed = False
                for p in dust:
                    ids = set(p.vertices)
                    if ids & found and not ids <= found:
                        found |= ids
                        changed = True
            pending -= found
            groups += 1
        assert groups == 4, groups
    print('VERIFIED', name, count, flush=True)
print('ROUNDTRIP_OK 10')
