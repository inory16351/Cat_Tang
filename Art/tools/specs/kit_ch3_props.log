+    fluted_drum('Second angled fluted drum', (.43, .015, .34), .75, .17)
+    capital = box('Toppled square capital', (1.01, .015, .48), (.43, .92, .92),
+                  'marble', rot=(.085, .035, -.08))
+    bottom = min(v.co.z for v in capital.data.vertices)
+    for v in capital.data.vertices:
+        v.co.z -= bottom
+    box('Capital abacus face', (1.23, .015, .50), (.10, 1.0, 1.0),
+        'marble', rot=(0, 0, -.08))
+    for loc, size in [((-.04, .38, .10), (.28, .20, .20)),
+                      ((-.87, .36, .07), (.24, .19, .14)),
+                      ((.20, -.38, .09), (.25, .24, .18)),
+                      ((-.30, -.38, .065), (.18, .19, .13))]:
+        lump('Broken dark marble rubble', loc, size, 'marble_dark')
+
+
+def mirror_shard():
+    profile = [(-1.21, .65), (.92, .65), (1.25, 1.03), (1.22, 2.86),
+               (.43, 3.00), (.10, 2.84), (-.41, 2.98), (-1.21, 2.73)]
+    extrude_y('Thin broken glass reflective on BOTH faces', profile,
+              -.025, .025, 'mirror', bevel=False)
+    # A square section, never a full ornate enclosure: bottom and left only.
+    box('Broken bottom frame strip', (-.145, -.025, .64), (2.13, .10, .08), 'gold')
+    box('Broken left frame strip', (-1.21, -.025, 1.68), (.08, .10, 2.10), 'gold')
+    tube('Remaining frame curl', [(-1.21, .035, 2.69), (-1.20, .035, 2.85),
+                                 (-1.11, .035, 2.97), (-.98, .035, 3.01),
+                                 (-.90, .035, 2.95), (-.94, .035, 2.87)],
+         .04, 'gold', n=8)
+
+
+def pebbles3():
+    for i, (x, y, w, d, h) in enumerate([
+            (-.43, -.38, .34, .28, .11), (.40, -.33, .40, .30, .15),
+            (-.17, -.03, .32, .25, .10), (.40, .28, .25, .30, .13),
