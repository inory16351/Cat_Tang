            assert abs(thickness - .05) < 1e-4, thickness
        else:
            back = [p for p in obj.data.polygons if obj.data.materials[p.material_index].name == 'mirror_back']
            assert any((rotation @ p.normal).y < -.99 for p in back), name
    if name == 'MemoryCrystal':
        dust = [p for p in obj.data.polygons if obj.data.materials[p.material_index].name == 'stardust']
        assert len(dust) == 32, len(dust)
        pending = {i for p in dust for i in p.vertices}
        groups = 0
        while pending:
            found = {pending.pop()}
            changed = True
            while changed:
                changed = False
                for p in dust:
                    ids = set(p.vertices)
                    if ids & found and not ids <= found:
                        found |= ids
                        changed = True
            pending -= found
            groups += 1
        assert groups == 4, groups
    print('VERIFIED', name, count, flush=True)
print('ROUNDTRIP_OK 10')
