+    shade.show_shadows,shade.show_cavity = False,True
+    shade.cavity_type = 'BOTH'
+    shade.curvature_ridge_factor,shade.curvature_valley_factor = 1.45,1.25
+    shade.show_specular_highlight = False
+    shade.background_type = 'WORLD'
