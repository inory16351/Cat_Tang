import ast
from pathlib import Path
import bpy
from mathutils import Vector
p=Path('Art/tools/blender_kit_story_lake.py').resolve()
ns={'__file__':str(p),'__name__':'lake_validation'}
exec(compile(p.read_text(encoding='utf-8'),str(p),'exec'),ns)
def options(p):
    for n in ast.walk(ast.parse(p.read_text(encoding='utf-8'))):
        if isinstance(n,ast.Call) and isinstance(n.func,ast.Attribute) and n.func.attr=='fbx':
            return {a.arg:ast.dump(a.value) for a in n.keywords if a.arg"'!='"'filepath'}
assert options(p)==options(p.with_name('blender_kit_story_platform.py'))
for name,_,_,_,budget in ns['SPECS']:
    bpy.ops.wm.read_factory_settings(use_empty=True)
    bpy.ops.import_scene.fbx(filepath=str(ns['OUTPUT']/('Kit_L_'+name+'.fbx')))
    bpy.context.view_layer.update()
    meshes=[o for o in bpy.context.scene.objects if o.type=='MESH']
    assert len(meshes)==1
    o=meshes[0]
    o.data.calc_loop_triangles()
    assert len(o.data.loop_triangles)<=budget
    assert len(o.data.materials)>=5
    for m in o.data.materials:
        assert m.name in ns['ROLES']
        shader=next(n for n in m.node_tree.nodes if n.type=='BSDF_PRINCIPLED')
        assert all(abs(c-.5)<.001 for c in shader.inputs['Base Color'].default_value[:3])
    vs=[o.matrix_world@v.co for v in o.data.vertices]
    lo=Vector(tuple(min(v[i] for v in vs) for i in range(3)))
    hi=Vector(tuple(max(v[i] for v in vs) for i in range(3)))
    if name=='Ground':
        for x,y in ns['OUTLINE']:
            assert min((v-Vector((x,y,0))).length for v in vs)<.001
    elif name not in ns['ATTACHMENT_ANCHORS']:
        assert abs(lo.z)<.001 and abs(lo.x+hi.x)<.001 and abs(lo.y+hi.y)<.001
    elif name=='Jetty':
        top=[v for v in vs if abs(v.z)<.001]
        assert min(v.y for v in top)<.05 and max(v.y for v in top)>19.9
        assert lo.z<-1.99
    else:
        assert -.65<lo.z<-.5 and hi.z>1
    print('VERIFIED',name,len(o.data.loop_triangles),len(o.data.materials),flush=True)
print('PASS: 15 FBXs, budgets, grey role names, pivots, exact boundary, matching export options',flush=True)
