+def halfplane(poly, a, b, right=True):
+    """Clip against a directed edge; OUTLINE is clockwise, interior on right."""
+    if not poly:
+        return []
+    def distance(p):
+        return (b[0]-a[0])*(p[1]-a[1])-(b[1]-a[1])*(p[0]-a[0])
