+        rod('Cast iron flute',(.12*math.cos(a),.12*math.sin(a),.48),
+            (.1*math.cos(a),.1*math.sin(a),3.55),.025,'iron_dark',n=5,bevel=False)
+    for z in (.45,.62,2.9,3.55):
+        cylinder('Gold clock collar',(0,0,z),.18,.08,'gold',n=10).bevel=False
+    for side in (-1,1):
