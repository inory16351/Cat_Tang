import ast
from pathlib import Path
import bpy
from mathutils import Vector
p = Path('Art/tools/blender_kit_story_lake.py').resolve()
ns = {'__file__': str(p), '__name__': 'lake_validation'}
exec(compile(p.read_text(encoding='utf-8'), str(p), 'exec'), ns)
def export_args(path):
    tree = ast.parse(path.read_text(encoding='utf-8'))
    for n in ast.walk(tree):
        if isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute) and n.func.attr == 'fbx':
            return {a.arg: ast.dump(a.value) for a in n.keywords if a.arg "'!= '"'filepath'}
assert export_args(p) == export_args(p.with_name('blender_kit_story_platform.py'))
for name, dims, centered, build, budget in ns['SPECS']:
    bpy.ops.wm.read_factory_settings(use_empty=True)
    bpy.ops.import_scene.fbx(filepath=str(ns['OUTPUT'] / ('Kit_L_'+name+'.fbx')))
    meshes = [o for o in bpy.context.scene.objects if o.type == 'MESH']
    assert len(meshes) == 1, (name, len(meshes))
    obj = meshes[0]
    obj.data.calc_loop_triangles()
    count = len(obj.data.loop_triangles)
    assert count <= budget, (name, count, budget)
    mats = list(obj.data.materials)
    assert len(mats) >= 5
    assert all(m.name in ns['ROLES'] for m in mats)
    for m in mats:
        shader = next(n for n in m.node_tree.nodes if n.type == 'BSDF_PRINCIPLED')
        assert all(abs(c-.5) < .001 for c in shader.inputs['Base Color'].default_value[:3]), (name,m.name)
    coords = [obj.matrix_world @ v.co for v in obj.data.vertices]
    low = Vector(tuple(min(v[i] for v in coords) for i in range(3)))
    high = Vector(tuple(max(v[i] for v in coords) for i in range(3)))
    if name == 'Ground':
        for x,y in ns['OUTLINE']:
            assert min((v-Vector((x,y,0))).length for v in coords) < .001, (name,x,y)
    elif name not in ns['ATTACHMENT_ANCHORS']:
        assert abs(low.z) < .001 and abs(low.x+high.x) < .001 and abs(low.y+high.y) < .001, (name,low,high)
    elif name == 'Jetty':
        deck = [v for v in coords if abs(v.z) < .001 and abs(v.x) < 1.51]
        assert min(v.y for v in deck) < .05 and max(v.y for v in deck) > 19.9
        assert low.z < -1.99
    else:
        assert -.65 < low.z < -.5 and high.z > 1, (name,low,high)
    print('VERIFIED',name,count,'tris',len(mats),'grey roles',flush=True)
print('ALL FBX FILES VERIFIED; EXPORT OPTIONS MATCH',flush=True)
