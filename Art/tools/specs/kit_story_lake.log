GHOST = {}   # ?좊졊 瑗щ━ ?꾨옯???믪씠 ??finish()媛 ?뺤젏 ???뚰뙆(?꾨옒濡?媛덉닔濡??щ챸)瑜?援ъ?


def ghost_tail(z_top, r_top, depth=.67, s=1.0, extra=None):
    """?좊졊 瑗щ━ (2026-11-25 ?ъ슜?? 遺덇퐙 X 쨌 瑗щ━瑜??꾨옒濡?湲멸쾶 ?섎━怨??앹쑝濡?媛덉닔濡??붿「釉뚮릺??諛곌꼍???욎씠寃?
    肄뷀듃 ?꾨옯?⑥뿉?????⑹뼱由щ줈 ?대젮媛硫?媛?섏뼱吏怨??댁쭩 ??+Y)濡??먮쫫. ?щ챸?꾨뒗 ?뺤젏 ???뚰뙆 (Unity CatTang/GhostFade)"""
    extra = .5 * s if extra is None else extra                                  # 瑗щ━瑜??꾨옯?⑥뿉????湲멸쾶 (2026-11-25 ?ъ슜??
    rings, seg, n = [], 18, 14
    for i in range(seg + 1):
        t = i / seg
        x = .07 * s * math.sin(t * math.pi * 1.4)                              # ?댁쭩 S?먮줈 ?붾뱾由?
        y = .5 * s * t ** 1.6                                                 # ?꾨옒濡?媛덉닔濡??ㅻ줈 ?뚮┝
        z = z_top - (z_top + extra) * t                                        # ???꾨옒濡?extra留뚰겮 ????紐??꾩껜媛 洹몃쭔???좎삤由?(finish媛 留??꾨옒瑜?0?쇰줈)
        r = r_top * (1.06 - .06 * t) * (1 - t) ** .55 + .02 * s                # 泥쒖쿇??媛?섏뼱吏?(?앷퉴吏 苑?援듦쾶 ???щ챸?댁?硫??щ씪吏?
        r *= 1 + .07 * math.sin(t * math.pi * 4)                                # 臾쇨껐移섎뒗 援듦린
        rings.append((Vector((x, y, z)), r))
    verts, faces = [], []
    for c, r in rings:
        for k in range(n):
            a = TAU * k / n
            verts.append((c.x + math.cos(a) * r, c.y + math.sin(a) * r * depth, c.z))
    for i in range(seg):
        for k in range(n):
            a, b = i * n + k, i * n + (k + 1) % n
            faces.append((a, b, b + n, a + n))
    top = len(verts); verts.append((rings[0][0].x, rings[0][0].y, rings[0][0].z + .02))
    faces += [(top, (k + 1) % n, k) for k in range(n)]
    tip = len(verts); c, r = rings[-1]; verts.append((c.x, c.y + .03 * s, c.z))
    base = seg * n
    faces += [(base + k, base + (k + 1) % n, tip) for k in range(n)]
    Part('Ghost tail', verts, faces, 'shadow', bevel=False)
    GHOST['top'] = (z_top + extra) * 1.08                                      # 諛붾떏?먯꽌 ?щ?濡?瑗щ━ ?꾩껜 湲몄씠


def ghost_fade(obj):
    """?좊졊 瑗щ━媛 ?덉쑝硫? 諛붾떏(0) ?щ챸 ???꾨옯???꾨줈??遺덊닾紐? ?뺤젏 ???뚰뙆濡?(遺?쒕윭??怨≪꽑)"""
    top = GHOST.pop('top', None)
    if not top:
        return
    me = obj.data
    attr = me.color_attributes.new('Col', 'BYTE_COLOR', 'POINT')
    for v in me.vertices:
        t = max(0., min(1., v.co.z / top))
        attr.data[v.index].color = (1., 1., 1., t * t * (3 - 2 * t))


