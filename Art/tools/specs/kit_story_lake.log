def moulded_base(radius=.4, square=False):
    if square:
        for z,w,h,role in ((.09,radius*2.3,.18,'stone_dark'),(.25,radius*2,.14,'stone'),
                           (.37,radius*1.8,.1,'stone_dark'),(.45,radius*1.4,.08,'brass')):
            box('Stepped square plinth',(0,0,z),(w,w,h),role)
