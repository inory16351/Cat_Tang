+def pier_clock():
+    lathe('Dark clock plinth',[(0,.38),(.12,.38),(.18,.32)],'stone_dark',n=12)
+    lathe('Carved stone base',[(.18,.32),(.31,.29),(.42,.19)],'stone',n=12)
+    lathe('Clock post iron core',[(.42,.13),(3.6,.11)],'iron',n=10,bevel=False)
+    for j in range(8):
