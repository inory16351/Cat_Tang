+    # Closed pointed bud, not an open rosette. Base at .06, tip at .29.
+    lathe('Closed pink water lily bud',[(.065,.055),(.12,.1),(.21,.065),(.29,.005)],
+          'lily_pink',n=8,bevel=False)
+    for j in range(3):
