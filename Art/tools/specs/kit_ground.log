import bpy, bmesh, math, tempfile
from pathlib import Path
from mathutils import Vector
root = Path('C:/Project/Cat_Tang/Game/Assets/Art/Characters/Ch1')
names = ['Kit_GroundPlanks', 'Kit_Pebbles', 'Kit_DryGrass', 'Kit_SandDrift', 'Kit_Skull']
expected = [(2.2, 1.2, .254), (1.4, 1.3, .25), (1, 1, .45), (2.4, 1.6, .12), (.8, .78, .30)]
bpy.ops.object.select_all(action='SELECT')
bpy.ops.object.delete(use_global=False)
positions = [(-2.7, 1.1), (0, 1.1), (2.5, 1.1), (-1.5, -1.3), (1.6, -1.3)]
for index, name in enumerate(names):
    before = set(bpy.data.objects)
    bpy.ops.import_scene.fbx(filepath=str(root / (name + '.fbx')))
    imported = list(set(bpy.data.objects) - before)
    assert len(imported) == 1 and imported[0].type == 'MESH', name
    obj = imported[0]
    points = [obj.matrix_world @ v.co for v in obj.data.vertices]
    lo = Vector(tuple(min(v[a] for v in points) for a in range(3)))
    hi = Vector(tuple(max(v[a] for v in points) for a in range(3)))
    assert max(abs((hi-lo)[a] - expected[index][a]) for a in range(3)) < 1e-5, (name, hi-lo)
    assert abs(lo.z) < 1e-5 and abs(lo.x + hi.x) < 1e-5 and abs(lo.y + hi.y) < 1e-5
    obj.data.calc_loop_triangles()
    assert len(obj.data.loop_triangles) < 1500
    bm = bmesh.new()
    bm.from_mesh(obj.data)
    assert all(e.is_manifold for e in bm.edges), name
    remaining = set(bm.faces)
    volumes = []
    while remaining:
        component = {remaining.pop()}
        pending = list(component)
        while pending:
            face = pending.pop()
            for edge in face.edges:
                for adjacent in edge.link_faces:
                    if adjacent in remaining:
                        remaining.remove(adjacent)
                        component.add(adjacent)
                        pending.append(adjacent)
        volume = 0
        for face in component:
            origin = face.verts[0].co
            for j in range(1, len(face.verts)-1):
                volume += origin.dot(face.verts[j].co.cross(face.verts[j+1].co)) / 6
        assert volume > 0, (name, volume)
        volumes.append(volume)
    bm.free()
    print('VERIFIED', name, 'dimensions', tuple(round(v, 4) for v in hi-lo), 'closed outward components', len(volumes), flush=True)
    obj.location.x += positions[index][0]
    obj.location.y += positions[index][1]
    if name == 'Kit_Skull':
        obj.scale *= 1.8
mat = bpy.data.materials.new('Preview dirt')
