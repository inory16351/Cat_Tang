    cylinder('Wheel axle boss',(0,0,0),.18,.26,'rust',n=10)
    for i in range(8):
        a = .30+i*.61
        tube('Broken wheel spoke',[(.14*math.cos(a),.14*math.sin(a),0),
                                  (.70*math.cos(a),.70*math.sin(a),0)],
             .065,'wood_dark')
    for obj in PARTS[start:]:
        transform(obj,(-1.18,.88,-1.12),(math.pi/2,0,-.13))


