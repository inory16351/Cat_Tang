        obj = box('Broken boardwalk overhang',(x,.40,.075),(.36,length,.15),
                  'plank',rot=(0,0,(i-1.5)*.035))
        # Chipped end corners, no paper-thin decorative splinters.
        for v in obj.data.vertices:
