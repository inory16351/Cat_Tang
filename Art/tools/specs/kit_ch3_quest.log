+    cylinder('Soft left cuff',(.245,-.04,.82),.064,.055,'shadow_blur',n=8)
+    lump('Thin left hand',(.245,-.055,.735),(.075,.08,.15),'shadow')
+    print('SHOULDER_R ' + ' '.join(f'{v:.3f}' for v in SHOULDER_R),flush=True)
