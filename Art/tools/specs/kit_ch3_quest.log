+    verts = [(x,y+d,z) for d in (-depth/2,depth/2) for poly in (inner,outer) for x,z in poly]
+    faces = []
+    for i in range(n):
+        j = (i+1) % n
+        faces += [(i,j,n+j,n+i), (2*n+i,3*n+i,3*n+j,2*n+j),
+                  (n+i,n+j,3*n+j,3*n+i), (i,2*n+i,2*n+j,j)]
