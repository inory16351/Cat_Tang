                  (a,a+n,a+n+2,a+2),(a+1,a+3,a+n+3,a+n+1)]
    faces += [(0,1,n+1,n),(n-2,2*n-2,2*n-1,n-1)]
    Part('Wind blown knitted scarf ribbon',verts,faces,'scarf',False)
    for j,(x,y,z) in enumerate(points):
