+                  (.47,.065),(.74,.075),(.8,.09)],'wood_dark',n=8).transform((x,y,0))
+            cylinder('Brass leg ferrule',(x,y,.095),.084,.065,'brass',n=8)
+    box('Lower shelf',(0,0,.29),(1.37,.64,.09),'wood')
+    for x in (-.64,.64):
