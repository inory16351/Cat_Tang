+    rod('Treadle drive rod',(.38,y+.10,.22),(.38,y+.1,.95),.026,'iron')
+    # Antique machine: bed, column, overhanging neck, wheel and needle.
+    box('Sewing machine bed',(0,y,.955),(.80,.34,.075),'iron_dark')
