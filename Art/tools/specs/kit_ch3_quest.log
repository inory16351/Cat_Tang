+    beam('Poster silhouette arm',(ex+.03,-.074,1.31),(ex+.24,-.074,1.22),.065,.045,'shadow')
+    # Film projector, crate, reels with real negative-space spokes.
+    px,py=ex,-.59
+    box('Projector crate',(px,py,.22),(.58,.43,.44),'wood')
