+    box('Ivory clockmaker notebook',(.46,.09,1.02),(.25,.20,.04),'ivory',rot=(0,0,.18),bevel=False)
+    box('Notebook red bookmark',(.48,.01,1.045),(.04,.16,.04),'thread_red',bevel=False)
+
