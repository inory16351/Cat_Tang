+    for j in range(8):
+        a=j*TAU/8
+        box('Gear tooth',(radius*.84*math.sin(a),0,radius*.84*math.cos(a)),
+            (.055,.06,.06),role,rot=(0,a,0),bevel=False)
+    move_group(start,loc,rot=(0,0,0) if upright else (math.pi/2,0,0))
+
