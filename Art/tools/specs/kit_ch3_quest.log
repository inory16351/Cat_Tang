    bpy.ops.import_scene.fbx(filepath=str(root/'Game/Assets/Art/Characters/Ch3Quest'/('Kit_Q_'+name+'.fbx')),use_anim=False)
    objs=[o for o in bpy.context.scene.objects if o.type=='MESH']
    assert len(objs)==1,(name,len(objs))
    obj=objs[0]; me=obj.data
    me.calc_loop_triangles()
    assert len(me.loop_triangles)<=budget
    assert len(me.uv_layers)==1 and me.uv_layers[0].name=='UVMap'
    uv=me.uv_layers[0]
    glass=[]; backs=[]
    for p in me.polygons:
        role=me.materials[p.material_index].name.split('.')[0]
        if role=='mirror_glass': glass.append(p)
        else:
            assert all(uv.data[i].uv.length<1e-6 for i in p.loop_indices),(name,'non-glass UV')
        if role=='mirror_back': backs.append(p)
    for m in me.materials:
        bsdf=next(n for n in m.node_tree.nodes if n.type=='BSDF_PRINCIPLED')
        assert all(abs(v-.5)<1e-5 for v in bsdf.inputs['Base Color'].default_value[:3]),(name,m.name,'not grey')
    if glass:
        assert len(glass)<=64
        normal=(obj.matrix_world.to_3x3()@glass[0].normal).normalized()
        verts={v for p in glass for v in p.vertices}
        coords=[obj.matrix_world@me.vertices[v].co for v in verts]
        origin=coords[0]
        assert all(abs((v-origin).dot(normal))<1e-5 for v in coords)
        assert normal.z>.99 if name=='MirrorPuddle' else normal.y<-.8
        for p in glass:
            for li in p.loop_indices:
                a=obj.matrix_world@me.vertices[me.loops[li].vertex_index].co
                for lj in p.loop_indices:
                    b=obj.matrix_world@me.vertices[me.loops[lj].vertex_index].co
                    duv=uv.data[lj].uv-uv.data[li].uv
                    d=b-a
                    assert d.x*duv.x>=-1e-6,(name,'U backwards')
                    up=Vector((0,1,0)) if name=='MirrorPuddle' else Vector((0,normal.z,-normal.y))
                    assert d.dot(up)*duv.y>=-1e-6,(name,'V backwards')
        if name"'!='"'MirrorPuddle':
            width=max(v.x for v in coords)-min(v.x for v in coords)
            up=Vector((0,normal.z,-normal.y))
            height=max(v.dot(up) for v in coords)-min(v.dot(up) for v in coords)
            target=(1.6,2.2) if name=='StandMirror' else (2.6,3.6)
            assert abs(width-target[0])<1e-4 and abs(height-target[1])<1e-4,(name,width,height)
        front=[p for p in backs if (obj.matrix_world.to_3x3()@p.normal).normalized().dot(normal)>.999]
        assert front,(name,'missing backing')
        for p in front:
            for i in p.vertices:
                v=obj.matrix_world@me.vertices[i].co
                assert abs((v-origin).dot(normal)+.01)<1e-4,(name,'back gap',(v-origin).dot(normal))
        print('ROUNDTRIP',name,'glass_tris',len(glass),'UV / size / normal / .01 backing OK',flush=True)
    else:
        print('ROUNDTRIP',name,'zero UV / budget / grey materials OK',flush=True)
