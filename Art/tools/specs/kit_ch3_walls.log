+    low, high = bounds(obj)
+    assert abs(low.x+width/2) < 1e-5 and abs(high.x-width/2) < 1e-5, name
+    assert 1.2 <= high.y-low.y <= 2.25, (name, low, high)
+    if name == 'Cliff_Island':
+        assert abs(low.z+4) < 1e-5
