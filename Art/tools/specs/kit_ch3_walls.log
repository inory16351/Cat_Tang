+    'wood': (.35, .19, .22), 'roof_tile': (.65, .22, .31),
+    'window_lit': (1, .83, .43),
+}
+HARD = {'sandstone', 'sandstone_light', 'sandstone_dark', 'rock',
+        'rock_dark', 'marble', 'marble_dark', 'gold', 'gold_dark'}
+MATS = {}
+PARTS = []
