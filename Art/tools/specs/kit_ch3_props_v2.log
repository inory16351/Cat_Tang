    assert obj.name == name and obj.location.length < 1e-5, name
    vertices = [obj.matrix_world @ v.co for v in obj.data.vertices]
    low = Vector(tuple(min(v[i] for v in vertices) for i in range(3)))
    high = Vector(tuple(max(v[i] for v in vertices) for i in range(3)))
    floor = .6 if name == 'MirrorShard' else (.005 if name == 'Ripple' else 0)
    assert abs(low.z - floor) < 1e-4 and abs(high.z - dimensions[2]) < 1e-4, (name, low, high)
    assert all(abs(high[i] - low[i] - dimensions[i]) < 1e-4 for i in (0, 1)), name
    for mat in obj.data.materials:
        assert mat.name in ns['ROLES'], (name, mat.name)
        shader = next(n for n in mat.node_tree.nodes if n.type == 'BSDF_PRINCIPLED')
        assert all(abs(c - .5) < 1e-5 for c in shader.inputs['Base Color'].default_value[:3]), (name, mat.name)
    bm = bmesh.new()
    bm.from_mesh(obj.data)
    assert all(e.is_manifold for e in bm.edges), name
    bm.free()
    obj.data.calc_loop_triangles()
    tris = list(obj.data.loop_triangles)
    assert len(tris) <= (8000 if name == 'MerchantMirror' else 6000), name
    tree = BVHTree.FromPolygons(vertices, [t.vertices for t in tris], all_triangles=True)
    view = Vector((0, math.cos(math.radians(55)), math.sin(math.radians(55))))
    up = Vector((0, -view.z, view.y))
    low_up = min(v.dot(up) for v in vertices)
    high_up = max(v.dot(up) for v in vertices)
    counts = Counter()
    for ix in range(120):
        for iy in range(120):
            origin = Vector((low.x + (ix + .5) * (high.x - low.x) / 120, 0, 0)) + up * (low_up + (iy + .5) * (high_up - low_up) / 120) + view * 10
            hit, normal, index, distance = tree.ray_cast(origin, -view, 20)
            if index is not None:
                counts[obj.data.materials[tris[index].material_index].name] += 1
    total = sum(counts.values())
    dominant, pixels = counts.most_common(1)[0]
    print('VERIFIED', name, len(tris), 'tris', len(counts), 'visible roles', dominant, round(pixels / total * 100, 1), 'percent', flush=True)
    if name "'!= '"'Ripple':
        assert len(counts) >= 5 and pixels / total <= .56, (name, counts)
print('ALL TEN FBX FILES VERIFIED', flush=True)
