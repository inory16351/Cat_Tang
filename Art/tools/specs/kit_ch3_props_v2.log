import runpy, math
from collections import Counter
from mathutils import Vector
from mathutils.bvhtree import BVHTree
ns = runpy.run_path('Art/tools/blender_kit_ch3_props.py')
original_finish = ns['finish']
def audited_finish(name, dimensions):
    obj = original_finish(name, dimensions)
    obj.data.calc_loop_triangles()
    tris = list(obj.data.loop_triangles)
    tree = BVHTree.FromPolygons([v.co for v in obj.data.vertices], [t.vertices for t in tris], all_triangles=True)
    view = Vector((0, math.cos(math.radians(55)), math.sin(math.radians(55))))
    up = Vector((0, -view.z, view.y))
    low_x = min(v.co.x for v in obj.data.vertices)
    high_x = max(v.co.x for v in obj.data.vertices)
    low_up = min(v.co.dot(up) for v in obj.data.vertices)
    high_up = max(v.co.dot(up) for v in obj.data.vertices)
    counts = Counter()
    for ix in range(100):
        for iy in range(100):
            origin = Vector((low_x + (ix + .5) * (high_x - low_x) / 100, 0, 0)) + up * (low_up + (iy + .5) * (high_up - low_up) / 100) + view * 10
            hit, normal, index, distance = tree.ray_cast(origin, -view, 20)
            if index is not None:
                counts[obj.data.materials[tris[index].material_index].name] += 1
    total = sum(counts.values())
    print('VISIBLE', name, [(role, round(count / total * 100, 1)) for role, count in counts.most_common()], flush=True)
    return obj
ns['main'].__globals__['finish'] = audited_finish
ns['main']()
