+def arch_poly(radius, bottom, spring=2.15, steps=24):
+    return [(-radius,bottom),(radius,bottom)]+[
+        (radius*math.cos(j*math.pi/steps),spring+radius*math.sin(j*math.pi/steps))
+        for j in range(steps+1)]
