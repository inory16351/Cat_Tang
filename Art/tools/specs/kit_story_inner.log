+            if t is s:
+                continue
+            m = ((s[0]+t[0])/2,(s[1]+t[1])/2)
+            d = (-(t[1]-s[1]),t[0]-s[0])
+            cell = halfplane(cell,m,(m[0]+d[0],m[1]+d[1]),False)
+            if len(cell) < 3:
+                break
+        if len(cell) >= 3:
+            yield i,cell
