+                continue
+            a = (p[0]-dy/length*.025,p[1]+dx/length*.025)
+            b = (a[0]+dx,a[1]+dy)
+            surface('Fine quiet seam',halfplane(inset,a,b,True),'floor_seam')
+            inset = halfplane(inset,a,b,False)
