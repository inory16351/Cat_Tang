        ob.rotation_euler.y=-angle
    mount_copy('IVDrop',by['IVStand'],ANCHORS['IVStand']['drip_chamber'])
    bpy.context.view_layer.update()
    for name,loc,energy,size in (
        ('Soft key',(-6,-10,25),3800,15),
        ('Cool fill',(9,8,18),2200,12),
