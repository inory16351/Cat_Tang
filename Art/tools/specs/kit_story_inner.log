+        mod = obj.modifiers.new('Budget', 'DECIMATE')
+        mod.ratio, mod.delimit = (budget * .95) / triangles(obj), {'MATERIAL'}
+        bpy.ops.object.modifier_apply(modifier=mod.name)
+    assert triangles(obj) <= budget, (name, triangles(obj), budget)
+    if name not in KEEP:
+        lo, hi = bounds(obj)
+        mid = (hi + lo) / 2
