+def chunk_cells():
+    """The ward's half-plane Voronoi cells, enlarged to approximately five metres."""
+    seeds = [(-22+i*5+random.uniform(-.7,.7), -42+j*5+random.uniform(-.7,.7))
+             for i in range(10) for j in range(18)]
