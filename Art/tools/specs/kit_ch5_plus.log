+def materials():
+    for role in PALETTE:
+        mat = bpy.data.materials.new(role)
+        mat.use_nodes = True
+        mat.diffuse_color = (.5, .5, .5, 1)
+        node = mat.node_tree.nodes['Principled BSDF']
+        node.inputs['Base Color'].default_value = (.5, .5, .5, 1)
+        node.inputs['Metallic'].default_value = 0
