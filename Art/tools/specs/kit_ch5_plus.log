    tube('Top iron hanger hook',[(.30,-.40,1.20),(.30,-.40,1.25),(.39,-.40,1.24),
                                  (.40,-.40,1.13),(.33,-.40,1.10)],.023,'iron_dark')
    tube('Short free pendulum rod',[(.33,-.40,1.10),(.33,-.40,.85)],.025,'steel')
