    'violet': (.40, .19, .64), 'violet_dark': (.16, .055, .28),
    'indigo': (.085, .09, .29), 'night_sky': (.025, .025, .095),
    'starlight': (.92, .94, 1.0), 'crack_gold': (1.0, .76, .24),
    'gold': (.88, .53, .13), 'gold_dark': (.39, .23, .075),
    'mirror': (.57, .79, .91), 'mirror_back': (.17, .29, .45),
