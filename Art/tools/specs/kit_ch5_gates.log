+    beam('Crown clock hand',(0,.24,2.785),(.095,.24,2.86),.04,.04,'dial_mark')
+    crack([(-.14,.25,2.83),(-.05,.25,2.80),(-.01,.25,2.72),(.13,.25,2.71)],radius=.021)
+    for side in (-1,1):
