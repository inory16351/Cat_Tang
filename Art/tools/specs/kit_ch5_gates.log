+                  -.065,.065,'mirror',False,'mirror_back')
+            crack([(-.57,.095,.36),(-.35,.095,.69),(-.46,.095,1.07)])
+            transform_since(start,Matrix.Translation(Vector((x,y,.16))) @
+                            Matrix.Rotation(side*math.pi/2,4,'Z') @
+                            Matrix.Rotation((-.09 if j%2 else .09),4,'Y'))
