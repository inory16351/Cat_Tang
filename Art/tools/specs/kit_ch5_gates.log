+        box('Saloon gilded rail band',(0,.12,1.46),(2.05,.04,.055),'gold',False)
+        transform_since(start,Matrix.Translation(Vector((x,-3.9,.10))) @
+                        Matrix.Rotation(side*math.pi/2,4,'Z') @ Matrix.Rotation(.055,4,'Y'))
+        for yy in (-1.90,-.70):
