+def jewel(center, width, height, role='crystal'):
+    x, y, z = center
+    verts = [(x, y, z-height/2), (x-width/2,y,z), (x,y-width*.32,z),
+             (x+width/2,y,z), (x,y+width*.32,z), (x,y,z+height/2)]
