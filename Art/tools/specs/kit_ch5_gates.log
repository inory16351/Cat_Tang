+def star(x, y, z, radius=.16, role='starlight', horizontal=False):
+    profile = []
+    for j in range(8):
+        t = j * math.tau / 8
+        r = radius if j % 2 == 0 else radius * .30
+        profile.append((r * math.cos(t), r * math.sin(t)))
