+def floor_crack(y, x=0, length=4.4):
+    crack([(x-length/2,y-.08,.06),(x-length*.21,y+.11,.06),
+           (x-.10,y-.07,.06),(x+length*.20,y+.09,.06),
+           (x+length/2,y-.06,.06)])
