+def merchant_mask():
+    # Two thick annuli produce real almond-shaped eye openings on both sides.
+    for sign in (-1, 1):
+        n, verts = 24, []
+        for y, outer in ((.045, True), (.045, False), (.09, False), (.09, True)):
+            for i in range(n):
