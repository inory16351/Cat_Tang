+def curtain():
+    box((0, -.02, .25), (8, 1.56, .50), 'marble', bevel=.04)
+    box((0, .765, .27), (8, .05, .36), 'marble_dark')
+    for i in range(25):
+        x = -3.84 + i * .32
+        box((x, .796, .27), (.27, .025, .25), 'glaze_teal', bevel=.014)
