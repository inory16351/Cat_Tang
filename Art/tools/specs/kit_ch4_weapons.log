+    'iron': (.12, .13, .15), 'iron_dark': (.025, .028, .035),
+    'silver': (.86, .88, .90), 'brass': (.61, .62, .63),
+    'copper': (.33, .34, .36), 'wood': (.29, .30, .32),
+    'wood_dark': (.055, .06, .07), 'dial_face': (.94, .94, .92),
+    'dial_mark': (.018, .021, .027), 'red_lacquer': (.72, .018, .035),
