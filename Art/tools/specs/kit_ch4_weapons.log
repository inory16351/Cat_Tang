+    solid('Carved musket butt',stock,.13,'wood_dark',back='wood_dark')
+    box('Butt plate',(-.015,0,-.376),(.23,.16,.048),'brass')
+    solid('Stock cheek inlay',[(-.067,-.17),(.023,-.17),(.060,-.30),(-.08,-.30)],
