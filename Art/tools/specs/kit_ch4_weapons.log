+          'steel',16,loc=(.025,-.046,0),bands={1:'silver',2:'iron_dark'})
+    for z in (.24,.50,.87): cylinder('Brass barrel band',(.025,-.046,z),.067,.05,'brass')
+    box('Barrel breech block',(.025,-.035,.16),(.15,.13,.14),'iron')
