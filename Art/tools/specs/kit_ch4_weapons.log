+    # Broad forged sickle: follows a .9 m sweep toward +X, edge on +Y.
+    outer=[(.20,1.63),(.43,1.70),(.67,1.66),(.88,1.54),(1.04,1.34),
+           (1.13,1.09),(1.10,.83),(.98,1.11),(.82,1.29),(.62,1.40),(.40,1.44),(.22,1.44)]
