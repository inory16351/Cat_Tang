    'wood': (.37, .23, .42), 'wood_dark': (.105, .06, .16),
    'iron': (.29, .27, .37), 'iron_dark': (.07, .075, .12),
    'steel': (.42, .52, .68), 'brass': (.68, .43, .16),
    'dial_face': (.86, .81, .96), 'dial_mark': (.055, .035, .10),
