+    'iron': (.18, .19, .165), 'rust': (.59, .22, .09),
+    'canvas': (.87, .78, .56), 'cloth_red': (.68, .16, .10),
+    'cloth_cream': (.98, .88, .67), 'paint_rose': (.74, .36, .29),
