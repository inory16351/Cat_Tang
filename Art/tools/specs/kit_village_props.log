+    tube('Coiled hitch rope',pts,.027,'canvas',n=5,bevel=False)
+    tube('Rope loose end',[(.72,.16,.66),(.83,.17,.47),(.76,.19,.27)],.027,'canvas',n=5,bevel=False)
