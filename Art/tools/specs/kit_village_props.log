+        mote((.80+.17*math.sin(t*6),1.62-.20*t,6.24+2.2*t),
+             max(.025,.06*(1-t*.65)),'sand_glow')
+    vanish((0,0,7.55),1.85,1.37,('wood_light','wood','iron'),.34,spiral=True)
