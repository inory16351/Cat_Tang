+        for p in PARTS[start:]:
+            p.transform((.06 if j == 3 else 0,0,.06 if j == 3 else 0),rot=(0,0,angle))
+    vanish((.12,0,3.10),.59,.25,('wood','paint_sage','iron'),.10)
