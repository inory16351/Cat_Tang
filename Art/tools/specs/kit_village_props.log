+        box('Weathered rail face',(0,.124,z+.025),(4,.055,.065),'wood_light',bevel=False)
+    # Split endgrain chips stay inside the 4m module footprint.
+    vanish((1.74,0,1.43),.19,.52,('wood_weathered','wood_light','wood_dark'),.095)
