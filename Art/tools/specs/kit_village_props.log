import bpy, runpy
from pathlib import Path
from mathutils import Vector
root = Path.cwd()
kit = runpy.run_path(str(root / 'Art/tools/blender_kit_village_props.py'))
count = 0
for name, dims, build in kit['SPECS']:
    bpy.ops.wm.read_factory_settings(use_empty=True)
    path = root / 'Game/Assets/Art/Characters/Village' / ('Kit_V_' + name + '.fbx')
    bpy.ops.import_scene.fbx(filepath=str(path))
    objects = list(bpy.context.scene.objects)
    assert len(objects) == 1 and objects[0].type == 'MESH', (name, objects)
    obj = objects[0]
    assert obj.name == name, (name, obj.name)
    points = [obj.matrix_world @ v.co for v in obj.data.vertices]
    lo = Vector(tuple(min(p[i] for p in points) for i in range(3)))
    hi = Vector(tuple(max(p[i] for p in points) for i in range(3)))
    assert all(abs((hi-lo)[i]-dims[i]) < .0002 for i in range(3)), (name, hi-lo)
    assert abs(lo.z) < .0002 and abs(lo.x+hi.x) < .0002 and abs(lo.y+hi.y) < .0002, (name, lo, hi)
    assert obj.location.length < .0002, (name, obj.location)
    used = {obj.data.materials[p.material_index].name for p in obj.data.polygons}
    assert len(used) >= 5 and used <= set(kit['ROLES']), (name, used)
    for mat in obj.data.materials:
        shader = next(n for n in mat.node_tree.nodes if n.type == 'BSDF_PRINCIPLED')
        assert all(abs(c-.5) < .0001 for c in shader.inputs['Base Color'].default_value[:3]), (name, mat.name)
        assert not any(n.type == 'TEX_IMAGE' for n in mat.node_tree.nodes), (name, mat.name)
    obj.data.calc_loop_triangles()
    assert len(obj.data.loop_triangles) <= (12000 if name in ('Centerpiece','Windpump','WaterTower') else 6000), name
    count += 1
    print('ROUNDTRIP_OK', name, flush=True)
assert count == 15
print('ROUNDTRIP_DONE', count, flush=True)
