from pathlib import Path
import bpy, bmesh
from mathutils import Vector
bpy.ops.wm.read_factory_settings(use_empty=True)
bpy.ops.import_scene.fbx(filepath=str(Path('Game/Assets/Art/Characters/Ch2/Kit_Arena.fbx').resolve()))
objects=list(bpy.context.scene.objects)
assert len(objects)==1 and objects[0].name=='Arena' and objects[0].type=='MESH'
obj=objects[0]
obj.data.calc_loop_triangles()
count=len(obj.data.loop_triangles)
assert count<=9000 and all(len(p.vertices)==3 for p in obj.data.polygons)
coords=[obj.matrix_world @ v.co for v in obj.data.vertices]
low=Vector([min(v[i] for v in coords) for i in range(3)])
high=Vector([max(v[i] for v in coords) for i in range(3)])
assert all(abs((high-low)[i]-(32,32,.3)[i])<.001 for i in range(3)),(low,high)
assert abs(high.z)<1e-5 and abs(low.z+.3)<1e-5
assert obj.location.length<1e-5
roles=set('stone stone_dark wood wood_dark iron iron_dark rail_steel brass'.split())
assert {m.name for m in obj.data.materials}==roles
for mat in obj.data.materials:
    colour=mat.node_tree.nodes['Principled BSDF'].inputs['Base Color'].default_value
    assert all(abs(a-b)<1e-6 for a,b in zip(colour,(.5,.5,.5,1))), (mat.name,tuple(colour))
bm=bmesh.new();bm.from_mesh(obj.data)
assert all(e.is_manifold for e in bm.edges)
assert all(v.is_manifold for v in bm.verts)
assert all(f.calc_area()>1e-10 for f in bm.faces)
bm.free()
print('FBX_VERIFIED',obj.name,count,tuple(round(d,4) for d in high-low),sorted(roles),'top_z',round(high.z,5),'bottom_z',round(low.z,5))
