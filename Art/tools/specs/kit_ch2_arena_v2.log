-
-def setup_materials():
-    for name in sorted(ROLES):
-        mat = bpy.data.materials.new(name)
-        mat.use_nodes = True
-        mat.diffuse_color = (.5, .5, .5, 1)
-        shader = mat.node_tree.nodes['Principled BSDF']
-        shader.inputs['Base Color'].default_value = (.5, .5, .5, 1)
-        shader.inputs['Roughness'].default_value = .85
-        shader.inputs['Metallic'].default_value = 0
-        MATERIALS[name] = mat
-
-
-def mesh(label, verts, faces, role, bevel=False):
-    global SERIAL
-    assert role in ROLES
-    SERIAL += 1
-    data = bpy.data.meshes.new(f'{label}_{SERIAL}')
-    data.from_pydata(verts, [], faces)
-    data.update()
-    obj = bpy.data.objects.new(data.name, data)
-    bpy.context.collection.objects.link(obj)
-    data.materials.append(MATERIALS[role])
-    if bevel:
-        # Same 25 mm, two-segment upper-perimeter bevel as the landmark kit.
-        # Reserve it for the exposed plates and hub; repeated thin inlays and
-        # wedge seams retain their hand-authored topology to meet the budget.
-        mod = obj.modifiers.new('Chunky softened edges 25mm', 'BEVEL')
