def water_crane():
    cx, cy = -.30, -.27
    for sx in [-1, 1]:
        for sy in [-1, 1]:
            bottom = (cx + sx * 1.03, cy + sy * 1.04, .09)
            top = (cx + sx * .75, cy + sy * .75, 4.28)
            box('Tower iron foot', (bottom[0], bottom[1], .09), (.34, .34, .18), 'iron')
            beam('Tower splayed iron leg', bottom, top, .19, 'iron')
    for sy in [-1, 1]:
