   "Scripts/Game/StoryInner.cs:384"
  ]
 },
 {
  "id": 551,
  "ko": "거울로",
  "en": "To the mirror",
  "src": [
   "Scripts/Game/StoryInner.cs:419"
  ]
 },
 {
  "id": 552,
  "ko": "...무서워.",
  "en": "...I'm scared.",
  "src": [
   "Scripts/Game/StoryInner.cs:427"
  ]
 },
 {
  "id": 553,
  "ko": "응.",
  "en": "I know.",
  "src": [
   "Scripts/Game/StoryInner.cs:427"
  ]
 },
 {
  "id": 554,
  "ko": "끝나면... 아무것도 안 남을까 봐.",
  "en": "That when it ends... nothin'll be left.",
  "src": [
   "Scripts/Game/StoryInner.cs:428"
  ]
 },
 {
  "id": 555,
  "ko": "남아. 추억은 사라지지 않아.",
  "en": "Something stays. Memories don't disappear.",
  "src": [
   "Scripts/Game/StoryInner.cs:428"
  ]
 },
 {
  "id": 556,
  "ko": "...그동안 계속 노력했어. 멈추게 하려고.",
  "en": "...I kept tryin' all this time. To make it stop.",
  "src": [
   "Scripts/Game/StoryInner.cs:429"
  ]
 },
 {
  "id": 557,
  "ko": "알아. 그게 너였으니까.",
  "en": "I know. That's who you were.",
  "src": [
   "Scripts/Game/StoryInner.cs:429"
  ]
 },
 {
  "id": 558,
  "ko": "...인사는 하고 가야겠지.",
  "en": "...Guess I oughta say goodbye first.",
  "src": [
   "Scripts/Game/StoryInner.cs:430"
  ]
 },
 {
  "id": 559,
  "ko": "다들 기다리고 있어.",
  "en": "They're all waiting.",
  "src": [
   "Scripts/Game/StoryInner.cs:430"
  ]
 },
 {
  "id": 560,
