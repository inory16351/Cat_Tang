   "Scripts/Game/StoryWard.cs:175"
  ]
 },
 {
  "id": 536,
  "ko": "거기까지 가게 두지 않아.",
  "en": "I won't let it get that far.",
  "src": [
   "Scripts/Game/StoryInner.cs:28",
   "Scripts/Game/StoryWard.cs:471"
  ]
 },
 {
  "id": 537,
  "ko": "난 아직 쏠 수 있어.",
  "en": "I can still shoot.",
  "src": [
   "Scripts/Game/StoryInner.cs:28"
  ]
 },
 {
  "id": 538,
  "ko": "...저 바늘, 내가 처음 고친 거였지.",
  "en": "...That hand. First one I ever fixed.",
  "src": [
   "Scripts/Game/StoryInner.cs:32"
  ]
 },
 {
  "id": 539,
  "ko": "...배웅은, 늘 내 몫이었어.",
  "en": "...Seein' folks off was always my job.",
  "src": [
   "Scripts/Game/StoryInner.cs:33"
  ]
 },
 {
  "id": 540,
  "ko": "...멈춘 시계도, 다 고쳐 줬는데.",
  "en": "...Fixed every stopped clock, too.",
  "src": [
   "Scripts/Game/StoryInner.cs:34"
  ]
 },
 {
  "id": 541,
  "ko": "...오래 기다리게 했네.",
  "en": "...Kept you waitin' a long time.",
  "src": [
   "Scripts/Game/StoryInner.cs:35"
  ]
 },
 {
  "id": 542,
  "ko": "앞으로",
  "en": "Forward",
  "src": [
   "Scripts/Game/StoryInner.cs:128",
   "Scripts/Game/StoryInner.cs:249"
  ]
 },
 {
  "id": 543,
  "ko": "또 되감았네.",
  "en": "Rewound again.",
  "src": [
   "Scripts/Game/StoryInner.cs:169"
  ]
 },
 {
  "id": 544,
  "ko": "...끝나지 않으면, 지지도 않아.",
  "en": "...If it never ends, I never lose.",
  "src": [
   "Scripts/Game/StoryInner.cs:169"
  ]
 },
 {
  "id": 545,
  "ko": "이기지도 못하고.",
  "en": "And you never win, either.",
  "src": [
   "Scripts/Game/StoryInner.cs:169"
  ]
 },
 {
  "id": 546,
  "ko": "쏘면 처음으로 되감겨요 — 쏘지 말고 걸어가세요",
  "en": "Shooting rewinds you to the start — don't shoot, just walk",
  "src": [
   "Scripts/Game/StoryInner.cs:171"
  ]
 },
 {
  "id": 547,
  "ko": "되감겼어요 — 쏘지 말고 걸어가세요",
  "en": "Rewound — don't shoot, just walk",
  "src": [
   "Scripts/Game/StoryInner.cs:173"
  ]
 },
 {
  "id": 548,
  "ko": "쏘지 말고 피하며 버티세요 — 쏠수록 그림자가 커져요",
