{"id": 700, "ar": "ساعة حائط على 11:59"},
{"id": 701, "ar": "آه...... حلم......."},
{"id": 702, "ar": "رأسي يخفق......."},
{"id": 703, "ar": "......لا وقت للقلق بشأن المكان الذي نمت فيه."},
{"id": 704, "ar": "الأهم أولا. لأتعامل مع ما أمامي."},
{"id": 705, "ar": "اضغط <color=#FFD54A>Tab</color> لفتح الحقيبة."},
{"id": 706, "ar": "طلقة التراجع"},
{"id": 707, "ar": "انقر بالزر الأيمن لتتراجع وتطلق طلقتين."},
{"id": 708, "ar": "لا يمكن إصابتك أثناء التراجع."},
{"id": 709, "ar": "بعد الاستخدام، تجهز مجددا خلال 6 ثوان."},
{"id": 710, "ar": "جرب طلقة التراجع باستخدام <color=#FFD54A>النقر الأيمن</color>."},
{"id": 711, "ar": "ساعة الطلقات"},
{"id": 712, "ar": "كل خانة في الأسطوانة تمثل ساعة على الساعة."},
{"id": 713, "ar": "كلما أطلقت، يمضي الزمن،"},
{"id": 714, "ar": "ومع مضي الزمن، قد تحصل"},
{"id": 715, "ar": "على تأثيرات خاصة!"},
{"id": 716, "ar": "ساعة الطلقات · 1/4"},
{"id": 717, "ar": "في ساعة الطلقات 12 خانة، وكل خانة هي ساعة."},
{"id": 718, "ar": "تطلق الطلقات بالترتيب، من الخانة 1 إلى الخانة 12."},
{"id": 719, "ar": "ساعة الحكم · 2/4"},
{"id": 720, "ar": "ساعة الخانة التي توضع فيها الطلقة هي 'ساعة حكمها'."},
{"id": 721, "ar": "حين تستوفي ساعة الحكم شرط ساعة الطلقة، تتفعل الطلقة."},
{"id": 722, "ar": "'{0}' الآن في الخانة {1} → ساعة الحكم {2} · الشرط '{3}' → {4}"},
{"id": 723, "ar": "'{0}' الآن في المستودع → ضعها في خانة من ساعة الطلقات لتحصل على ساعة حكم. (الشرط '{1}')"},
{"id": 724, "ar": "جربها بنفسك · 3/4"},
{"id": 725, "ar": "اسحب '{0}' إلى خانة تستوفي شرطها."},
{"id": 726, "ar": "تم التفعيل! الطلقات في الخانات الذهبية تفعل سماتها وتأثيراتها الفريدة."},
{"id": 727, "ar": "أين تتحقق · 4/4"},
{"id": 728, "ar": "مرر الفأرة فوق طلقة لترى شرط ساعتها وساعة حكمها الحالية."},
{"id": 729, "ar": "لم يستوف بعد"},
{"id": 730, "ar": "حين تتفعل '{0}'، تحصل طلقات الخانتين المجاورتين على ساعة الحكم +{1}. تضاف بعد تطبيق كل العمليات."},
{"id": 731, "ar": "همم. الآن......."},
{"id": 732, "ar": "حان وقت تلقينهم درسا!"},
{"id": 733, "ar": "اضغط <color=#FFD54A>Q</color>."},
{"id": 734, "ar": "ها، لم أفقد مهارتي بعد!"},
{"id": 735, "ar": "تآزر"},
{"id": 736, "ar": "باب <color=#FFD54A>العمليات</color>: احصل على عمليات تغير ساعة حكم الطلقة."},
{"id": 737, "ar": "العمليات · 1/6"},
{"id": 738, "ar": "العمليات حسابات تركبها في الطلقة لتغيير ساعة حكمها."},
{"id": 739, "ar": "يمكنك استيفاء الشرط دون نقل الطلقة إلى خانة أخرى."},
{"id": 740, "ar": "أين تركب · 2/6"},
{"id": 741, "ar": "انقر على طلقة لفتح نافذة 'تطوير الطلقة'."},
{"id": 742, "ar": "اسحب عملية من المستودع إلى هذه الخانة."},
{"id": 743, "ar": "<size=22>'الطلقة العادية' الأساسية ليس لها خانة عملية.</size>"},
{"id": 744, "ar": "الترتيب · 3/6"},
{"id": 745, "ar": "تبدأ ساعة الحكم من ساعة الخانة، ثم تطبق العمليات من الأعلى إلى الأسفل."},
{"id": 746, "ar": "مثال: الخانة 3 → ×2 → 6 → +1 → الساعة 7"},
{"id": 747, "ar": "غير الترتيب فتصبح 3 → +1 → 4 → ×2 → الساعة 8."},
{"id": 748, "ar": "القواعد · 4/6"},
{"id": 749, "ar": "القسمة غير الصحيحة تقرب. مثال: الخانة 5 ÷2 → 2.5 → الساعة 3"}
]
